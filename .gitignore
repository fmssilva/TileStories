# ===================================================================
# TileStories root .gitignore
# ===================================================================
# The Unity project (TileStories/) has its own .gitignore inside it.
# This root .gitignore covers only workspace-level artifacts.
# ===================================================================

# Build artifacts (APK/AAB builds produced by Unity)
/build/

# Binary / generated / large non-source files at root level
*.pptx
*.pdf
*.apk
*.aab
*.log
*.tmp
_logs.txt

# OS files
Thumbs.db
.DS_Store

# IDE/editor workspace files
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Node / npm (if any scripts at root)
node_modules/
# voicebench: API keys and private A/B audio never leave this machine
proj_guides/_3.3.1_Prototype/voicebench/.env
proj_guides/_3.3.1_Prototype/voicebench/out-private/
# Every API key lives in .secrets/keys.env (never committed); only the template is
/.secrets/*
!/.secrets/keys.env.example
# The local Lab's keys, written from .secrets by keys_local.py (never published)
keys.local.js

# Blender backup copies
*.blend1
