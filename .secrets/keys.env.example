# TileStories: every API key in one file. This folder is never committed (see .gitignore); keys.env.example is.
# What each key is for, where to create it and how to replace it: proj_guides/__Services_And_Keys.md
# Readers: voicebench/render.py (voices), lab_src/keys_local.py (the local Lab's live agent), the Unity Editor (EditorPrefs import).

# Google AI Studio (aistudio.google.com > Get API key). Gemini: the agent's model, embeddings, TTS. Free tier = development only.
GEMINI_API_KEY=

# Anthropic Console (console.anthropic.com > API Keys). Claude: the recommended agent model (Haiku 5.5).
ANTHROPIC_API_KEY=

# Azure for Students > Speech resource (F0, West Europe) > Keys and Endpoint: KEY 1 and Location.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# ElevenLabs > Profile > API Keys (rendering with word times). Voice ids from the Voice Library (Portuguese, Portugal).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_PT=
ELEVENLABS_VOICE_EN=

# 3D generation for the mascot (optional): Meshy (meshy.ai > API) or Tripo (platform.tripo3d.ai > API Keys).
MESHY_API_KEY=
TRIPO_API_KEY=
