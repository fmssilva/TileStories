# Copy this file to .env (same folder) and fill in what you have. .env is never committed (see .gitignore).
# Azure for Students -> create a "Speech" resource (tier F0, region e.g. westeurope) -> Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Google AI Studio -> Get API key
GEMINI_API_KEY=
# ElevenLabs -> Profile -> API Keys
ELEVENLABS_API_KEY=
