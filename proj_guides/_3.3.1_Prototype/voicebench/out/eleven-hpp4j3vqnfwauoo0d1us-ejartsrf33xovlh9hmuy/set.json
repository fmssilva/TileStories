{"id": "eleven-hpp4j3vqnfwauoo0d1us-ejartsrf33xovlh9hmuy", "provider": "eleven", "voices": {"en": "hpp4J3VqNfWAUOO0d1Us", "pt": "ejarTsrf33xoVlH9hMuy"}, "files": {"97798edb": {"src": "97798edb.mp3", "text": "Hi! I'm Azu. Kings and queens lived right here, by the river, for a very long time. Want to see their palace?", "lang": "en", "words": [[0.0, 0.511], [0.662, 0.824], [0.882, 1.393], [1.567, 1.846], [1.869, 1.939], [1.997, 2.276], [2.322, 2.508], [2.554, 2.717], [2.763, 2.949], [2.972, 3.065], [3.111, 3.181], [3.216, 3.448], [3.471, 3.576], [3.622, 3.646], [3.704, 3.913], [3.971, 4.168], [4.226, 4.725], [4.969, 5.132], [5.155, 5.201], [5.236, 5.352], [5.375, 5.503], [5.538, 6.269]]}, "35125365": {"src": "35125365.mp3", "text": "It was the royal home for about two hundred and fifty years, until it was lost on the first of November, 1755.", "lang": "en", "words": [[0.0, 0.128], [0.163, 0.255], [0.302, 0.372], [0.43, 0.72], [0.789, 1.033], [1.08, 1.184], [1.242, 1.474], [1.509, 1.695], [1.753, 2.02], [2.043, 2.113], [2.183, 2.508], [2.577, 3.111], [3.39, 3.611], [3.657, 3.715], [3.738, 3.831], [3.901, 4.191], [4.238, 4.307], [4.342, 4.412], [4.47, 4.748], [4.795, 4.841], [4.911, 5.561], [5.712, 7.384]]}, "d0d47e4b": {"src": "d0d47e4b.mp3", "text": "Here is something surprising. Tap the card to flip it.", "lang": "en", "words": [[0.0, 0.221], [0.255, 0.313], [0.348, 0.627], [0.673, 1.451], [1.695, 1.985], [2.055, 2.125], [2.171, 2.485], [2.531, 2.589], [2.647, 2.891], [2.949, 3.437]]}, "23d77f43": {"src": "23d77f43.mp3", "text": "Now the story. This drawing shows the square in 1662: the long palace along the back, its great corner tower on the left, and a fountain built for a night of fireworks.", "lang": "en", "words": [[0.0, 0.395], [0.511, 0.604], [0.65, 1.312], [1.753, 1.95], [1.997, 2.31], [2.368, 2.624], [2.682, 2.752], [2.798, 3.17], [3.216, 3.309], [3.379, 4.992], [5.271, 5.364], [5.422, 5.654], [5.724, 6.13], [6.153, 6.397], [6.432, 6.502], [6.536, 6.931], [6.954, 7.094], [7.14, 7.372], [7.454, 7.767], [7.825, 8.139], [8.208, 8.278], [8.313, 8.382], [8.44, 8.893], [8.986, 9.137], [9.195, 9.218], [9.3, 9.706], [9.764, 9.973], [10.019, 10.124], [10.17, 10.205], [10.275, 10.461], [10.495, 10.542], [10.6, 11.656]]}, "c653042f": {"src": "c653042f.mp3", "text": "King Manuel thought his castle on the hill was too small. So around 1500 he built a new palace right by the river, and filled it with the riches the ships brought back from India!", "lang": "en", "words": [[0.0, 0.244], [0.29, 0.766], [0.824, 1.045], [1.08, 1.184], [1.242, 1.683], [1.73, 1.8], [1.834, 1.904], [1.95, 2.148], [2.206, 2.334], [2.403, 2.566], [2.635, 3.251], [3.576, 3.715], [3.773, 4.063], [4.133, 5.016], [5.085, 5.143], [5.201, 5.41], [5.457, 5.48], [5.573, 5.747], [5.817, 6.281], [6.339, 6.571], [6.606, 6.699], [6.757, 6.827], [6.873, 7.349], [7.523, 7.674], [7.755, 8.046], [8.069, 8.127], [8.162, 8.278], [8.313, 8.382], [8.475, 8.87], [8.94, 9.009], [9.067, 9.369], [9.416, 9.659], [9.706, 9.892], [9.938, 10.066], [10.147, 10.96]]}, "65d465c0": {"src": "65d465c0.mp3", "text": "Inside: a library of some seventy thousand books, the royal archive, a chapel, and next door a brand new opera house.", "lang": "en", "words": [[0.0, 0.778], [1.103, 1.149], [1.242, 1.741], [1.8, 1.858], [1.904, 2.101], [2.159, 2.531], [2.589, 2.949], [2.995, 3.46], [3.704, 3.796], [3.855, 4.145], [4.214, 4.772], [4.795, 4.83], [4.888, 5.399], [5.422, 5.515], [5.584, 5.805], [5.84, 6.049], [6.107, 6.142], [6.2, 6.571], [6.687, 6.85], [6.931, 7.233], [7.279, 7.988]]}, "a50ac86e": {"src": "a50ac86e.mp3", "text": "Drag across the picture: the palace before 1755, and the square that took its place.", "lang": "en", "words": [[0.0, 0.337], [0.395, 0.685], [0.731, 0.801], [0.836, 1.324], [1.533, 1.625], [1.683, 2.101], [2.136, 2.415], [2.45, 3.692], [3.715, 3.796], [3.831, 3.901], [3.936, 4.249], [4.296, 4.4], [4.435, 4.574], [4.621, 4.725], [4.772, 5.526]]}, "0efaaff8": {"src": "0efaaff8.mp3", "text": "That's it: the palace before 1755, and the open square that took its place.", "lang": "en", "words": [[0.0, 0.302], [0.36, 0.65], [0.975, 1.057], [1.115, 1.509], [1.544, 1.8], [1.846, 3.077], [3.1, 3.17], [3.204, 3.274], [3.332, 3.576], [3.657, 3.982], [4.029, 4.133], [4.168, 4.307], [4.342, 4.447], [4.505, 5.201]]}, "3f066bd1": {"src": "3f066bd1.mp3", "text": "On the morning of 1 November 1755, All Saints' Day, an earthquake, a fire and a tsunami destroyed the palace, its library and the opera house in a few hours.", "lang": "en", "words": [[0.0, 0.139], [0.174, 0.244], [0.29, 0.58], [0.627, 0.673], [0.743, 0.987], [1.057, 1.463], [1.544, 2.856], [2.879, 3.053], [3.135, 3.495], [3.529, 3.994], [4.168, 4.296], [4.354, 5.027], [5.201, 5.271], [5.387, 5.747], [5.793, 5.886], [5.933, 5.979], [6.002, 6.513], [6.583, 7.082], [7.117, 7.187], [7.233, 7.732], [7.755, 7.906], [7.976, 8.522], [8.58, 8.661], [8.707, 8.777], [8.847, 9.16], [9.207, 9.474], [9.52, 9.578], [9.613, 9.648], [9.706, 9.868], [9.915, 10.728]]}, "ebbc0fe8": {"src": "ebbc0fe8.mp3", "text": "What was lost with it: the library of some seventy thousand books and the royal archive, burnt in the fire that followed the earthquake.", "lang": "en", "words": [[0.0, 0.197], [0.244, 0.337], [0.418, 0.708], [0.766, 0.929], [0.987, 1.289], [1.614, 1.718], [1.788, 2.322], [2.38, 2.438], [2.496, 2.682], [2.752, 3.158], [3.204, 3.587], [3.646, 3.994], [4.04, 4.156], [4.203, 4.272], [4.331, 4.632], [4.702, 5.259], [5.306, 5.608], [5.654, 5.712], [5.759, 5.828], [5.886, 6.235], [6.281, 6.397], [6.467, 6.827], [6.85, 6.92], [6.978, 7.895]]}, "46c1d0eb": {"src": "46c1d0eb.mp3", "text": "Back on the card, the gallery shows the square through three centuries.", "lang": "en", "words": [[0.0, 0.255], [0.302, 0.372], [0.406, 0.476], [0.511, 1.01], [1.184, 1.289], [1.335, 1.718], [1.788, 2.032], [2.09, 2.159], [2.218, 2.543], [2.589, 2.81], [2.856, 3.111], [3.17, 4.133]]}, "f3e4b6ce": {"src": "f3e4b6ce.mp3", "text": "Ready for a question? Which king moved the court to the river? Tap your answer.", "lang": "en", "words": [[0.0, 0.255], [0.302, 0.406], [0.453, 0.476], [0.534, 1.161], [1.44, 1.683], [1.741, 1.927], [1.997, 2.218], [2.252, 2.322], [2.368, 2.601], [2.635, 2.682], [2.728, 2.798], [2.844, 3.297], [3.738, 4.052], [4.11, 4.226], [4.284, 4.969]]}, "c2575378": {"src": "c2575378.mp3", "text": "It was Manuel the First, around 1500.", "lang": "en", "words": [[0.0, 0.139], [0.163, 0.255], [0.313, 0.639], [0.685, 0.755], [0.813, 1.358], [1.509, 1.788], [1.846, 2.833]]}, "20b26c5c": {"src": "20b26c5c.mp3", "text": "That was the Ribeira Palace. Ask me anything, or explore on your own.", "lang": "en", "words": [[0.0, 0.197], [0.232, 0.325], [0.372, 0.441], [0.499, 0.848], [0.906, 1.486], [1.811, 2.078], [2.136, 2.229], [2.276, 2.694], [2.717, 2.833], [2.902, 3.413], [3.448, 3.518], [3.564, 3.68], [3.75, 4.319]]}, "8a35c9a6": {"src": "8a35c9a6.mp3", "text": "Welcome to the Ribeira Palace. For two and a half centuries the kings of Portugal lived here, right on the river. Let me show you what was here.", "lang": "en", "words": [[0.0, 0.395], [0.43, 0.476], [0.522, 0.592], [0.65, 1.01], [1.068, 1.683], [2.009, 2.148], [2.194, 2.357], [2.426, 2.496], [2.543, 2.566], [2.624, 2.786], [2.844, 3.367], [3.425, 3.506], [3.564, 3.878], [3.924, 3.982], [4.052, 4.528], [4.598, 4.841], [4.888, 5.259], [5.468, 5.689], [5.724, 5.793], [5.828, 5.898], [5.944, 6.432], [6.711, 6.838], [6.873, 6.943], [6.978, 7.129], [7.187, 7.256], [7.303, 7.407], [7.442, 7.535], [7.593, 8.173]]}, "163cb05a": {"src": "163cb05a.mp3", "text": "When King Manuel I found the old castle on the hill too cramped, he moved the court down to the docks around 1500 and filled the new palace with the wealth of the voyages to India.", "lang": "en", "words": [[0.0, 0.209], [0.267, 0.441], [0.499, 0.906], [0.998, 1.033], [1.149, 1.358], [1.393, 1.474], [1.533, 1.718], [1.776, 2.194], [2.229, 2.299], [2.345, 2.415], [2.473, 2.682], [2.752, 2.914], [2.995, 3.553], [3.878, 3.947], [4.017, 4.284], [4.319, 4.389], [4.458, 4.714], [4.772, 4.969], [5.016, 5.062], [5.12, 5.19], [5.236, 5.608], [5.654, 5.956], [6.026, 6.931], [7.105, 7.279], [7.349, 7.616], [7.639, 7.709], [7.779, 7.93], [7.988, 8.417], [8.44, 8.557], [8.591, 8.661], [8.719, 8.998], [9.044, 9.102], [9.16, 9.23], [9.3, 9.799], [9.857, 9.915], [9.996, 10.774]]}, "5bd0368a": {"src": "5bd0368a.mp3", "text": "The Ribeira Palace: the royal residence for about two and a half centuries, until the earthquake of 1755. Let us go through what is known of it.", "lang": "en", "words": [[0.0, 0.151], [0.209, 0.569], [0.627, 1.231], [1.556, 1.649], [1.718, 1.985], [2.055, 2.496], [2.531, 2.635], [2.682, 2.902], [2.949, 3.088], [3.146, 3.216], [3.251, 3.274], [3.332, 3.483], [3.553, 4.319], [4.528, 4.76], [4.807, 4.876], [4.934, 5.457], [5.492, 5.55], [5.619, 7.105], [7.279, 7.43], [7.477, 7.558], [7.616, 7.744], [7.814, 8.057], [8.092, 8.208], [8.255, 8.324], [8.382, 8.58], [8.615, 8.673], [8.731, 9.195]]}, "196c8c19": {"src": "196c8c19.mp3", "text": "Around 1500 Manuel I moved the court from the castle on the hill down to the river front, beside the docks, and paid for the new palace with the wealth of the India voyages: the crown now lived where its trade arrived.", "lang": "en", "words": [[0.0, 0.383], [0.453, 1.277], [1.335, 1.811], [1.904, 1.939], [2.032, 2.322], [2.368, 2.438], [2.496, 2.763], [2.81, 2.937], [2.984, 3.053], [3.1, 3.553], [3.611, 3.692], [3.738, 3.808], [3.866, 4.168], [4.493, 4.748], [4.795, 4.853], [4.911, 4.981], [5.039, 5.271], [5.341, 5.817], [5.933, 6.362], [6.385, 6.455], [6.502, 7.105], [7.256, 7.407], [7.465, 7.744], [7.802, 7.895], [7.941, 8.011], [8.081, 8.266], [8.336, 8.812], [8.847, 8.963], [9.009, 9.079], [9.149, 9.451], [9.509, 9.578], [9.636, 9.706], [9.787, 10.136], [10.194, 10.995], [11.378, 11.471], [11.529, 11.9], [11.97, 12.167], [12.249, 12.574], [12.597, 12.759], [12.794, 12.922], [12.968, 13.293], [13.317, 14.164]]}, "4f7cc52c": {"src": "4f7cc52c.mp3", "text": "Hi! I'm Azu, and I'll be your guide. Ask me anything, at any time: just tap Ask. Now, let's meet Ribeira Palace!", "lang": "en", "words": [[0.0, 0.511], [0.685, 0.859], [0.929, 1.324], [1.347, 1.428], [1.463, 1.591], [1.625, 1.695], [1.73, 1.846], [1.881, 2.31], [2.519, 2.752], [2.81, 2.902], [2.961, 3.379], [3.402, 3.483], [3.541, 3.738], [3.796, 4.133], [4.168, 4.423], [4.505, 4.865], [4.981, 5.515], [5.84, 5.991], [6.014, 6.188], [6.223, 6.351], [6.397, 6.687], [6.734, 7.477]]}, "8ad2b88e": {"src": "8ad2b88e.mp3", "text": "OK, moving on. Let's look at this.", "lang": "en", "words": [[0.0, 0.372], [0.418, 0.673], [0.743, 1.045], [1.254, 1.44], [1.463, 1.579], [1.614, 1.672], [1.707, 2.322]]}, "5be02040": {"src": "5be02040.mp3", "text": "Go on, tap the card to flip it.", "lang": "en", "words": [[0.0, 0.174], [0.267, 0.522], [0.639, 0.848], [0.894, 0.964], [0.998, 1.184], [1.219, 1.265], [1.312, 1.509], [1.567, 1.997]]}, "b04aba5e": {"src": "b04aba5e.mp3", "text": "Just one tap on the card, and you'll see what's on the other side.", "lang": "en", "words": [[0.0, 0.267], [0.348, 0.557], [0.604, 0.848], [0.917, 0.975], [1.022, 1.091], [1.138, 1.44], [1.463, 1.533], [1.567, 1.753], [1.811, 1.95], [1.985, 2.171], [2.206, 2.276], [2.322, 2.392], [2.438, 2.624], [2.682, 3.39]]}, "2d1e0f0d": {"src": "2d1e0f0d.mp3", "text": "Drag the line across the picture.", "lang": "en", "words": [[0.0, 0.372], [0.43, 0.499], [0.557, 0.824], [0.848, 1.173], [1.219, 1.289], [1.335, 2.09]]}, "f3b46e9e": {"src": "f3b46e9e.mp3", "text": "Slide it all the way across, and see what changed.", "lang": "en", "words": [[0.0, 0.36], [0.395, 0.441], [0.488, 0.615], [0.662, 0.731], [0.766, 0.871], [0.917, 1.416], [1.44, 1.521], [1.579, 1.718], [1.741, 1.858], [1.904, 2.74]]}, "06224f2f": {"src": "06224f2f.mp3", "text": "Take a guess: tap one of the answers.", "lang": "en", "words": [[0.0, 0.255], [0.279, 0.313], [0.36, 0.778], [1.022, 1.3], [1.37, 1.486], [1.509, 1.556], [1.602, 1.683], [1.753, 2.554]]}, "08942a0d": {"src": "08942a0d.mp3", "text": "No pressure, any answer will do.", "lang": "en", "words": [[0.0, 0.197], [0.279, 0.697], [0.72, 0.882], [0.94, 1.184], [1.231, 1.37], [1.405, 1.858]]}, "2062e780": {"src": "2062e780.mp3", "text": "No problem. Let's keep going.", "lang": "en", "words": [[0.0, 0.163], [0.232, 0.604], [0.627, 0.778], [0.813, 0.952], [1.01, 1.579]]}, "97f87cfb": {"src": "97f87cfb.mp3", "text": "There it is.", "lang": "en", "words": [[0.0, 0.244], [0.279, 0.348], [0.406, 0.929]]}, "b5e2f506": {"src": "b5e2f506.mp3", "text": "Nicely done.", "lang": "en", "words": [[0.0, 0.418], [0.464, 0.882]]}, "aa9c1f4e": {"src": "aa9c1f4e.mp3", "text": "Olá! Sou o Azu. Reis e rainhas viveram aqui, junto ao rio, durante muito tempo. Queres ver o palácio deles?", "lang": "pt", "words": [[0.0, 0.662], [0.987, 1.277], [1.37, 1.451], [1.533, 1.997], [2.438, 2.694], [2.763, 2.786], [2.868, 3.262], [3.332, 3.75], [3.796, 4.319], [4.598, 5.004], [5.05, 5.108], [5.19, 5.619], [5.898, 6.316], [6.362, 6.641], [6.676, 7.21], [7.593, 7.837], [7.895, 8.034], [8.081, 8.104], [8.15, 8.545], [8.591, 9.334]]}, "f96524d7": {"src": "f96524d7.mp3", "text": "Foi casa real durante cerca de duzentos e cinquenta anos, até se perder a um de novembro de 1755.", "lang": "pt", "words": [[0.0, 0.221], [0.255, 0.511], [0.58, 0.987], [1.161, 1.521], [1.544, 1.904], [1.95, 2.02], [2.078, 2.566], [2.624, 2.659], [2.705, 3.262], [3.297, 3.773], [4.098, 4.354], [4.423, 4.493], [4.528, 4.876], [4.923, 4.946], [5.004, 5.085], [5.132, 5.213], [5.259, 5.724], [5.77, 5.828], [5.909, 7.802]]}, "745b92a1": {"src": "745b92a1.mp3", "text": "Aqui está algo surpreendente. Toque no cartão para o virar.", "lang": "pt", "words": [[0.0, 0.255], [0.279, 0.464], [0.522, 0.673], [0.697, 1.486], [1.66, 1.916], [1.95, 2.043], [2.09, 2.415], [2.45, 2.624], [2.647, 2.67], [2.705, 3.297]]}, "25cebe0e": {"src": "25cebe0e.mp3", "text": "Agora a história. Este desenho mostra a praça em 1662: o longo palácio ao fundo, o grande torreão à esquerda e uma fonte erguida para uma noite de fogo de artifício.", "lang": "pt", "words": [[0.0, 0.557], [0.731, 0.859], [0.882, 1.602], [2.043, 2.357], [2.403, 2.752], [2.798, 3.135], [3.158, 3.181], [3.251, 3.727], [3.808, 3.959], [4.029, 5.48], [5.921, 6.002], [6.084, 6.351], [6.385, 6.885], [6.931, 6.978], [7.047, 7.709], [7.953, 8.022], [8.081, 8.371], [8.406, 8.975], [9.044, 9.067], [9.114, 9.787], [9.996, 10.17], [10.228, 10.403], [10.484, 10.844], [10.867, 11.285], [11.343, 11.529], [11.552, 11.68], [11.726, 11.97], [12.016, 12.086], [12.144, 12.399], [12.434, 12.492], [12.527, 13.56]]}, "2ec6e695": {"src": "2ec6e695.mp3", "text": "O rei D. Manuel achava o castelo no monte pequeno demais. Por isso, por volta de 1500, construiu um palácio novo mesmo junto ao rio, e encheu-o com as riquezas que os navios traziam da Índia!", "lang": "pt", "words": [[0.0, 0.081], [0.197, 0.476], [0.569, 0.755], [0.813, 1.3], [1.428, 1.881], [1.904, 1.927], [1.985, 2.415], [2.45, 2.531], [2.589, 2.856], [2.902, 3.228], [3.262, 3.866], [4.191, 4.389], [4.435, 4.621], [4.702, 4.841], [4.899, 5.166], [5.224, 5.294], [5.375, 6.351], [6.594, 7.14], [7.175, 7.256], [7.314, 7.779], [7.825, 8.139], [8.185, 8.545], [8.58, 8.882], [8.905, 8.963], [9.009, 9.509], [9.718, 9.892], [9.938, 10.577], [10.658, 10.82], [10.879, 10.948], [11.006, 11.517], [11.587, 11.691], [11.726, 11.784], [11.854, 12.167], [12.214, 12.608], [12.666, 12.736], [12.806, 13.514]]}, "0de43bf9": {"src": "0de43bf9.mp3", "text": "Lá dentro: uma biblioteca com cerca de setenta mil livros, o arquivo real, uma capela e, ao lado, uma ópera acabada de construir.", "lang": "pt", "words": [[0.0, 0.186], [0.244, 0.755], [1.138, 1.347], [1.393, 2.067], [2.113, 2.264], [2.322, 2.67], [2.717, 2.798], [2.844, 3.216], [3.262, 3.413], [3.46, 3.913], [3.982, 4.075], [4.122, 4.458], [4.493, 4.923], [5.039, 5.224], [5.271, 5.782], [5.875, 6.072], [6.118, 6.269], [6.327, 6.687], [6.896, 7.105], [7.163, 7.488], [7.523, 8.057], [8.104, 8.162], [8.197, 9.102]]}, "b78b555e": {"src": "b78b555e.mp3", "text": "Arraste sobre a imagem: o palácio antes de 1755 e a praça que ficou no seu lugar.", "lang": "pt", "words": [[0.0, 0.453], [0.488, 0.755], [0.789, 0.813], [0.836, 1.3], [1.37, 1.428], [1.509, 2.02], [2.067, 2.334], [2.357, 2.403], [2.473, 3.889], [4.063, 4.214], [4.249, 4.272], [4.331, 4.644], [4.679, 4.748], [4.772, 5.027], [5.074, 5.132], [5.166, 5.329], [5.352, 6.037]]}, "2df19e83": {"src": "2df19e83.mp3", "text": "É isso: o palácio antes de 1755 e a praça aberta que ficou no seu lugar.", "lang": "pt", "words": [[0.0, 0.093], [0.209, 0.697], [1.138, 1.196], [1.289, 1.869], [1.962, 2.299], [2.334, 2.392], [2.473, 4.087], [4.412, 4.69], [4.737, 4.76], [4.818, 5.178], [5.201, 5.608], [5.642, 5.712], [5.747, 6.026], [6.06, 6.13], [6.177, 6.316], [6.351, 7.059]]}, "66472e6e": {"src": "66472e6e.mp3", "text": "Na manhã de 1 de novembro de 1755, Dia de Todos os Santos, um terramoto, um incêndio e um maremoto destruíram em poucas horas o palácio, a biblioteca e a ópera.", "lang": "pt", "words": [[0.0, 0.151], [0.209, 0.464], [0.511, 0.569], [0.604, 0.697], [0.766, 0.836], [0.906, 1.347], [1.393, 1.451], [1.509, 3.332], [3.657, 3.889], [3.936, 4.005], [4.052, 4.331], [4.389, 4.481], [4.54, 4.957], [5.085, 5.166], [5.236, 6.072], [6.223, 6.316], [6.432, 7.082], [7.407, 7.558], [7.628, 7.721], [7.779, 8.452], [8.777, 9.439], [9.509, 9.648], [9.729, 10.054], [10.124, 10.356], [10.449, 10.472], [10.53, 11.122], [11.169, 11.215], [11.285, 12.063], [12.121, 12.272], [12.295, 12.318], [12.411, 13.096]]}, "3081d92e": {"src": "3081d92e.mp3", "text": "O que se perdeu com ele: a biblioteca de cerca de setenta mil livros e o arquivo real, queimados no incêndio que se seguiu ao terramoto.", "lang": "pt", "words": [[0.0, 0.093], [0.151, 0.221], [0.244, 0.29], [0.325, 0.615], [0.662, 0.813], [0.882, 1.231], [1.474, 1.521], [1.591, 2.276], [2.31, 2.357], [2.38, 2.763], [2.798, 2.844], [2.879, 3.216], [3.262, 3.413], [3.46, 3.889], [4.098, 4.214], [4.272, 4.319], [4.354, 4.737], [4.772, 5.364], [5.747, 6.269], [6.362, 6.455], [6.525, 7.129], [7.407, 7.535], [7.581, 7.697], [7.755, 8.15], [8.301, 8.464], [8.522, 9.427]]}, "51056ff9": {"src": "51056ff9.mp3", "text": "De volta ao cartão, a galeria mostra a praça ao longo de três séculos.", "lang": "pt", "words": [[0.0, 0.139], [0.186, 0.441], [0.464, 0.534], [0.58, 1.057], [1.126, 1.184], [1.265, 1.695], [1.753, 2.101], [2.125, 2.148], [2.206, 2.601], [2.67, 2.798], [2.833, 3.042], [3.1, 3.181], [3.228, 3.471], [3.506, 4.365]]}, "bdc361db": {"src": "bdc361db.mp3", "text": "Pronto para uma pergunta? Que rei mudou a corte para o rio? Toque na sua resposta.", "lang": "pt", "words": [[0.0, 0.337], [0.372, 0.522], [0.546, 0.673], [0.72, 1.347], [1.591, 1.73], [1.788, 1.904], [1.939, 2.183], [2.241, 2.264], [2.31, 2.531], [2.566, 2.74], [2.763, 2.786], [2.844, 3.297], [3.68, 3.947], [3.982, 4.052], [4.087, 4.261], [4.284, 5.155]]}, "ce14583a": {"src": "ce14583a.mp3", "text": "Foi D. Manuel I, por volta de 1500.", "lang": "pt", "words": [[0.0, 0.29], [0.337, 0.476], [0.499, 0.824], [1.103, 1.196], [1.219, 1.347], [1.393, 1.637], [1.683, 1.741], [1.776, 2.694]]}, "66f79e6f": {"src": "66f79e6f.mp3", "text": "Este foi o Paço da Ribeira. Pergunte-me o que quiser, ou explore sozinho.", "lang": "pt", "words": [[0.0, 0.232], [0.267, 0.395], [0.43, 0.464], [0.511, 0.755], [0.778, 0.848], [0.882, 1.474], [1.718, 2.229], [2.252, 2.276], [2.345, 2.426], [2.461, 2.937], [3.007, 3.111], [3.135, 3.495], [3.529, 4.412]]}, "d66d3bd6": {"src": "d66d3bd6.mp3", "text": "Bem-vindo ao Paço da Ribeira. Durante dois séculos e meio, os reis de Portugal viveram aqui, mesmo à beira do rio. Deixe-me mostrar-lhe o que aqui existia.", "lang": "pt", "words": [[0.0, 0.499], [0.534, 0.58], [0.627, 0.894], [0.929, 0.998], [1.057, 1.718], [1.927, 2.299], [2.334, 2.519], [2.543, 2.914], [2.984, 3.007], [3.065, 3.46], [3.506, 3.646], [3.715, 3.901], [3.947, 4.005], [4.052, 4.435], [4.481, 4.876], [4.934, 5.433], [5.608, 5.898], [5.933, 5.956], [6.002, 6.211], [6.258, 6.351], [6.409, 6.838], [7.442, 7.883], [7.918, 8.487], [8.568, 8.649], [8.707, 8.812], [8.835, 9.009], [9.044, 9.938]]}, "27fef1f1": {"src": "27fef1f1.mp3", "text": "Quando D. Manuel I achou o velho castelo da colina demasiado apertado, mudou a corte para junto das docas por volta de 1500 e encheu o novo palácio com a riqueza das viagens à Índia.", "lang": "pt", "words": [[0.0, 0.325], [0.395, 0.522], [0.58, 1.08], [1.231, 1.44], [1.591, 2.02], [2.043, 2.067], [2.136, 2.403], [2.426, 2.891], [2.949, 3.042], [3.088, 3.506], [3.541, 4.075], [4.098, 4.702], [5.027, 5.341], [5.387, 5.41], [5.457, 5.759], [5.793, 5.979], [6.037, 6.316], [6.374, 6.49], [6.548, 6.896], [6.966, 7.105], [7.163, 7.454], [7.5, 7.558], [7.628, 8.348], [8.673, 8.847], [8.882, 9.276], [9.311, 9.334], [9.392, 9.613], [9.648, 10.275], [10.553, 10.762], [10.82, 10.844], [10.902, 11.424], [11.482, 11.622], [11.703, 12.19], [12.26, 12.283], [12.399, 13.003]]}, "f241e56c": {"src": "f241e56c.mp3", "text": "O Paço da Ribeira: residência real durante cerca de dois séculos e meio, até ao terramoto de 1755. Vejamos o que se sabe dele.", "lang": "pt", "words": [[0.0, 0.081], [0.197, 0.488], [0.522, 0.58], [0.627, 1.184], [1.3, 1.823], [1.881, 2.136], [2.194, 2.496], [2.519, 2.891], [2.937, 3.007], [3.053, 3.251], [3.274, 3.692], [3.773, 3.796], [3.866, 4.354], [4.632, 4.899], [4.957, 5.016], [5.074, 5.654], [5.7, 5.77], [5.828, 7.593], [8.034, 8.499], [8.557, 8.58], [8.626, 8.696], [8.731, 8.824], [8.87, 9.149], [9.183, 9.799]]}, "aa12a1c3": {"src": "aa12a1c3.mp3", "text": "Por volta de 1500, D. Manuel I mudou a corte do castelo no monte para a frente ribeirinha, junto às docas, e pagou o novo paço com a riqueza das viagens à Índia: a coroa passava a viver onde o seu comércio chegava.", "lang": "pt", "words": [[0.0, 0.186], [0.232, 0.499], [0.546, 0.592], [0.662, 1.579], [1.73, 1.846], [1.939, 2.357], [2.531, 2.682], [2.833, 3.355], [3.529, 3.611], [3.692, 4.005], [4.063, 4.133], [4.18, 4.609], [4.656, 4.748], [4.807, 5.085], [5.132, 5.341], [5.364, 5.387], [5.445, 5.735], [5.793, 6.571], [6.954, 7.303], [7.349, 7.442], [7.5, 8.162], [8.44, 8.591], [8.649, 8.975], [8.998, 9.021], [9.067, 9.3], [9.334, 9.659], [9.683, 9.81], [9.868, 9.892], [9.927, 10.356], [10.426, 10.553], [10.612, 11.041], [11.122, 11.146], [11.262, 11.761], [12.202, 12.237], [12.318, 12.632], [12.678, 13.142], [13.166, 13.189], [13.235, 13.688], [13.839, 14.129], [14.153, 14.176], [14.234, 14.385], [14.431, 14.849], [14.884, 15.697]]}, "7614a621": {"src": "7614a621.mp3", "text": "Olá! Sou o Azu e vou ser o seu guia. Pergunte-me o que quiser, a qualquer momento: basta tocar em Perguntar. Agora, vamos conhecer Palácio da Ribeira!", "lang": "pt", "words": [[0.0, 0.685], [1.01, 1.289], [1.324, 1.358], [1.416, 1.776], [1.904, 2.055], [2.125, 2.276], [2.345, 2.531], [2.577, 2.601], [2.659, 2.821], [2.879, 3.379], [3.622, 4.272], [4.389, 4.505], [4.574, 4.679], [4.737, 5.259], [5.352, 5.433], [5.515, 5.933], [6.002, 6.653], [6.978, 7.349], [7.396, 7.79], [7.906, 8.057], [8.127, 8.916], [9.3, 9.706], [9.729, 9.973], [10.031, 10.484], [10.565, 11.006], [11.041, 11.122], [11.169, 11.981]]}, "e1c6b905": {"src": "e1c6b905.mp3", "text": "Muito bem, seguimos. Vejamos isto.", "lang": "pt", "words": [[0.0, 0.279], [0.302, 0.569], [0.639, 1.196], [1.37, 1.776], [1.846, 2.415]]}, "91f9323a": {"src": "91f9323a.mp3", "text": "Vá, toque no cartão para o virar.", "lang": "pt", "words": [[0.0, 0.337], [0.372, 0.604], [0.639, 0.708], [0.743, 1.08], [1.103, 1.254], [1.277, 1.324], [1.37, 2.136]]}, "157be9a4": {"src": "157be9a4.mp3", "text": "Basta um toque no cartão e vê o que está do outro lado.", "lang": "pt", "words": [[0.0, 0.36], [0.395, 0.441], [0.511, 0.743], [0.778, 0.859], [0.906, 1.428], [1.637, 1.765], [1.858, 2.055], [2.171, 2.287], [2.334, 2.415], [2.438, 2.635], [2.705, 2.775], [2.821, 3.042], [3.077, 3.669]]}, "95e67f16": {"src": "95e67f16.mp3", "text": "Arraste a linha sobre a imagem.", "lang": "pt", "words": [[0.0, 0.488], [0.511, 0.534], [0.592, 0.859], [0.917, 1.242], [1.265, 1.289], [1.335, 2.183]]}, "06b7b1ab": {"src": "06b7b1ab.mp3", "text": "Deslize até ao fim e veja o que mudou.", "lang": "pt", "words": [[0.0, 0.546], [0.569, 0.766], [0.801, 0.882], [0.952, 1.161], [1.207, 1.242], [1.312, 1.591], [1.614, 1.637], [1.695, 1.776], [1.823, 2.461]]}, "87d5c05a": {"src": "87d5c05a.mp3", "text": "Arrisque: toque numa das respostas.", "lang": "pt", "words": [[0.0, 0.534], [0.778, 1.068], [1.103, 1.289], [1.335, 1.451], [1.498, 2.415]]}, "34298478": {"src": "34298478.mp3", "text": "Sem pressão, qualquer resposta serve.", "lang": "pt", "words": [[0.0, 0.232], [0.279, 0.917], [1.068, 1.416], [1.451, 1.927], [1.985, 2.694]]}, "8203d7bc": {"src": "8203d7bc.mp3", "text": "Não faz mal. Vamos continuar.", "lang": "pt", "words": [[0.0, 0.163], [0.209, 0.372], [0.43, 0.697], [0.766, 0.964], [1.01, 1.858]]}, "eb26341c": {"src": "eb26341c.mp3", "text": "Aí está.", "lang": "pt", "words": [[0.0, 0.279], [0.337, 1.115]]}, "68e52659": {"src": "68e52659.mp3", "text": "Muito bem.", "lang": "pt", "words": [[0.0, 0.29], [0.325, 1.022]]}}, "label": "ElevenLabs · Bella (en-US) / Luis (pt-PT)"}