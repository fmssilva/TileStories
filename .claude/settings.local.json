{
  "permissions": { "allow": ["mcp__UnityMCP"] },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "async": true, "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/alert.ps1\" start" }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "async": true, "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/alert.ps1\" start" }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "async": true, "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/alert.ps1\" stop" }]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [{ "type": "command", "async": true, "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/alert.ps1\" stop" }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/alert.ps1\" stop" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "async": true, "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/alert.ps1\" stop" }]
      }
    ]
  }
}
