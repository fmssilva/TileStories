  m_Script: {fileID: 11500000, guid: 3d566dd9c2f67aa4494efb3c620d23e5, type: 3}
  m_Name: Theme.default
  m_EditorClassIdentifier: TileStories::TileStories.ThemeAsset
  key: default
  defaultMode: light
  shared:
    colours: []
    lengths:
    - name: --ts-line-width
      value:
        value: 1
        unit: 0
      note: 
    - name: --ts-size-body
      value:
        value: 16
        unit: 0
      note: Type
    - name: --ts-size-body-open
      value:
        value: 17
        unit: 0
      note: The body inside an OPEN section (Look Blocks = Open, v6's 17 pt prose
        on the open ground)
    - name: --ts-size-title
      value:
        value: 24
        unit: 0
      note: 
    - name: --ts-size-caption
      value:
