        unit: 0
      note: 
    - name: --ts-size-hero
      value:
        value: 40
        unit: 0
      note: The hero's title over its picture (_3.3 R11, P4.4a), the display face
    - name: --ts-size-hero-narrow
      value:
        value: 34
        unit: 0
      note: The hero's title on a phone (HeroRule.IsNarrow, under 400 pt wide)
    - name: --ts-size-dropcap
      value:
        value: 48
        unit: 0
      note: 
    - name: --ts-size-quote
