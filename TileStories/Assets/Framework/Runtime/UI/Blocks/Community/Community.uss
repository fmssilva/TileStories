/* The community family's looks (_3.1 Tier 3): what the visitor tells back -- feedback.
   Written ONLY with the --ts-* tokens of CardTokens.uss: no literal colour, size or radius here or in C# (_3.1 section 3,
   _3.3). UI Toolkit USS only: no sibling selectors (an import ERROR that drops the whole sheet), no % radius, no web-CSS
   gap / cursor / calc. Thumbs and stars are painted vector glyphs (CardIcons): no glyph font, no picture. */

/* ---- feedback: the question, the row of thumbs or stars, the thank-you ---- */

.card-feedback__question {
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0 0 var(--ts-space-3) 0;
    padding: 0;
}

.card-feedback__row {
    flex-direction: row;
}

.card-feedback__vote {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: var(--ts-vote-size);
    min-height: var(--ts-vote-size);
    margin: 0 var(--ts-space-3) 0 0;
    padding: var(--ts-space-2) var(--ts-space-3);
    border-width: var(--ts-choice-border);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
}

.card-feedback__vote--on {
    border-color: var(--ts-accent);
}

/* stars carry no button chrome: five outlined stars, the ones up to the vote filled */
.card-feedback--stars .card-feedback__vote {
    min-width: var(--ts-touch-target);
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: var(--ts-clear);
}

.card-feedback__vote-text {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
    margin: var(--ts-space-1) 0 0 0;
    padding: 0;
}

/* a thumb or a star: a painted vector glyph (CardIcons.VectorGlyph) -- its colour is this `color`, its size this box; it is an outline
   while off and filled once voted (the shape carries "on" as well as the colour) */
.card-feedback__glyph {
    width: var(--ts-vote-glyph);
    height: var(--ts-vote-glyph);
    color: var(--ts-ink-2);
}

.card-feedback__vote--on .card-feedback__glyph {
    color: var(--ts-accent);
}

.card-feedback__thanks {
    font-size: var(--ts-size-body);
    color: var(--ts-ink-2);
    white-space: normal;
    margin: var(--ts-space-3) 0 0 0;
    padding: 0;
}
