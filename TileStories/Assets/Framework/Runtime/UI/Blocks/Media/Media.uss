/* The media family's looks (_3.1 Tier 2) and the card's picture parts: CardImage, the header's hero, the gallery, the
   full-screen view (TakeoverView), before / after and zoom. Written only with var(--ts-*) tokens (CardTokens.uss).
   Added to the card by its host after CardParts.uss (PoiCardHost / CardGalleryHarness blockStyles). */

/* ---- CardImage: one picture in a clipped frame; the "unavailable" words instead of a picture that cannot be shown ---- */

.card-image {
    position: relative;
    overflow: hidden;
    background-color: var(--ts-surface-2);
    border-radius: var(--ts-radius-m);
}

.card-image__picture {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}

.card-image__unavailable {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    padding: var(--ts-space-2);
}

.card-image--unavailable > .card-image__unavailable {
    display: flex;
}

/* ---- the header's hero (_3.3 R11 v3-v4, P4.4a): first in what scrolls -- the picture full width with the title, a line and the card's
   actions ON it, over a graded scrim; the text looks draw it as a plain plate. Its height is set by the sheet (HeroRule.Height: what Half
   shows under the bar); the frame, the moving media and the scrim fill it, the words and the actions sit at its foot ---- */

.card-hero {
    flex-shrink: 0;
    justify-content: flex-end;
    overflow: hidden;
    margin: 0 0 var(--ts-block-gap) 0;
}

/* the picture's window: it clips the picture that pans, zooms and lags behind the scroll (transform only, from C#) */
.card-hero__frame {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: var(--ts-surface-2);
}

.card-hero__media {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
}

/* the picture fills the frame (image_parallax: as wide as its own proportions ask, set from C#, so a wide one can pan) */
.card-hero .card-hero__picture {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
}

/* the FOOT: the words and the actions, minimal on the picture (_3.3 S4a; the premium target, v5) -- no plate. Words On Picture (_3.3 P3c
   addendum, HeroWordsRule): a HALO on every letter (a close 1 px shade -- the text's outline, --ts-text-halo-close-width -- and a soft glow --
   the text-shadow, --ts-text-halo) and a TONE on the picture (the layer below), only as strong as 4.5:1 needs. MEASURED on the render:
   every word against the picture right around its letters, on every hero picture of the wall (PoiCardHeroSceneTests) */
.card-hero__foot {
    flex-shrink: 0;
    padding: 0 0 var(--ts-hero-words-inset) 0;
}

/* Words On Picture's layer: the whole hero over its picture, under its words (HeroWordsOnPicture paints the tone or the scrim on it) */
.card-hero__tone {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* the halo's SECOND layer (HeroWordsOnPicture): a back label under every word, the same words in the halo's colour with a close outline
   and a wide soft glow -- hidden behind the words' own letters, it darkens the picture round them a second time (both reach only as far
   as the font's SDF does: FontAtlasBuilder.UiAtlasPadding) */
.card-hero__halo-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.card-hero__halo {
    position: absolute;
    margin: 0;
    padding: 0;
    color: var(--ts-text-halo);
    -unity-text-outline-width: var(--ts-text-halo-wide-width);
    -unity-text-outline-color: var(--ts-text-halo);
    text-shadow: 0 1px var(--ts-text-halo-wide-blur) var(--ts-text-halo);
}

.card-hero--no-halo .card-hero__halo-layer {
    display: none;
}

/* the halo's close shade on every word of the hero (its glow is each word's text-shadow below) */
.card-hero__eyebrow,
.card-hero__title,
.card-hero__subtitle,
.card-hero__listen .card-audio__title,
.card-hero__listen .card-audio__time,
.card-hero__primary .card-action__label {
    -unity-text-outline-width: var(--ts-text-halo-close-width);
    -unity-text-outline-color: var(--ts-text-halo);
}

/* Edge Scrim: the words bare on their scrim (no glow, no close shade) */
.card-hero--no-halo .card-hero__eyebrow,
.card-hero--no-halo .card-hero__title,
.card-hero--no-halo .card-hero__subtitle,
.card-hero--no-halo .card-hero__listen .card-audio__title,
.card-hero--no-halo .card-hero__listen .card-audio__time,
.card-hero--no-halo .card-hero__primary .card-action__label {
    text-shadow: none;
    -unity-text-outline-width: 0;
}

/* the words: eyebrow, the title in the display face, one line -- the hero's side gutter, a halo round every letter */
.card-hero__text {
    margin-bottom: var(--ts-space-3);
    padding: 0 var(--ts-space-5);
}

.card-hero__eyebrow {
    font-size: var(--ts-hero-eyebrow-size);
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: var(--ts-on-scrim-2);
    text-shadow: 0 1px var(--ts-text-halo-blur) var(--ts-text-halo);
    /* a kicker: one line, cut only when it truly does not fit */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0 0 var(--ts-space-1) 0;
    padding: 0;
}

.card-hero__title {
    font-size: var(--ts-size-hero);
    -unity-font-style: bold;
    color: var(--ts-on-scrim);
    text-shadow: 0 1px var(--ts-text-halo-blur) var(--ts-text-halo);
    white-space: normal;
    margin: 0 0 var(--ts-space-1) 0;
    padding: 0;
}

.card-hero--narrow .card-hero__title {
    font-size: var(--ts-size-hero-narrow);
}

.card-hero__subtitle {
    font-size: var(--ts-hero-line-size);
    color: var(--ts-on-scrim);
    text-shadow: 0 1px var(--ts-text-halo-blur) var(--ts-text-halo);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.card-hero__eyebrow--empty,
.card-header__subtitle--empty,
.card-hero--compact .card-hero__eyebrow,
.card-hero--compact .card-hero__subtitle {
    display: none;
}

/* the actions row under the words: the card's focal action as a thin outline (the "Book Now" of a website's hero) and Listen as a small
   headphones mark + time, no box -- each still a whole touch target. ONE row always (P4.4b part 2) */
.card-hero__actions {
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    padding: 0 var(--ts-space-5);
}

.card-hero__primary {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 var(--ts-space-4) 0 0;
    padding: 0;
    border-top-width: 0;
    background-color: var(--ts-clear);
}

.card-hero__primary .card-action {
    margin: 0;
    padding: 0 var(--ts-space-4);
    justify-content: center;
    border-width: var(--ts-line-width);
    border-color: var(--ts-on-scrim);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-hero-glow);
}

.card-hero__primary .card-action__label {
    color: var(--ts-on-scrim);
    text-shadow: 0 1px var(--ts-text-halo-blur) var(--ts-text-halo);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-hero__primary .card-action .card-icon__frame {
    border-color: var(--ts-on-scrim);
}

.card-hero__primary .card-action .card-icon__bar,
.card-hero__primary .card-action .card-icon__dot {
    background-color: var(--ts-on-scrim);
}

.card-hero__listen {
    flex-shrink: 0;
    margin: 0;
    padding: 0 var(--ts-space-2) 0 0;
    border-width: 0;
    background-color: var(--ts-clear);
}

.card-hero__listen .card-audio__listen-icon .card-icon__glyph {
    width: var(--ts-hero-listen-icon);
    height: var(--ts-hero-listen-icon);
}

.card-hero__listen .card-audio__listen-icon .card-icon__frame {
    border-color: var(--ts-on-scrim);
}

/* at this small size the ear cups are drawn fuller than the set's (at the set's 24 % they were no wider than the band's stroke: a bare arch) */
.card-hero__listen .card-audio__listen-icon .card-icon__bar {
    background-color: var(--ts-on-scrim);
    top: 46%;
    width: 32%;
    height: 50%;
}

.card-hero__listen .card-audio__play {
    width: var(--ts-hero-listen-target);
    background-color: var(--ts-clear);
}

.card-hero__listen .card-audio__glyph {
    width: var(--ts-hero-listen-icon);
    height: var(--ts-hero-listen-icon);
    color: var(--ts-on-scrim);
}

.card-hero__listen .card-audio__title,
.card-hero__listen .card-audio__time {
    font-size: var(--ts-hero-listen-text);
    color: var(--ts-on-scrim);
    text-shadow: 0 1px var(--ts-text-halo-blur) var(--ts-text-halo);
    white-space: nowrap;
}

.card-hero__listen .card-audio__words {
    flex-grow: 0;
    margin-left: 0;
}

.card-hero__listen .card-audio__scrubber,
.card-hero__listen .card-audio__note {
    display: none;
}

/* the plate (Text Only, Compact, a picture look without its picture): no picture, the words in the card's own ink */
.card-hero--plate .card-hero__foot {
    padding: var(--ts-space-2) var(--ts-space-4) 0 var(--ts-space-4);
    /* opaque, the bar continued: the sheet is glass since _3.3 P4.4b, and the plate's words never sit on the camera */
    background-color: var(--ts-bar);
}

.card-hero--plate .card-hero__shade {
    display: none;
}

/* on the plate the words need no shade or halo of their own, nor a gutter beside the foot's */
.card-hero--plate .card-hero__text,
.card-hero--plate .card-hero__actions {
    padding: 0;
}

.card-hero--plate .card-hero__eyebrow,
.card-hero--plate .card-hero__title,
.card-hero--plate .card-hero__subtitle,
.card-hero--plate .card-hero__listen .card-audio__title,
.card-hero--plate .card-hero__listen .card-audio__time,
.card-hero--plate .card-hero__primary .card-action__label {
    text-shadow: none;
    -unity-text-outline-width: 0;
}

.card-hero--plate .card-hero__eyebrow {
    color: var(--ts-ink-2);
}

.card-hero--plate .card-hero__title {
    font-size: var(--ts-size-title);
    color: var(--ts-ink);
}

.card-hero--plate .card-hero__subtitle {
    font-size: var(--ts-size-body);
    color: var(--ts-ink-2);
}

.card-hero--plate .card-hero__listen {
    background-color: var(--ts-clear);
}

/* on the plate the focal action keeps the card's accent fill (a white outline would vanish on the bar's ground) */
.card-hero--plate .card-hero__primary .card-action {
    border-width: 0;
    background-color: var(--ts-accent);
}

.card-hero--plate .card-hero__primary .card-action__label {
    color: var(--ts-on-accent);
}

.card-hero--plate .card-hero__primary .card-action .card-icon__frame {
    border-color: var(--ts-on-accent);
}

.card-hero--plate .card-hero__primary .card-action .card-icon__bar,
.card-hero--plate .card-hero__primary .card-action .card-icon__dot {
    background-color: var(--ts-on-accent);
}

.card-hero--plate .card-hero__listen .card-audio__listen-icon .card-icon__frame {
    border-color: var(--ts-ink);
}

.card-hero--plate .card-hero__listen .card-audio__listen-icon .card-icon__bar {
    background-color: var(--ts-ink);
}

.card-hero--plate .card-hero__listen .card-audio__glyph,
.card-hero--plate .card-hero__listen .card-audio__title,
.card-hero--plate .card-hero__listen .card-audio__time {
    color: var(--ts-ink);
}

/* model_turntable: the SAME preview view fills the frame (no block margin, no drag hint), its stage the whole frame */
.card-hero .card-hero__model {
    width: 100%;
    height: 100%;
    margin: 0;
}

.card-hero__model .card-preview__frame {
    height: 100%;
    border-radius: 0;
}

/* then | now: two equal halves side by side, the frame's colour showing as a thin line between them */
.card-hero--split_then_now .card-hero__picture {
    position: relative;
    width: auto;
    flex-grow: 1;
    flex-basis: 0;
}

/* (USS has no sibling selector: the right half carries its own class) -- a margin, not a border, so both halves keep
   the same width */
.card-hero--split_then_now .card-hero__picture--now {
    margin-left: var(--ts-slider-line);
}

/* the Then / Now labels sit at the top of each half: the hero's words take the foot */
.card-hero__label {
    position: absolute;
    left: var(--ts-space-2);
    top: var(--ts-space-2);
    padding: var(--ts-space-1) var(--ts-space-2);
    border-radius: var(--ts-radius-s);
    background-color: var(--ts-surface);
    color: var(--ts-ink);
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
}

/* spotlight: the picture's size and place come from SpotlightCropRule; the ring sits centred on the focus point */
.card-hero--spotlight_crop .card-hero__picture {
    width: auto;
    height: auto;
}

.card-hero__ring {
    position: absolute;
    width: var(--ts-spotlight-ring);
    height: var(--ts-spotlight-ring);
    translate: -50% -50%;
    border-radius: var(--ts-spotlight-ring-radius);
    border-width: var(--ts-spotlight-ring-width);
    border-color: var(--ts-accent);
}

/* ---- gallery: carousel, grid, filmstrip, stack ---- */

.card-gallery__track-content {
    flex-direction: row;
}

.card-gallery__caption {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
    margin-top: var(--ts-space-1);
}

/* carousel: pages on a swipe track, the next one peeking in at the edge */
.card-gallery--carousel .card-gallery__shot {
    width: var(--ts-carousel-page);
    flex-shrink: 0;
    margin-right: var(--ts-space-3);
}

.card-gallery--carousel .card-gallery__picture {
    height: var(--ts-media-height);
}

.card-gallery__dots {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--ts-space-2);
}

.card-gallery__dot {
    width: var(--ts-dot-size);
    height: var(--ts-dot-size);
    border-radius: var(--ts-radius-s);
    margin: 0 var(--ts-space-1);
    background-color: var(--ts-ink-3);
}

.card-gallery__dot--current {
    background-color: var(--ts-accent);
}

/* grid: two per row */
.card-gallery__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.card-gallery--grid .card-gallery__shot {
    width: 50%;
    padding: var(--ts-space-1);
}

.card-gallery--grid .card-gallery__picture {
    height: var(--ts-grid-cell-height);
}

/* filmstrip: one large picture, the small ones in a strip under it (the large one's small one marked) */
.card-gallery__main {
    height: var(--ts-media-height);
}

.card-gallery--filmstrip .card-gallery__caption {
    margin-bottom: var(--ts-space-2);
}

.card-gallery__thumb {
    width: var(--ts-thumb-size);
    height: var(--ts-thumb-size);
    flex-shrink: 0;
    margin-right: var(--ts-space-2);
    border-width: var(--ts-slider-line);
    border-color: var(--ts-clear);
    border-radius: var(--ts-radius-m);
}

.card-gallery__thumb .card-gallery__picture {
    height: 100%;
}

.card-gallery__thumb--current {
    border-color: var(--ts-accent);
}

/* stack: up to three prints fanned, the first on top */
.card-gallery--stack .card-gallery__grid {
    height: var(--ts-media-height);
    margin: 0 var(--ts-print-offset) var(--ts-print-offset) 0;
}

.card-gallery--stack .card-gallery__shot {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.card-gallery--stack .card-gallery__picture {
    height: 100%;
    border-width: var(--ts-slider-line);
    border-color: var(--ts-surface);
}

.card-gallery__print--1 {
    rotate: var(--ts-print-tilt);
    translate: var(--ts-print-offset) 0;
}

.card-gallery__print--2 {
    rotate: var(--ts-postcard-tilt);
    translate: 0 var(--ts-print-offset);
}

.card-gallery__count {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    margin-top: var(--ts-space-3);
}

/* ---- the full-screen view over the card (TakeoverView); the gallery's lightbox page ---- */

.card-takeover {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ts-bg);
}

/* The view has no side padding of its own: the top bar and a block page's scroll reach the phone's edges (a full-bleed picture meets them),
   and every other page keeps the 16 pt gutter here, on the page */
.card-takeover__page {
    flex-grow: 1;
    margin: var(--ts-space-4) var(--ts-space-4);
}

/* the chips: ONE line clipped at the screen's width (TakeoverView's NavStrip moves the row, the current chip always in view). The row starts at
   the strip's left edge, as the tab strips do: centring it would push an overflowing row off the left (Yoga gives auto margins the NEGATIVE
   room too -- measured: x -381 for 20 chips) where NavStrip's offset cannot bring it back */
.card-takeover__chips-strip {
    flex-direction: row;
    flex-shrink: 0;
    overflow: hidden;
    margin: 0 var(--ts-space-4) var(--ts-space-4) var(--ts-space-4);
}

.card-takeover__chips {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
}

.card-takeover__chip {
    min-width: var(--ts-touch-target);
    min-height: var(--ts-touch-target);
    border-radius: var(--ts-pill-radius);
    border-width: var(--ts-choice-border);
    border-color: var(--ts-surface-2);
    margin: var(--ts-space-1);
    background-color: var(--ts-surface-2);
    color: var(--ts-ink);
    font-size: var(--ts-size-body);
}

/* the page shown: filled, AND bold with a ring of ink -- never colour alone */
.card-takeover__chip--current {
    background-color: var(--ts-accent);
    color: var(--ts-on-accent);
    border-color: var(--ts-ink);
    -unity-font-style: bold;
}

/* a chip that shows its block's KIND icon instead of a number (_3.2 step 17a): the icon centred in the touch target; the page being read adds
   its words (that block's heading) after the icon, one line, cut with an ellipsis past --ts-chip-words-max. On the filled chip the icon and
   the words are drawn in the on-accent colour: the icon's own accent colour would vanish on the accent fill */
.card-takeover__chip--icon {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 var(--ts-space-3);
}

.card-takeover__chip-words {
    margin: 0 0 0 var(--ts-space-2);
    padding: 0;
    max-width: var(--ts-chip-words-max);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-on-accent);
}

.card-takeover__chip--current .card-icon__frame {
    border-color: var(--ts-on-accent);
}

.card-takeover__chip--current .card-icon__bar,
.card-takeover__chip--current .card-icon__dot {
    background-color: var(--ts-on-accent);
}

/* the lightbox page's picture: a ZoomPanSurface filling the page (swipe to turn, pinch to look closer) */
.card-gallery__full {
    flex-grow: 1;
    background-color: var(--ts-bg);
}

.card-gallery__full-caption {
    margin-top: var(--ts-space-3);
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    white-space: normal;
}

.card-gallery__full-credit {
    margin-top: var(--ts-space-1);
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
}

/* ---- before_after: After fills the frame, Before over it cut at the handle ---- */

.card-before-after__frame {
    height: var(--ts-media-height);
    overflow: hidden;
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
}

.card-before-after__after,
.card-before-after__before {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 0;
}

.card-before-after__after {
    right: 0;
}

.card-before-after__clip {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.card-before-after__handle {
    position: absolute;
    top: 0;
    bottom: 0;
    width: var(--ts-slider-line);
    translate: -50% 0;
    background-color: var(--ts-ink);
    align-items: center;
    justify-content: center;
}

.card-before-after__knob {
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    flex-shrink: 0;
    border-radius: var(--ts-pill-radius);
    border-width: var(--ts-slider-line);
    border-color: var(--ts-ink);
    background-color: var(--ts-surface);
}

.card-before-after__label {
    position: absolute;
    top: var(--ts-space-2);
    padding: var(--ts-space-1) var(--ts-space-2);
    border-radius: var(--ts-radius-s);
    background-color: var(--ts-surface);
    color: var(--ts-ink);
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
}

.card-before-after__label--before {
    left: var(--ts-space-2);
}

.card-before-after__label--after {
    right: var(--ts-space-2);
}

/* ---- zoom_image: the picture's size and place come from ZoomPanRule ---- */

/* ZoomPanSurface (zoom_image's frame, the lightbox page): the picture is placed and sized by ZoomPanRule inside a frame
   that cuts it off at its edges */
.card-zoompan {
    overflow: hidden;
}

.card-zoompan__image {
    position: absolute;
    border-radius: 0;
    background-color: var(--ts-clear);
}

.card-zoompan__image .card-image__picture {
    -unity-background-scale-mode: stretch-to-fill;
}

.card-zoom__frame {
    height: var(--ts-media-height);
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
}

.card-zoom__caption {
    margin-top: var(--ts-space-2);
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
}

.card-zoom__hint {
    margin-top: var(--ts-space-1);
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
}

/* ---- hotspot_image: numbered, loupes. The picture whole in its frame, every spot placed ON the picture by the view
   (HotspotImageBlockView), centred on its point; a tapped spot's text opens under the picture ---- */

.card-hotspot__frame {
    height: var(--ts-media-height);
    overflow: hidden;
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
}

.card-hotspot__picture {
    position: absolute;
    border-radius: 0;
    background-color: var(--ts-clear);
}

.card-hotspot__picture .card-image__picture {
    -unity-background-scale-mode: stretch-to-fill;
}

/* a spot: a touch-target square centred on its point, the numbered circle in its middle */
.card-hotspot__pin {
    position: absolute;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    translate: -50% -50%;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: var(--ts-clear);
    align-items: center;
    justify-content: center;
}

.card-hotspot__number {
    width: var(--ts-hotspot-pin);
    height: var(--ts-hotspot-pin);
    border-radius: var(--ts-hotspot-pin-radius);
    border-width: var(--ts-spotlight-ring-width);
    border-color: var(--ts-on-accent);
    background-color: var(--ts-accent);
    color: var(--ts-on-accent);
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.card-hotspot__pin--open .card-hotspot__number {
    background-color: var(--ts-ink);
    border-color: var(--ts-accent);
}

/* a spot that opens a block (HotspotPinRule) wears an arrow badge at the corner of its tap area (pin) or close-up (loupe): the open_block
   icon on the floating surface's dark disc and light edge, so it reads over a bright or a dark picture and is no colour-only cue */
.card-hotspot__jump {
    display: none;
    position: absolute;
    right: -6px;
    bottom: -6px;
    width: var(--ts-hotspot-jump);
    height: var(--ts-hotspot-jump);
    align-items: center;
    justify-content: center;
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-hotspot-jump-radius);
    background-color: var(--ts-surface);
}

.card-hotspot__pin--jumps .card-hotspot__jump,
.card-hotspot__loupe--jumps .card-hotspot__jump {
    display: flex;
}

/* loupes: the spot on the picture is only a small bare ring (the loupe under the picture is what the visitor taps) */
.card-hotspot--loupes .card-hotspot__number {
    width: var(--ts-hotspot-mark);
    height: var(--ts-hotspot-mark);
    border-radius: var(--ts-hotspot-mark-radius);
    background-color: var(--ts-clear);
    border-color: var(--ts-accent);
}

.card-hotspot__loupes {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--ts-space-3);
}

.card-hotspot__loupe {
    width: var(--ts-loupe-size);
    height: var(--ts-loupe-size);
    border-radius: var(--ts-loupe-radius);
    overflow: hidden;
    margin: 0 var(--ts-space-3) var(--ts-space-3) 0;
    padding: 0;
    border-width: var(--ts-spotlight-ring-width);
    border-color: var(--ts-line);
    background-color: var(--ts-surface-2);
}

.card-hotspot__loupe--open {
    border-color: var(--ts-accent);
}

.card-hotspot__loupe-picture {
    position: absolute;
    border-radius: 0;
    background-color: var(--ts-clear);
}

.card-hotspot__loupe-picture .card-image__picture {
    -unity-background-scale-mode: stretch-to-fill;
}

/* a close-up of a missing picture stays an empty circle: the picture above already says it is unavailable, and the
   words do not fit a loupe */
.card-hotspot__loupe-picture.card-image--unavailable > .card-image__unavailable {
    display: none;
}

/* where the spot is inside its close-up (it leaves the centre near the picture's edges) */
.card-hotspot__loupe-ring {
    position: absolute;
    width: var(--ts-hotspot-mark);
    height: var(--ts-hotspot-mark);
    translate: -50% -50%;
    border-radius: var(--ts-hotspot-mark-radius);
    border-width: var(--ts-spotlight-ring-width);
    border-color: var(--ts-accent);
}

.card-hotspot__hint {
    margin-top: var(--ts-space-1);
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
}

/* the open spot's number + title and text; nothing while no spot is open */
.card-hotspot__detail {
    display: none;
    margin-top: var(--ts-space-3);
    padding: var(--ts-space-3);
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
}

.card-hotspot__detail--open {
    display: flex;
}

.card-hotspot__detail-heading {
    flex-direction: row;
    align-items: center;
}

/* the open spot's number beside its title: the same circle as on the picture, in every variant */
.card-hotspot__detail-heading .card-hotspot__number {
    width: var(--ts-hotspot-pin);
    height: var(--ts-hotspot-pin);
    border-radius: var(--ts-hotspot-pin-radius);
    background-color: var(--ts-accent);
    border-color: var(--ts-on-accent);
    color: var(--ts-on-accent);
    flex-shrink: 0;
    margin-right: var(--ts-space-2);
}

.card-hotspot__detail-title {
    flex-shrink: 1;
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.card-hotspot__paragraph {
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    white-space: normal;
    margin: var(--ts-space-2) 0 0 0;
    padding: 0;
}

/* ---- video (step 9B): the surface (poster, the video's frames over it, a round play button in the middle), then the controls row,
   the shared scrubber and caption line (Guides.uss) and the chapter buttons; the takeover display's teaser is the same surface ---- */

.card-video__surface {
    height: var(--ts-media-height);
    overflow: hidden;
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
    align-items: center;
    justify-content: center;
}

/* the poster and the frames fill the surface; the frames keep the video's own shape (letterboxed), the poster is cropped to fill */
.card-video__surface .card-video__poster {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
}

.card-video__frames {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* no poster written: a plain frame (the surface's own colour) with the play button */
.card-video--no-poster .card-video__poster {
    display: none;
}

/* a clip that cannot be loaded: a quiet button and no bar with a knob that only looks draggable (the audio guide's unavailable look) */
.card-video--unavailable .card-audio__play {
    background-color: var(--ts-surface-2);
}

.card-video--unavailable .card-audio__glyph {
    color: var(--ts-ink-3);
}

.card-video--unavailable .card-audio__scrubber {
    display: none;
}

/* while the video's frames show: the poster steps back and the bars around a video of another shape are one plain colour */
.card-video--frames .card-video__poster {
    display: none;
}

.card-video--frames .card-video__frames {
    background-color: var(--ts-video-letterbox);
}

.card-video__overlay {
    width: var(--ts-video-overlay);
    height: var(--ts-video-overlay);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: var(--ts-video-overlay-radius);
    background-color: var(--ts-accent);
}

.card-video__overlay-glyph {
    width: var(--ts-video-overlay-glyph);
    height: var(--ts-video-overlay-glyph);
    color: var(--ts-on-accent);
}

/* the teaser's length, bottom right on the poster */
.card-video__length {
    position: absolute;
    right: var(--ts-space-2);
    bottom: var(--ts-space-2);
    padding: var(--ts-space-1) var(--ts-space-2);
    border-radius: var(--ts-radius-s);
    background-color: var(--ts-surface);
    color: var(--ts-ink);
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
}

.card-video__controls {
    flex-direction: row;
    align-items: center;
    margin-top: var(--ts-space-2);
}

.card-video__words {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin-left: var(--ts-space-3);
}

/* the captions chip keeps the audio guide's look (Guides.uss); here it sits in the row, not under the bar */
.card-video__controls .card-audio__chip {
    margin: 0 var(--ts-space-2) 0 0;
}

.card-video__full-screen {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ts-choice-border);
    border-color: var(--ts-line);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface-2);
}

.card-video__full-screen-glyph {
    width: var(--ts-video-icon);
    height: var(--ts-video-icon);
    color: var(--ts-ink);
}

.card-video__chapters {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: var(--ts-space-2);
}

.card-video__chapter {
    min-height: var(--ts-touch-target);
    max-width: var(--ts-video-chapter-max);
    margin: 0 var(--ts-space-2) var(--ts-space-2) 0;
    padding: var(--ts-space-1) var(--ts-space-3);
    font-size: var(--ts-size-caption);
    color: var(--ts-ink);
    white-space: normal;
    -unity-text-align: middle-left;
    border-width: var(--ts-choice-border);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
}

.card-video__chapter--current {
    color: var(--ts-accent-text);
    border-color: var(--ts-accent);
}

/* full screen: the surface takes the page's height, the rest stays under it */
.card-video--full {
    flex-grow: 1;
}

.card-video--full .card-video__surface {
    height: auto;
    flex-grow: 1;
}

/* ---- model_3d and panorama_360 (steps 10A.2b.3, 10A.4): the stage's RenderTexture over the frame; the fallback picture (or its own
   "unavailable" words) underneath while the model loads or if it never does, with a small loading note on top ---- */

.card-preview__frame {
    height: var(--ts-media-height);
    overflow: hidden;
    border-radius: var(--ts-radius-m);
    background-color: var(--ts-surface-2);
    align-items: center;
    justify-content: center;
}

.card-preview__surface {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

.card-preview__fallback {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
}

.card-preview__loading {
    position: absolute;
    bottom: var(--ts-space-2);
    right: var(--ts-space-2);
    padding: var(--ts-space-1) var(--ts-space-2);
    border-radius: var(--ts-radius-s);
    background-color: var(--ts-surface);
    color: var(--ts-ink-2);
    font-size: var(--ts-size-caption);
}

.card-preview__hint {
    margin-top: var(--ts-space-1);
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
}

/* Display Takeover's teaser (10A.3.1): the name badge opposite corner from Loading's, the open-full-screen button
   reuses video's own centred round overlay (card-video__overlay/-glyph) so both media kinds share one look */
/* the full-screen page (10A.3.1): the frame takes ALL the height the page leaves it, same as card-video--full */
.card-preview--full {
    flex-grow: 1;
}

.card-preview--full .card-preview__frame {
    height: auto;
    flex-grow: 1;
}

.card-preview__teaser-name {
    position: absolute;
    bottom: var(--ts-space-2);
    left: var(--ts-space-2);
    padding: var(--ts-space-1) var(--ts-space-2);
    border-radius: var(--ts-radius-s);
    background-color: var(--ts-surface);
    color: var(--ts-ink);
    font-size: var(--ts-size-caption);
}

/* ---- the header's video_loop: the loop's frames over the poster (cropped to fill the hero like a picture) ---- */

.card-hero__loop {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-and-crop;
}
