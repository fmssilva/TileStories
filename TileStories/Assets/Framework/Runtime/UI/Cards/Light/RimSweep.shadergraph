{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "310a4f4da3fb4cec88c48dd370c96f24",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RimSweep (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -400.0,
            "y": 0.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "3522009f6914483fbc5868497cd75a6a"
        },
        {
            "m_Id": "d4c9e0920f7342b7bf01c1a24385c979"
        },
        {
            "m_Id": "1006ecde25a74c5190f28e8c6234d009"
        },
        {
            "m_Id": "74d034aecd1b49fd9b0e3a4620e2f000"
        },
        {
            "m_Id": "8377b385b7e84c12b97e55ada0e30ec2"
        },
        {
            "m_Id": "1728b192facb4207bf1d859f4aa90f82"
        },
        {
            "m_Id": "26dd746951e645739570c58be4f5285a"
        },
        {
            "m_Id": "e9e43e9d35dd49c6a6ea66b1e85145d7"
        },
        {
            "m_Id": "56a822bae18547b793c48e91852dc299"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RimSweep",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// The rim light (_3.3 P4.4c2, R11 v3): a conic highlight around the block's centre, turning once per Period, seen only in the rim's\n// band (Size.w points inside the block's rounded edge, radius Size.z). The prototype's profile: dark to 268 deg, the peak at 306, dark\n// again at 330 -- Arc degrees wide (narrower on dark metal). Layout UV runs bottom-up. Animate 0 = reduce motion: the peak stays at the\n// top left, where the metal's light falls.\nfloat W = max(Size.x, 1.0);\nfloat H = max(Size.y, 1.0);\nfloat2 p = float2(UV.x * W, (1.0 - UV.y) * H) - float2(W, H) * 0.5;\nfloat R = min(Size.z, min(W, H) * 0.5);\nfloat2 q = abs(p) - (float2(W, H) * 0.5 - R);\nfloat depth = -(length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - R);\nfloat band = saturate(depth + 0.5) * (1.0 - smoothstep(Size.w - 0.5, Size.w + 0.5, depth));\nfloat angle = degrees(atan2(p.x, -p.y));\nangle = angle < 0.0 ? angle + 360.0 : angle;\nfloat turn = frac(angle / 360.0 - Animate * Clock / max(Period, 0.001)) * 360.0;\nfloat stop = 330.0;\nfloat start = stop - Arc;\nfloat peak = stop - 0.387 * Arc;\nfloat light = turn < peak ? smoothstep(start, peak, turn) : 1.0 - smoothstep(peak, stop, turn);\nlight *= step(start, turn) * step(turn, stop);\nColor = Sweep.rgb;\nAlpha = Sweep.a * light * band;\n"
}

