/* The POI Detail Card's CONTAINER (PoiCardSheetView, BlockStackView): the layer, the sheet, its grabber and X, the
   pinned header slot, the scrolling stack, the footer and the rule every block shares. The blocks' own looks are in
   CardParts.uss (parts several families use) and Blocks/<Family>/<Family>.uss; the host adds them after this file.
   Written ONLY with the --ts-* tokens of CardTokens.uss: no literal colour, size or radius here or in C# (_3.1 section 3,
   _3.3). UI Toolkit USS only: no web-CSS gap / cursor / calc (UI Toolkit drops them with a warning). */

/* The full area the sheet rests at the bottom of; lets taps through to the camera view */
.poi-card-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* The sheet: its height is its stop (set by the view), animated between stops */
.poi-card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: var(--ts-surface);
    border-top-left-radius: var(--ts-radius-l);
    border-top-right-radius: var(--ts-radius-l);
    border-top-width: var(--ts-line-width);
    border-top-color: var(--ts-line);
    transition-property: height;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

/* While a finger drags the sheet it follows the finger, no animation */
.poi-card--dragging {
    transition-duration: 0s;
}

/* The grab zone at the top: a full-width, finger-sized drag target with a small bar in its middle */
.poi-card__handle {
    flex-shrink: 0;
    height: var(--ts-space-5);
    align-items: center;
    justify-content: center;
}

.poi-card__grabber {
    width: var(--ts-grabber-width);
    height: var(--ts-grabber-height);
    border-radius: var(--ts-grabber-height);
    background-color: var(--ts-ink-3);
}

.poi-card__close {
    position: absolute;
    top: var(--ts-space-2);
    right: var(--ts-space-2);
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    background-color: var(--ts-surface-2);
    border-color: var(--ts-line);
    border-width: var(--ts-line-width);
    border-radius: var(--ts-touch-target);
}

/* The X: two bars crossed at the button's centre (no text glyph, so no visitor string) */
.poi-card__close-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--ts-icon-size);
    height: var(--ts-icon-stroke);
    translate: -50% -50%;
    background-color: var(--ts-ink);
}

.poi-card__close-bar--a {
    rotate: 45deg;
}

.poi-card__close-bar--b {
    rotate: -45deg;
}

/* The pinned header slot (never scrolls) and the scrolling rest of the stack */
.poi-card__header {
    flex-shrink: 0;
    padding-left: var(--ts-space-4);
    padding-right: var(--ts-space-6);
}

.poi-card__stack {
    flex-grow: 1;
    flex-shrink: 1;
    /* the scroll gives up its space first, so a pinned footer stays inside the card at every stop */
    min-height: 0;
}

/* ---- every content block ---- */

.card-block {
    margin: 0 var(--ts-space-4);
}

/* One block's place in the stack (BlockStackView): its heading, the block, and under it the ONE gap between blocks.
   Blocks have no bottom margin of their own, so every gap is this token. */
.card-block-slot {
    margin-bottom: var(--ts-block-gap);
}

/* The common heading every kind may have (BlockKindDefinition.HeadingField): one look for every block */
.card-block-heading {
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0 var(--ts-space-4) var(--ts-space-2) var(--ts-space-4);
    padding: 0;
}

.card-block-heading--empty {
    display: none;
}

/* In the pinned header the heading is a small kicker above the title (the slot already pads the sides), and the
   collapsed header gives it up with the subtitle; the header and the footer keep their own spacing */
.poi-card__header .card-block-heading {
    font-size: var(--ts-size-caption);
    color: var(--ts-accent-text);
    margin: 0 0 var(--ts-space-1) 0;
}

.poi-card__header--collapsed .card-block-heading {
    display: none;
}

.poi-card__header .card-block-slot,
.poi-card__footer .card-block-slot {
    margin-bottom: 0;
}

/* ---- the footer: pinned under the scrolling blocks (sticky actions) ---- */

.poi-card__footer {
    flex-shrink: 0;
}
