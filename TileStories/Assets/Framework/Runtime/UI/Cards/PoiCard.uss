/* The POI Detail Card's CONTAINER (PoiCardSheetView, BlockStackView): the layer, the sheet, its grabber and X, the
   pinned header slot, the scrolling stack, the footer and the rule every block shares. The blocks' own looks are in
   CardParts.uss (parts several families use) and Blocks/<Family>/<Family>.uss; the host adds them after this file.
   Written ONLY with the --ts-* tokens of CardTokens.uss: no literal colour, size or radius here or in C# (_3.1 section 3,
   _3.3). UI Toolkit USS only: no web-CSS gap / cursor / calc (UI Toolkit drops them with a warning). */

/* The full area the sheet rests at the bottom of; lets taps through to the camera view */
.poi-card-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* The sheet: its height is its stop (set by the view), animated between stops */
.poi-card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    background-color: var(--ts-surface);
    border-top-left-radius: var(--ts-radius-l);
    border-top-right-radius: var(--ts-radius-l);
    border-top-width: var(--ts-line-width);
    border-top-color: var(--ts-line);
    transition-property: height;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

/* While a finger drags the sheet it follows the finger, no animation */
.poi-card--dragging {
    transition-duration: 0s;
}

/* The grab zone at the top: a full-width, finger-sized drag target with a small bar in its middle */
.poi-card__handle {
    flex-shrink: 0;
    height: var(--ts-space-5);
    align-items: center;
    justify-content: center;
}

.poi-card__grabber {
    width: var(--ts-grabber-width);
    height: var(--ts-grabber-height);
    border-radius: var(--ts-grabber-height);
    background-color: var(--ts-ink-3);
}

.poi-card__close {
    position: absolute;
    top: var(--ts-space-2);
    right: var(--ts-space-2);
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    background-color: var(--ts-surface-2);
    border-color: var(--ts-line);
    border-width: var(--ts-line-width);
    border-radius: var(--ts-touch-target);
}

/* The language chip: the same round button as the X, left of it; its text is the code of the language a tap switches to */
.poi-card__language {
    position: absolute;
    top: var(--ts-space-2);
    right: var(--ts-language-chip-right);
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink);
    background-color: var(--ts-surface-2);
    border-color: var(--ts-line);
    border-width: var(--ts-line-width);
    border-radius: var(--ts-touch-target);
}

/* With the chip the header's end stays clear of it, so a long title wraps before the chip, not under it */
.poi-card--has-language .poi-card__header {
    padding-right: var(--ts-header-end-with-language);
}

/* The menu button (_3.2 step 8): the same round button as the X, left of it -- or left of the language chip -- with three bars; it is
   there only while the card has a Menu */
.poi-card__menu-button {
    position: absolute;
    top: var(--ts-space-2);
    right: var(--ts-menu-button-right);
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--ts-surface-2);
    border-color: var(--ts-line);
    border-width: var(--ts-line-width);
    border-radius: var(--ts-touch-target);
}

.poi-card--has-language .poi-card__menu-button {
    right: var(--ts-menu-button-right-with-language);
}

.poi-card--has-menu .poi-card__header {
    padding-right: var(--ts-header-end-with-menu);
}

.poi-card--has-menu.poi-card--has-language .poi-card__header {
    padding-right: var(--ts-header-end-with-language-and-menu);
}

/* The X: two bars crossed at the button's centre (no text glyph, so no visitor string) */
.poi-card__close-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--ts-icon-size);
    height: var(--ts-icon-stroke);
    translate: -50% -50%;
    background-color: var(--ts-ink);
}

.poi-card__close-bar--a {
    rotate: 45deg;
}

.poi-card__close-bar--b {
    rotate: -45deg;
}

/* The pinned header slot (never scrolls) and the scrolling rest of the stack */
.poi-card__header {
    flex-shrink: 0;
    padding-left: var(--ts-space-4);
    padding-right: var(--ts-space-6);
}

/* Blocks pinned right under the header (BlockKindDefinition.PinnedTopVariants: the audio hero chip): they never scroll and count in
   the peek stop; the header's collapse cannot cut them (they sit outside the header slot); a small gap under them, not the block gap */
.poi-card__pinned-top {
    flex-shrink: 0;
}

.poi-card__pinned-top .card-block-slot {
    padding-top: var(--ts-space-2);
    margin-bottom: var(--ts-space-2);
}

/* the collapsed (scrolled-past) header gives up everything but its one-line title, the pinned block with it */
.poi-card__header--collapsed .poi-card__pinned-top {
    display: none;
}

/* The mini-player on the wall (MiniPlayerView): a small bar at the bottom while audio started in a card plays on after it closed --
   a round play / pause button and, tappable, the audio's title and time (a tap reopens its card), a stop button (9A-fix: ends the
   audio and sends the bar away), a thin progress line under them */
.poi-card-mini {
    position: absolute;
    left: var(--ts-space-4);
    right: var(--ts-space-4);
    bottom: var(--ts-mini-bottom);
    max-width: var(--ts-mini-max-width);
    flex-direction: row;
    align-items: center;
    padding: var(--ts-space-1);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface);
}

.poi-card-mini__play {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-accent);
}

.poi-card-mini__stop {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0 0 0 var(--ts-space-1);
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-clear);
}

/* the audio glyph is dark ink for the accent play button; on the bar's own surface the stop square needs the bar's ink */
.poi-card-mini__stop .card-audio__glyph {
    color: var(--ts-ink);
}

.poi-card-mini__open {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: var(--ts-touch-target);
    margin: 0 0 0 var(--ts-space-2);
    padding: 0 var(--ts-space-3);
    align-items: flex-start;
    justify-content: center;
    border-width: 0;
    background-color: var(--ts-clear);
}

.poi-card-mini__title {
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}

.poi-card-mini__time {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    margin: 0;
    padding: 0;
}

.poi-card-mini__bar {
    position: absolute;
    left: var(--ts-space-4);
    right: var(--ts-space-4);
    bottom: 0;
    height: var(--ts-audio-track);
    border-radius: var(--ts-audio-track);
    background-color: var(--ts-ink-3);
}

/* The floating slot (FloatingSlot, _3.2 step 9): a row in the card layer just above the sheet's top-right edge at every stop -- the
   placed-model chip, then the Floating Button element at the right end. Its bottom is set by the view (FloatingSlotRule) */
.poi-card-floating {
    position: absolute;
    left: var(--ts-space-4);
    right: var(--ts-space-4);
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.poi-card-floating__element {
    flex-shrink: 0;
    margin-left: var(--ts-space-2);
}

/* The placed-model chip (PlacedModelChipView): a dark pill with a light edge (it floats over the camera image, bright or dark) -- its words,
   and on the card that placed the model an outlined Remove. Its words wrap to a second line rather than being cut */
.poi-card-chip {
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 var(--ts-space-1);
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface);
}

.poi-card-chip__words {
    flex-shrink: 1;
    min-width: 0;
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-2);
    align-items: flex-start;
    justify-content: center;
    border-width: 0;
    background-color: var(--ts-clear);
}

.poi-card-chip__text {
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* on another point's card the words open the card that placed the model: they read as a link (accent words) */
.poi-card-chip__words--link .poi-card-chip__text {
    color: var(--ts-accent-text);
}

.poi-card-chip__remove {
    flex-shrink: 0;
    min-width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-3);
    align-items: center;
    justify-content: center;
    border-width: var(--ts-line-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-clear);
}

.poi-card-chip__remove-label {
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink);
    margin: 0;
    padding: 0;
}

.poi-card-mini__fill {
    width: 0;
    height: var(--ts-audio-track);
    border-radius: var(--ts-audio-track);
    background-color: var(--ts-accent);
}

/* The top navigation slot (_3.2 step 5a, NavSlots): between the header and the stack, never scrolling; opaque, with a line under it so
   the blocks scrolling past read as passing under it. Its element's own look is Navigation.uss */
.poi-card__nav-top {
    flex-shrink: 0;
    background-color: var(--ts-surface);
    border-bottom-width: var(--ts-line-width);
    border-color: var(--ts-line);
}

/* The strip hidden by CardChromeRule (CardChromeView): out of the flow, so the stack gets its room, but still laid out, so its height
   stays known for the next decision */
.poi-card__nav-top--hidden {
    position: absolute;
    left: 0;
    right: 0;
    visibility: hidden;
}

/* Under a shown strip the first block keeps a gap below the hairline (without it its heading sat ~4 px under the line, _3.2 step 6).
   The gap scrolls with the content, so a block a jump lands on sits flush like any block scrolled to the top; CardChromeView sets
   the class and reads the blocks' height without it */
.poi-card--nav-top-shown .poi-card__stack .unity-scroll-view__content-container {
    padding-top: var(--ts-space-3);
}

.poi-card__stack {
    flex-grow: 1;
    flex-shrink: 1;
    /* the scroll gives up its space first, so a pinned footer stays inside the card at every stop */
    min-height: 0;
}

/* ---- every content block ---- */

.card-block {
    margin: 0 var(--ts-space-4);
}

/* One block's place in the stack (BlockStackView): its heading, the block, and under it the ONE gap between blocks.
   Blocks have no bottom margin of their own, so every gap is this token. */
.card-block-slot {
    margin-bottom: var(--ts-block-gap);
}

/* The common heading every kind may have (BlockKindDefinition.HeadingField): one look for every block */
.card-block-heading {
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0 var(--ts-space-4) var(--ts-space-2) var(--ts-space-4);
    padding: 0;
}

.card-block-heading--empty {
    display: none;
}

/* In the pinned header the heading is a small kicker above the title (the slot already pads the sides), and the
   collapsed header gives it up with the subtitle; the header and the footer keep their own spacing */
.poi-card__header .card-block-heading {
    font-size: var(--ts-size-caption);
    color: var(--ts-accent-text);
    margin: 0 0 var(--ts-space-1) 0;
}

/* a block PINNED under the header (the audio hero chip, inside .poi-card__header since Bind() sits it between the title/chip and
   the subtitle) keeps the stack's ordinary heading look, not the header's own small kicker: same specificity as the rule above,
   later in the file wins */
.poi-card__pinned-top .card-block-heading {
    font-size: var(--ts-size-heading);
    color: var(--ts-ink);
    margin: 0 var(--ts-space-4) var(--ts-space-2) var(--ts-space-4);
}

.poi-card__header--collapsed .card-block-heading {
    display: none;
}

/* the one-line collapsed header sits on a hairline, so its title never reads as the next block's heading */
.poi-card__header--collapsed {
    padding-bottom: var(--ts-space-2);
    border-bottom-width: var(--ts-line-width);
    border-bottom-color: var(--ts-line);
}

.poi-card__header .card-block-slot,
.poi-card__footer .card-block-slot {
    margin-bottom: 0;
}

/* ---- the bottom area (_3.2 step 7a, PoiCardSheetView.BottomArea): under the scrolling blocks, the footer (sticky actions) and under it
   the bottom navigation slot -- ONE part of the chrome, which slides as one ---- */

.poi-card__bottom {
    flex-shrink: 0;
    transition-property: translate;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

.poi-card__footer {
    flex-shrink: 0;
}

/* The bottom navigation slot (NavSlots): opaque, with a line above it so the content never reads as running into the bar. Its element's
   own look is Navigation.uss */
.poi-card__nav-bottom {
    flex-shrink: 0;
    background-color: var(--ts-surface);
    border-top-width: var(--ts-line-width);
    border-color: var(--ts-line);
}

/* The edge slot's host (NavSlots, step 10): INSIDE the stack's viewport, absolute over its right edge, one touch target wide -- so its box
   is exactly what the visitor can scroll and it takes no room in the flow. It never takes a finger itself (NavSlots), its element does */
.poi-card__nav-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: var(--ts-touch-target);
}

/* The bottom area hidden by CardChromeRule (CardChromeView: at peek, while the reader moves down, where the stop has no room for it):
   out of the flow -- the stack takes its room at once -- and slid below the sheet's bottom edge, which clips it (.poi-card overflow) */
.poi-card__bottom--hidden {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    translate: 0 100%;
}

/* The bar alone hidden inside a shown area (Show Navigation At = Full Only, at Half): out of the flow but still laid out, like the strip */
.poi-card__nav-bottom--hidden {
    position: absolute;
    left: 0;
    right: 0;
    visibility: hidden;
}

/* Reduce motion: the bottom area jumps */
.poi-card--chrome-instant .poi-card__bottom {
    transition-duration: 0s;
}
