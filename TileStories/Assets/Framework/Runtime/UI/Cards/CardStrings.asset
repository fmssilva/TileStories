%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52d504d26bc89b84a83c73539d09f70b, type: 3}
  m_Name: CardStrings
  m_EditorClassIdentifier: TileStories::TileStories.CardStringTable
  rows:
  - key: close
    where: The name of the round close button at the top right of the card (read
      by screen readers and shown as its tooltip).
    text:
    - lang: en
      value: Close
    - lang: pt
      value: Fechar
  - key: fun_fact_label
    where: The small heading above every fact of a Fun Fact block.
    text:
    - lang: en
      value: Did you know?
    - lang: pt
      value: Sabia que?
  - key: fun_fact_hint
    where: The line a Fun Fact card in the Flip look shows until the visitor taps
      it.
    text:
    - lang: en
      value: Tap to reveal
    - lang: pt
      value: Toque para ver
  - key: status_heading
    where: The small heading above the condition in a Status block.
    text:
    - lang: en
      value: Condition
    - lang: pt
      value: Estado
  - key: status_unknown_mark
    where: The mark inside the outline of a Status block when nobody assessed the
      condition.
    text:
    - lang: en
      value: '?'
    - lang: pt
      value: '?'
  - key: status_unknown
    where: The condition's name in a Status block when nobody assessed it and the
      wall's outline types have no row to name it.
    text:
    - lang: en
      value: Not assessed
    - lang: pt
      value: "N\xE3o avaliado"
  - key: status_percent
    where: The condition's name in a Status block when the wall's outline types do
      not name it; {0} is the damage percentage.
    text:
    - lang: en
      value: '{0}% damaged'
    - lang: pt
      value: '{0}% danificado'
  - key: sources_heading
    where: The heading of a Sources block.
    text:
    - lang: en
      value: Sources
    - lang: pt
      value: Fontes
  - key: sources_verified
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Verified.
    text:
    - lang: en
      value: Verified
    - lang: pt
      value: Verificado
  - key: sources_draft
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Draft.
    text:
    - lang: en
      value: Draft
    - lang: pt
      value: Rascunho
  - key: timeline_now
    where: The end point a Timeline block adds after its last event while Highlight
      Now is on.
    text:
    - lang: en
      value: Now
    - lang: pt
      value: Hoje
  - key: story_chapter_of
    where: The line above a Story Chapters chapter, where {0} is the chapter shown
      and {1} how many there are.
    text:
    - lang: en
      value: Chapter {0} of {1}
    - lang: pt
      value: "Cap\xEDtulo {0} de {1}"
  - key: story_previous
    where: The button of a Story Chapters block that goes back one chapter.
    text:
    - lang: en
      value: Previous
    - lang: pt
      value: Anterior
  - key: story_next
    where: The button of a Story Chapters block that goes on to the next chapter.
    text:
    - lang: en
      value: Next
    - lang: pt
      value: Seguinte
  - key: compare_heading
    where: The small heading of a Compare Points block, above the two points' conditions
      side by side.
    text:
    - lang: en
      value: Side by side
    - lang: pt
      value: Lado a lado
  - key: media_unavailable
    where: The frame of a picture whose file cannot be shown (missing, or not a picture
      the card may use).
    text:
    - lang: en
      value: Picture unavailable
    - lang: pt
      value: "Imagem indispon\xEDvel"
  - key: header_then
    where: The label on the left half of a Then and Now header picture.
    text:
    - lang: en
      value: Then
    - lang: pt
      value: Antes
  - key: header_now
    where: The label on the right half of a Then and Now header picture.
    text:
    - lang: en
      value: Now
    - lang: pt
      value: Hoje
  - key: before_label
    where: The label of the left side of a Before and After slider when the block
      names none.
    text:
    - lang: en
      value: Before
    - lang: pt
      value: Antes
  - key: after_label
    where: The label of the right side of a Before and After slider when the block
      names none.
    text:
    - lang: en
      value: After
    - lang: pt
      value: Depois
  - key: gallery_name
    where: A gallery's name in the breadcrumb of the full-screen picture view (card
      title > this).
    text:
    - lang: en
      value: Gallery
    - lang: pt
      value: Galeria
  - key: gallery_count
    where: 'Under a stacked gallery: how many pictures it holds ({0} = the number).'
    text:
    - lang: en
      value: '{0} pictures'
    - lang: pt
      value: '{0} imagens'
  - key: takeover_back
    where: The button of the full-screen view that goes back to the card.
    text:
    - lang: en
      value: Back
    - lang: pt
      value: Voltar
  - key: zoom_hint
    where: The hint under a Zoom Image picture.
    text:
    - lang: en
      value: Pinch to zoom in
    - lang: pt
      value: Afaste os dedos para ampliar
  - key: hotspot_hint
    where: The hint under a Hotspot Image picture (a tap on a spot opens its text).
    text:
    - lang: en
      value: Tap a spot to read about it
    - lang: pt
      value: Toque num ponto para saber mais
  - key: wall_locator_heading
    where: The title over a Wall Locator block when its Heading is empty.
    text:
    - lang: en
      value: On this wall
    - lang: pt
      value: Nesta parede
  - key: wall_locator_you
    where: 'Wall Locator, Strip: the mark of the visitor''s own place along the wall
      (in the app).'
    text:
    - lang: en
      value: You are here
    - lang: pt
      value: "Est\xE1 aqui"
  - key: today_map_heading
    where: The title over a Today Map block when its Heading is empty.
    text:
    - lang: en
      value: Where it is today
    - lang: pt
      value: Onde fica hoje
  - key: today_map_directions
    where: 'Today Map: the button that opens the Maps Link.'
    text:
    - lang: en
      value: Directions
    - lang: pt
      value: Como chegar
  - key: today_map_then
    where: 'Today Map, Bridge: the word over the point as the wall shows it.'
    text:
    - lang: en
      value: On the wall
    - lang: pt
      value: Na parede
  - key: today_map_now
    where: 'Today Map, Bridge: the word over the map of where it is now.'
    text:
    - lang: en
      value: Today
    - lang: pt
      value: Hoje
  - key: today_map_coordinates
    where: 'Today Map: how the latitude ({0}) and longitude ({1}) are written under
      the map.'
    text:
    - lang: en
      value: '{0}, {1}'
    - lang: pt
      value: '{0}, {1}'
  - key: related_heading
    where: The title over a Related block when its Heading is empty.
    text:
    - lang: en
      value: Related
    - lang: pt
      value: Relacionado
  - key: knowledge_check_heading
    where: The default heading of a Knowledge Check block, when its own Heading is
      empty.
    text:
    - lang: en
      value: Test yourself
    - lang: pt
      value: Teste-se
  - key: knowledge_question_of
    where: Above a question when a Knowledge Check has more than one ({0} = this
      question, {1} = how many).
    text:
    - lang: en
      value: Question {0} of {1}
    - lang: pt
      value: Pergunta {0} de {1}
  - key: knowledge_correct
    where: The line shown after a right answer, before the explanation.
    text:
    - lang: en
      value: Correct!
    - lang: pt
      value: Certo!
  - key: knowledge_wrong
    where: The gentle line shown after a wrong answer, before the explanation.
    text:
    - lang: en
      value: Actually...
    - lang: pt
      value: Na verdade...
  - key: knowledge_true
    where: The button that answers a true / false statement with True.
    text:
    - lang: en
      value: True
    - lang: pt
      value: Verdadeiro
  - key: knowledge_false
    where: The button that answers a true / false statement with False.
    text:
    - lang: en
      value: False
    - lang: pt
      value: Falso
  - key: knowledge_swipe_hint
    where: 'The hint under a true / false statement: which way to swipe.'
    text:
    - lang: en
      value: Swipe right for true, left for false
    - lang: pt
      value: Deslize para a direita se for verdadeiro, para a esquerda se for falso
  - key: knowledge_previous
    where: The button under a Knowledge Check with several questions that goes back
      one question.
    text:
    - lang: en
      value: Previous question
    - lang: pt
      value: Pergunta anterior
  - key: knowledge_next
    where: The button under a Knowledge Check with several questions that goes on
      to the next question.
    text:
    - lang: en
      value: Next question
    - lang: pt
      value: Pergunta seguinte
  - key: feedback_thumbs_question
    where: The question of a Feedback block with the Thumbs look, when the block
      writes none.
    text:
    - lang: en
      value: Was this useful?
    - lang: pt
      value: "Foi \xFAtil?"
  - key: feedback_stars_question
    where: The question of a Feedback block with the Stars look, when the block writes
      none.
    text:
    - lang: en
      value: How would you rate this?
    - lang: pt
      value: Como avalia isto?
  - key: feedback_thumb_up
    where: The words under the thumb up of a Feedback block.
    text:
    - lang: en
      value: Helpful
    - lang: pt
      value: "\xDAtil"
  - key: feedback_thumb_down
    where: The words under the thumb down of a Feedback block.
    text:
    - lang: en
      value: Not helpful
    - lang: pt
      value: "Pouco \xFAtil"
  - key: feedback_star
    where: 'The name of one star of a Feedback block ({0} = which star, {1} = how
      many stars): its tooltip.'
    text:
    - lang: en
      value: '{0} of {1} stars'
    - lang: pt
      value: '{0} de {1} estrelas'
  - key: feedback_thanks
    where: The thank-you a Feedback block shows once the visitor has voted.
    text:
    - lang: en
      value: Thank you for your feedback
    - lang: pt
      value: "Obrigado pelo seu coment\xE1rio"
  - key: poll_your_choice
    where: The caption on the option the visitor picked in a Poll block.
    text:
    - lang: en
      value: Your choice
    - lang: pt
      value: A sua escolha
  - key: poll_thanks
    where: The thank-you a Poll block shows once the visitor has voted.
    text:
    - lang: en
      value: Thank you for voting
    - lang: pt
      value: Obrigado pelo seu voto
  - key: poll_percent
    where: 'The share of the votes an option got, when results exist ({0} = the percentage):
      a Poll block only shows it when the app has results to show.'
    text:
    - lang: en
      value: '{0}%'
    - lang: pt
      value: '{0}%'
  - key: collect_heading
    where: The default heading of a Collect block, when the block names none.
    text:
    - lang: en
      value: Your story
    - lang: pt
      value: "A sua hist\xF3ria"
  - key: collect_add
    where: The button of a Collect block that adds this point's item to the visitor's
      story.
    text:
    - lang: en
      value: Add to my story
    - lang: pt
      value: "Adicionar \xE0 minha hist\xF3ria"
  - key: collect_collected
    where: The words of a Collect block's button once the item is in the visitor's
      story.
    text:
    - lang: en
      value: In your story
    - lang: pt
      value: "Na sua hist\xF3ria"
  - key: collect_progress
    where: How many of this wall's collectable items the visitor has ({0} = theirs,
      {1} = all of the wall's).
    text:
    - lang: en
      value: '{0} of {1} collected'
    - lang: pt
      value: '{0} de {1} recolhidos'
  - key: dialogue_continue
    where: The button of a Dialogue block that shows the next line.
    text:
    - lang: en
      value: Continue
    - lang: pt
      value: Continuar
  - key: dialogue_again
    where: The button of a Dialogue block that starts the conversation over once
      it has ended.
    text:
    - lang: en
      value: Start again
    - lang: pt
      value: "Recome\xE7ar"
  - key: dialogue_you
    where: The name shown on the visitor's own reply in a Dialogue block.
    text:
    - lang: en
      value: You
    - lang: pt
      value: "Voc\xEA"
  - key: show_on_wall_button
    where: The button of a Show On Wall block, which lowers the card so the point's
      marker shows on the wall; also an Actions button of that action with no words
      of its own.
    text:
    - lang: en
      value: Show me where it is
    - lang: pt
      value: Mostra-me onde fica
  - key: show_on_wall_nearby
    where: The caption over the neighbouring points of a Show On Wall block in the
      With Neighbours look.
    text:
    - lang: en
      value: Also nearby
    - lang: pt
      value: "Tamb\xE9m perto"
  - key: open_block_button
    where: An Actions button that opens another block of the same card, when the
      button has no words of its own and the block it opens has no heading.
    text:
    - lang: en
      value: Go to this part
    - lang: pt
      value: Ir para esta parte
  - key: audio_play
    where: The play button's name (its tooltip and accessible name) on an Audio Guide,
      on the small player on the wall and on a Video.
    text:
    - lang: en
      value: Play
    - lang: pt
      value: Reproduzir
  - key: audio_pause
    where: The same button's name while the audio or the video plays.
    text:
    - lang: en
      value: Pause
    - lang: pt
      value: Pausar
  - key: audio_speed
    where: The name of the speed chip of an Audio Guide (its own text is the speed,
      like 1.5x).
    text:
    - lang: en
      value: Playback speed
    - lang: pt
      value: "Velocidade de reprodu\xE7\xE3o"
  - key: audio_captions
    where: 'The captions switch of an Audio Guide player and of a Video: its words and
      its name.'
    text:
    - lang: en
      value: Captions
    - lang: pt
      value: Legendas
  - key: audio_seek
    where: The name of the bar an Audio Guide player or a Video is dragged along to
      move through the recording.
    text:
    - lang: en
      value: Position in the audio
    - lang: pt
      value: "Posi\xE7\xE3o no \xE1udio"
  - key: audio_queued
    where: 'Under the title of an Audio Guide whose audio waits its turn (Card Container
      > When Another Audio Starts: Queue The New One).'
    text:
    - lang: en
      value: Up next
    - lang: pt
      value: A seguir
  - key: audio_unavailable
    where: Under the title of an Audio Guide whose file cannot be loaded (missing,
      or not a sound Unity can read).
    text:
    - lang: en
      value: Audio unavailable
    - lang: pt
      value: "\xC1udio indispon\xEDvel"
  - key: mini_player_open
    where: 'The name of the small player''s title on the wall: a tap shows the card
      of the audio again.'
    text:
    - lang: en
      value: Open the card
    - lang: pt
      value: "Abrir o cart\xE3o"
  - key: mini_player_stop
    where: The name of the small player's stop button on the wall; tapping it ends
      the audio and sends the mini-player away.
    text:
    - lang: en
      value: Stop
    - lang: pt
      value: Parar
  - key: video_full_screen
    where: The name of a Video's full-screen button (its tooltip and accessible name),
      and the words over a Video shown as a teaser that opens full screen.
    text:
    - lang: en
      value: Full screen
    - lang: pt
      value: "Ecr\xE3 inteiro"
  - key: video_unavailable
    where: The words a Video shows instead of playing when its clip cannot be loaded.
    text:
    - lang: en
      value: Video unavailable
    - lang: pt
      value: "V\xEDdeo indispon\xEDvel"
  - key: video_chapters
    where: The name of a Video's row of chapter buttons (read by screen readers); each
      button shows its chapter's time and name.
    text:
    - lang: en
      value: Chapters
    - lang: pt
      value: "Cap\xEDtulos"
  - key: model_3d_hint
    where: The hint under a 3D Model turntable.
    text:
    - lang: en
      value: Drag to rotate, pinch to zoom
    - lang: pt
      value: "Arraste para rodar, afaste os dedos para ampliar"
  - key: model_3d_loading
    where: The words a 3D Model turntable shows while its model is still loading.
    text:
    - lang: en
      value: Loading...
    - lang: pt
      value: "A carregar..."
  - key: panorama_360_drag_hint
    where: The hint under a 360 Panorama viewer that turns by dragging.
    text:
    - lang: en
      value: Drag to look around, pinch to zoom
    - lang: pt
      value: "Arraste para olhar à volta, afaste os dedos para ampliar"
  - key: panorama_360_gyro_hint
    where: The hint under a 360 Panorama viewer that follows the phone's own movement.
    text:
    - lang: en
      value: Move your phone to look around
    - lang: pt
      value: "Mova o telemóvel para olhar à volta"
  - key: panorama_360_loading
    where: The words a 360 Panorama viewer shows while its picture is still loading.
    text:
    - lang: en
      value: Loading...
    - lang: pt
      value: "A carregar..."
  - key: place_in_ar_button
    where: The button of a Place In AR block, which places its 3D model in the room at
      the point and lowers the card.
    text:
    - lang: en
      value: See it here in 3D
    - lang: pt
      value: Ver aqui em 3D
  - key: place_in_ar_remove
    where: The button of a Place In AR block while its model stands in the room; a tap
      takes the model away and the button goes back to placing it.
    text:
    - lang: en
      value: Remove from room
    - lang: pt
      value: Remover da sala
  - key: place_in_ar_placed
    where: The line under a Place In AR block's button while its model stands in the
      room.
    text:
    - lang: en
      value: Placed by the wall
    - lang: pt
      value: "Colocado junto à parede"
  - key: place_in_ar_not_localised
    where: The line under a Place In AR block's button while the wall is not found yet
      (the button is disabled).
    text:
    - lang: en
      value: Point the camera at the wall first, then place it.
    - lang: pt
      value: "Aponta primeiro a câmara para a parede e depois coloca-o."
  - key: language_switch
    where: The name of the small language chip beside the close button (its tooltip and
      accessible name; the chip itself shows the code of the language a tap switches to).
      The chip is hidden when the wall offers only one language.
    text:
    - lang: en
      value: Language
    - lang: pt
      value: Idioma
  - key: family_about
    where: The words a visitor reads for the About family, which holds the description of
      the point itself, its facts and its quotes. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: About
    - lang: pt
      value: Sobre
  - key: family_media
    where: The words a visitor reads for the Media family, which holds pictures, video, 3D
      models and panoramas. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: Media
    - lang: pt
      value: Média
  - key: family_guides
    where: The words a visitor reads for the Guides family. It reads Listen because the
      family holds the audio guide. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: Listen
    - lang: pt
      value: Ouvir
  - key: family_stories
    where: The words a visitor reads for the Stories family, which holds timelines, people,
      chapters and dialogues. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: Stories
    - lang: pt
      value: Histórias
  - key: family_ar
    where: The words a visitor reads for the AR family, whose blocks show something on the
      real wall or place a model in the room. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: In AR
    - lang: pt
      value: Em RA
  - key: family_play
    where: The words a visitor reads for the Play family, which holds questions, polls and
      collectables. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: Play
    - lang: pt
      value: Jogar
  - key: family_visit
    where: The words a visitor reads for the Visit family, which holds opening times, where
      to find things and nearby points. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: Visit
    - lang: pt
      value: Visitar
  - key: family_community
    where: The words a visitor reads for the Community family, which holds what a visitor
      sends back. A navigation element shows it as the name of that section.
    text:
    - lang: en
      value: Community
    - lang: pt
      value: Comunidade
  - key: family_navigation
    where: The name of the Navigation family, which holds the blocks that move the visitor inside
      the card (an icon grid of its sections). It is never a section of the card's own navigation.
    text:
    - lang: en
      value: Navigation
    - lang: pt
      value: Navegação
  - key: family_meta
    where: The words a visitor reads for the Sources family, which says where the content
      came from. These blocks close the card, so it is also what a contents list calls its last section.
    text:
    - lang: en
      value: Sources
    - lang: pt
      value: Fontes
  - key: format_read
    where: The words a visitor reads for the Read format, blocks of text to read (the description, facts, quotes, a timeline). A navigation element shows it as the name of that section when the card is grouped by format.
    text:
    - lang: en
      value: Read
    - lang: pt
      value: Ler
  - key: format_look
    where: The words a visitor reads for the Look format, blocks whose picture or drawing is the content (galleries, zoomable pictures, maps). A navigation element shows it as the name of that section when the card is grouped by format.
    text:
    - lang: en
      value: Look
    - lang: pt
      value: Ver
  - key: format_watch
    where: The words a visitor reads for the Watch format, the video blocks. A navigation element shows it as the name of that section when the card is grouped by format.
    text:
    - lang: en
      value: Watch
    - lang: pt
      value: Assistir
  - key: format_listen
    where: The words a visitor reads for the Listen format, the audio guides. A navigation element shows it as the name of that section when the card is grouped by format.
    text:
    - lang: en
      value: Listen
    - lang: pt
      value: Ouvir
  - key: format_model
    where: The words a visitor reads for the Immersive format, 3D models, 360 panoramas and what is shown in the room or on the wall. A navigation element shows it as the name of that section when the card is grouped by format.
    text:
    - lang: en
      value: Immersive
    - lang: pt
      value: Imersivo
  - key: format_interact
    where: The words a visitor reads for the Interact format, blocks where the visitor does something (questions, polls, feedback, buttons). A navigation element shows it as the name of that section when the card is grouped by format.
    text:
    - lang: en
      value: Interact
    - lang: pt
      value: Interagir
  - key: kind_header
    where: The name of the title block at the top of the card as one kind of block. A chip of the Kind Chips or Icon Tabs With Chips navigation shows it.
    text:
    - lang: en
      value: Title
    - lang: pt
      value: Título
  - key: kind_status
    where: The name of the block showing the state the point is in as one kind of block. A chip of the Kind Chips or Icon Tabs With Chips navigation shows it.
    text:
    - lang: en
      value: Condition
    - lang: pt
      value: Estado
  - key: kind_quick_facts
    where: The name of the short facts block as one kind of block. A chip of the Kind Chips or Icon Tabs With Chips navigation shows it.
    text:
    - lang: en
      value: Quick facts
    - lang: pt
      value: Factos rápidos
  - key: kind_rich_text
    where: The name of a block of written text as one kind of block. A chip of the Kind Chips or Icon Tabs With Chips navigation shows it.
    text:
    - lang: en
      value: Text
    - lang: pt
      value: Texto
  - key: kind_fun_fact
