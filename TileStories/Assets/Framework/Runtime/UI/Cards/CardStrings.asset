%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52d504d26bc89b84a83c73539d09f70b, type: 3}
  m_Name: CardStrings
  m_EditorClassIdentifier: TileStories::TileStories.CardStringTable
  rows:
  - key: close
    where: The name of the round close button at the top right of the card (read
      by screen readers and shown as its tooltip).
    text:
    - lang: en
      value: Close
    - lang: pt
      value: Fechar
  - key: fun_fact_label
    where: The small heading above every fact of a Fun Fact block.
    text:
    - lang: en
      value: Did you know?
    - lang: pt
      value: Sabia que?
  - key: fun_fact_hint
    where: The line a Fun Fact card in the Flip look shows until the visitor taps
      it.
    text:
    - lang: en
      value: Tap to reveal
    - lang: pt
      value: Toque para ver
  - key: status_heading
    where: The small heading above the condition in a Status block.
    text:
    - lang: en
      value: Condition
    - lang: pt
      value: Estado
  - key: status_unknown_mark
    where: The mark inside the outline of a Status block when nobody assessed the
      condition.
    text:
    - lang: en
      value: '?'
    - lang: pt
      value: '?'
  - key: status_unknown
    where: The condition's name in a Status block when nobody assessed it and the
      wall's outline types have no row to name it.
    text:
    - lang: en
      value: Not assessed
    - lang: pt
      value: Nao avaliado
  - key: status_percent
    where: The condition's name in a Status block when the wall's outline types do
      not name it; {0} is the damage percentage.
    text:
    - lang: en
      value: '{0}% damaged'
    - lang: pt
      value: '{0}% danificado'
  - key: sources_heading
    where: The heading of a Sources block.
    text:
    - lang: en
      value: Sources
    - lang: pt
      value: Fontes
  - key: sources_verified
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Verified.
    text:
    - lang: en
      value: Verified
    - lang: pt
      value: Verificado
  - key: sources_draft
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Draft.
    text:
    - lang: en
      value: Draft
    - lang: pt
      value: Rascunho
  - key: timeline_now
    where: The end point a Timeline block adds after its last event while Highlight Now is on.
    text:
    - lang: en
      value: Now
    - lang: pt
      value: Hoje
  - key: story_chapter_of
    where: The line above a Story Chapters chapter, where {0} is the chapter shown and {1} how many there are.
    text:
    - lang: en
      value: Chapter {0} of {1}
    - lang: pt
      value: Capitulo {0} de {1}
  - key: story_previous
    where: The button of a Story Chapters block that goes back one chapter.
    text:
    - lang: en
      value: Previous
    - lang: pt
      value: Anterior
  - key: story_next
    where: The button of a Story Chapters block that goes on to the next chapter.
    text:
    - lang: en
      value: Next
    - lang: pt
      value: Seguinte
  - key: compare_heading
    where: The small heading of a Compare Points block, above the two points' conditions side by side.
    text:
    - lang: en
      value: Side by side
    - lang: pt
      value: Lado a lado
  - key: media_unavailable
    where: The frame of a picture whose file cannot be shown (missing, or not a picture the card may use).
    text:
    - lang: en
      value: Picture unavailable
    - lang: pt
      value: Imagem indisponivel
  - key: header_then
    where: The label on the left half of a Then and Now header picture.
    text:
    - lang: en
      value: Then
    - lang: pt
      value: Antes
  - key: header_now
    where: The label on the right half of a Then and Now header picture.
    text:
    - lang: en
      value: Now
    - lang: pt
      value: Hoje
  - key: before_label
    where: The label of the left side of a Before and After slider when the block names none.
    text:
    - lang: en
      value: Before
    - lang: pt
      value: Antes
  - key: after_label
    where: The label of the right side of a Before and After slider when the block names none.
    text:
    - lang: en
      value: After
    - lang: pt
      value: Depois
  - key: gallery_name
    where: A gallery's name in the breadcrumb of the full-screen picture view (card title > this).
    text:
    - lang: en
      value: Gallery
    - lang: pt
      value: Galeria
  - key: gallery_count
    where: 'Under a stacked gallery: how many pictures it holds ({0} = the number).'
    text:
    - lang: en
      value: '{0} pictures'
    - lang: pt
      value: '{0} imagens'
  - key: takeover_back
    where: The button of the full-screen view that goes back to the card.
    text:
    - lang: en
      value: Back
    - lang: pt
      value: Voltar
  - key: zoom_hint
    where: The hint under a Zoom Image picture.
    text:
    - lang: en
      value: Pinch to zoom in
    - lang: pt
      value: Afaste os dedos para ampliar
