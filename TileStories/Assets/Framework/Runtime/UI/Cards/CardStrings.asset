%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52d504d26bc89b84a83c73539d09f70b, type: 3}
  m_Name: CardStrings
  m_EditorClassIdentifier: TileStories::TileStories.CardStringTable
  rows:
  - key: close
    where: The name of the round close button at the top right of the card (read
      by screen readers and shown as its tooltip).
    text:
    - lang: en
      value: Close
    - lang: pt
      value: Fechar
  - key: fun_fact_label
    where: The small heading above every fact of a Fun Fact block.
    text:
    - lang: en
      value: Did you know?
    - lang: pt
      value: Sabia que?
  - key: fun_fact_hint
    where: The line a Fun Fact card in the Flip look shows until the visitor taps
      it.
    text:
    - lang: en
      value: Tap to reveal
    - lang: pt
      value: Toque para ver
  - key: status_heading
    where: The small heading above the condition in a Status block.
    text:
    - lang: en
      value: Condition
    - lang: pt
      value: Estado
  - key: status_unknown_mark
    where: The mark inside the outline of a Status block when nobody assessed the
      condition.
    text:
    - lang: en
      value: '?'
    - lang: pt
      value: '?'
  - key: status_unknown
    where: The condition's name in a Status block when nobody assessed it and the
      wall's outline types have no row to name it.
    text:
    - lang: en
      value: Not assessed
    - lang: pt
      value: Nao avaliado
  - key: status_percent
    where: The condition's name in a Status block when the wall's outline types do
      not name it; {0} is the damage percentage.
    text:
    - lang: en
      value: '{0}% damaged'
    - lang: pt
      value: '{0}% danificado'
  - key: sources_heading
    where: The heading of a Sources block.
    text:
    - lang: en
      value: Sources
    - lang: pt
      value: Fontes
  - key: sources_verified
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Verified.
    text:
    - lang: en
      value: Verified
    - lang: pt
      value: Verificado
  - key: sources_draft
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Draft.
    text:
    - lang: en
      value: Draft
    - lang: pt
      value: Rascunho
  - key: timeline_now
    where: The end point a Timeline block adds after its last event while Highlight
      Now is on.
    text:
    - lang: en
      value: Now
    - lang: pt
      value: Hoje
  - key: story_chapter_of
    where: The line above a Story Chapters chapter, where {0} is the chapter shown
      and {1} how many there are.
    text:
    - lang: en
      value: Chapter {0} of {1}
    - lang: pt
      value: Capitulo {0} de {1}
  - key: story_previous
    where: The button of a Story Chapters block that goes back one chapter.
    text:
    - lang: en
      value: Previous
    - lang: pt
      value: Anterior
  - key: story_next
    where: The button of a Story Chapters block that goes on to the next chapter.
    text:
    - lang: en
      value: Next
    - lang: pt
      value: Seguinte
  - key: compare_heading
    where: The small heading of a Compare Points block, above the two points' conditions
      side by side.
    text:
    - lang: en
      value: Side by side
    - lang: pt
      value: Lado a lado
  - key: media_unavailable
    where: The frame of a picture whose file cannot be shown (missing, or not a picture
      the card may use).
    text:
    - lang: en
      value: Picture unavailable
    - lang: pt
      value: Imagem indisponivel
  - key: header_then
    where: The label on the left half of a Then and Now header picture.
    text:
    - lang: en
      value: Then
    - lang: pt
      value: Antes
  - key: header_now
    where: The label on the right half of a Then and Now header picture.
    text:
    - lang: en
      value: Now
    - lang: pt
      value: Hoje
  - key: before_label
    where: The label of the left side of a Before and After slider when the block
      names none.
    text:
    - lang: en
      value: Before
    - lang: pt
      value: Antes
  - key: after_label
    where: The label of the right side of a Before and After slider when the block
      names none.
    text:
    - lang: en
      value: After
    - lang: pt
      value: Depois
  - key: gallery_name
    where: A gallery's name in the breadcrumb of the full-screen picture view (card
      title > this).
    text:
    - lang: en
      value: Gallery
    - lang: pt
      value: Galeria
  - key: gallery_count
    where: 'Under a stacked gallery: how many pictures it holds ({0} = the number).'
    text:
    - lang: en
      value: '{0} pictures'
    - lang: pt
      value: '{0} imagens'
  - key: takeover_back
    where: The button of the full-screen view that goes back to the card.
    text:
    - lang: en
      value: Back
    - lang: pt
      value: Voltar
  - key: zoom_hint
    where: The hint under a Zoom Image picture.
    text:
    - lang: en
      value: Pinch to zoom in
    - lang: pt
      value: Afaste os dedos para ampliar
  - key: hotspot_hint
    where: The hint under a Hotspot Image picture (a tap on a spot opens its text).
    text:
    - lang: en
      value: Tap a spot to read about it
    - lang: pt
      value: Toque num ponto para saber mais
  - key: wall_locator_heading
    where: The title over a Wall Locator block when its Heading is empty.
    text:
    - lang: en
      value: On this wall
    - lang: pt
      value: Nesta parede
  - key: wall_locator_you
    where: 'Wall Locator, Strip: the mark of the visitor''s own place along the wall
      (in the app).'
    text:
    - lang: en
      value: You are here
    - lang: pt
      value: Esta aqui
  - key: today_map_heading
    where: The title over a Today Map block when its Heading is empty.
    text:
    - lang: en
      value: Where it is today
    - lang: pt
      value: Onde fica hoje
  - key: today_map_directions
    where: 'Today Map: the button that opens the Maps Link.'
    text:
    - lang: en
      value: Directions
    - lang: pt
      value: Como chegar
  - key: today_map_then
    where: 'Today Map, Bridge: the word over the point as the wall shows it.'
    text:
    - lang: en
      value: On the wall
    - lang: pt
      value: Na parede
  - key: today_map_now
    where: 'Today Map, Bridge: the word over the map of where it is now.'
    text:
    - lang: en
      value: Today
    - lang: pt
      value: Hoje
  - key: today_map_coordinates
    where: 'Today Map: how the latitude ({0}) and longitude ({1}) are written under
      the map.'
    text:
    - lang: en
      value: '{0}, {1}'
    - lang: pt
      value: '{0}, {1}'
  - key: related_heading
    where: The title over a Related block when its Heading is empty.
    text:
    - lang: en
      value: Related
    - lang: pt
      value: Relacionado
  - key: knowledge_check_heading
    where: The default heading of a Knowledge Check block, when its own Heading is
      empty.
    text:
    - lang: en
      value: Test yourself
    - lang: pt
      value: Teste-se
  - key: knowledge_question_of
    where: Above a question when a Knowledge Check has more than one ({0} = this
      question, {1} = how many).
    text:
    - lang: en
      value: Question {0} of {1}
    - lang: pt
      value: Pergunta {0} de {1}
  - key: knowledge_correct
    where: The line shown after a right answer, before the explanation.
    text:
    - lang: en
      value: Correct!
    - lang: pt
      value: Certo!
  - key: knowledge_wrong
    where: The gentle line shown after a wrong answer, before the explanation.
    text:
    - lang: en
      value: Actually...
    - lang: pt
      value: Na verdade...
  - key: knowledge_true
    where: The button that answers a true / false statement with True.
    text:
    - lang: en
      value: True
    - lang: pt
      value: Verdadeiro
  - key: knowledge_false
    where: The button that answers a true / false statement with False.
    text:
    - lang: en
      value: False
    - lang: pt
      value: Falso
  - key: knowledge_swipe_hint
    where: 'The hint under a true / false statement: which way to swipe.'
    text:
    - lang: en
      value: Swipe right for true, left for false
    - lang: pt
      value: Deslize para a direita se for verdadeiro, para a esquerda se for falso
  - key: knowledge_previous
    where: The button under a Knowledge Check with several questions that goes back
      one question.
    text:
    - lang: en
      value: Previous question
    - lang: pt
      value: Pergunta anterior
  - key: knowledge_next
    where: The button under a Knowledge Check with several questions that goes on
      to the next question.
    text:
    - lang: en
      value: Next question
    - lang: pt
      value: Pergunta seguinte
  - key: feedback_thumbs_question
    where: The question of a Feedback block with the Thumbs look, when the block
      writes none.
    text:
    - lang: en
      value: Was this useful?
    - lang: pt
      value: Foi util?
  - key: feedback_stars_question
    where: The question of a Feedback block with the Stars look, when the block writes
      none.
    text:
    - lang: en
      value: How would you rate this?
    - lang: pt
      value: Como avalia isto?
  - key: feedback_thumb_up
    where: The words under the thumb up of a Feedback block.
    text:
    - lang: en
      value: Helpful
    - lang: pt
      value: Util
  - key: feedback_thumb_down
    where: The words under the thumb down of a Feedback block.
    text:
    - lang: en
      value: Not helpful
    - lang: pt
      value: Pouco util
  - key: feedback_star
    where: 'The name of one star of a Feedback block ({0} = which star, {1} = how
      many stars): its tooltip.'
    text:
    - lang: en
      value: '{0} of {1} stars'
    - lang: pt
      value: '{0} de {1} estrelas'
  - key: feedback_thanks
    where: The thank-you a Feedback block shows once the visitor has voted.
    text:
    - lang: en
      value: Thank you for your feedback
    - lang: pt
      value: Obrigado pelo seu comentario
