%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 52d504d26bc89b84a83c73539d09f70b, type: 3}
  m_Name: CardStrings
  m_EditorClassIdentifier: TileStories::TileStories.CardStringTable
  rows:
  - key: close
    where: The name of the round close button at the top right of the card (read
      by screen readers and shown as its tooltip).
    text:
    - lang: en
      value: Close
    - lang: pt
      value: Fechar
  - key: fun_fact_label
    where: The small heading above every fact of a Fun Fact block.
    text:
    - lang: en
      value: Did you know?
    - lang: pt
      value: Sabia que?
  - key: fun_fact_hint
    where: The line a Fun Fact card in the Flip look shows until the visitor taps
      it.
    text:
    - lang: en
      value: Tap to reveal
    - lang: pt
      value: Toque para ver
  - key: status_heading
    where: The small heading above the condition in a Status block.
    text:
    - lang: en
      value: Condition
    - lang: pt
      value: Estado
  - key: status_unknown_mark
    where: The mark inside the outline of a Status block when nobody assessed the
      condition.
    text:
    - lang: en
      value: '?'
    - lang: pt
      value: '?'
  - key: status_unknown
    where: The condition's name in a Status block when nobody assessed it and the
      wall's outline types have no row to name it.
    text:
    - lang: en
      value: Not assessed
    - lang: pt
      value: Nao avaliado
  - key: status_percent
    where: The condition's name in a Status block when the wall's outline types do
      not name it; {0} is the damage percentage.
    text:
    - lang: en
      value: '{0}% damaged'
    - lang: pt
      value: '{0}% danificado'
  - key: sources_heading
    where: The heading of a Sources block.
    text:
    - lang: en
      value: Sources
    - lang: pt
      value: Fontes
  - key: sources_verified
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Verified.
    text:
    - lang: en
      value: Verified
    - lang: pt
      value: Verificado
  - key: sources_draft
    where: The chip of a Sources block in the With Confidence look when Content Status
      is Draft.
    text:
    - lang: en
      value: Draft
    - lang: pt
      value: Rascunho
