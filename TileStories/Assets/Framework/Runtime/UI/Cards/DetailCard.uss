@import url(../Shared/DesignTokens.uss);

.detail-card-panel {
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 24px;
  height: 160px;
  background-color: rgba(0, 0, 0, 0.85);
  border-radius: 12px;
  padding: 12px 16px;
}

.detail-card-label {
  unity-text-align: middle-center;
  color: white;
  font-size: 16px;
}

.detail-card-close {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 28px;
  height: 28px;
}
