/* The visitor's search, filter and select UI (SearchUIHost). Every size and colour of it lives here;
   the C# views only name elements and add classes. Colours are defined once as variables.
   UI Toolkit USS only: no web-CSS gap / cursor / calc (UI Toolkit drops them with a warning). */

.search-ui {
    --surface: rgba(10, 12, 16, 0.88);
    --surface-raised: rgba(40, 44, 52, 0.95);
    --text-primary: rgb(255, 255, 255);
    --text-secondary: rgb(200, 200, 200);
    --accent: rgb(64, 132, 214);
    --accent-soft: rgba(64, 132, 214, 0.45);
    --outline: rgba(255, 255, 255, 0.25);

    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- top: search bar, view switch, filter tray ---- */

.search-top {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
}

.search-bar {
    flex-direction: row;
    align-items: center;
    height: 60px;
    padding: 4px;
    border-radius: 12px;
    background-color: var(--surface);
}

.search-field {
    flex-grow: 1;
    height: 48px;
    margin: 0;
    font-size: 16px;
}

.search-field > .unity-base-text-field__input {
    background-color: var(--surface-raised);
    color: var(--text-primary);
    border-color: var(--outline);
    border-radius: 8px;
    padding-left: 10px;
}

.search-button {
    min-width: 64px;
    min-height: 48px;
    height: 48px;
    margin-left: 6px;
    border-radius: 8px;
    font-size: 14px;
    color: var(--text-primary);
    background-color: var(--surface-raised);
    border-color: var(--outline);
}

.search-button--on {
    background-color: var(--accent);
}

.search-panel {
    margin-top: 6px;
    padding: 10px;
    border-radius: 12px;
    background-color: var(--surface);
    color: var(--text-primary);
}

.search-suggestions {
    flex-direction: column;
}

.suggestion {
    min-height: 48px;
    height: 48px;
    margin: 2px 0;
    -unity-text-align: middle-left;
    font-size: 15px;
    color: var(--text-primary);
    background-color: var(--surface-raised);
    border-color: var(--outline);
    border-radius: 8px;
}

.view-modes {
    flex-direction: row;
    margin-top: 6px;
    padding: 3px;
    border-radius: 10px;
    background-color: var(--surface);
}

.view-mode {
    flex-grow: 1;
    min-height: 48px;
    height: 48px;
    margin: 0 2px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-secondary);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
}

.view-mode--on {
    color: var(--text-primary);
    background-color: var(--accent);
}

/* the tray scrolls instead of squeezing its groups: UI Toolkit shrinks flex children by default,
   which made the wrapped chip rows of one group spill over the next */
.filter-tray {
    max-height: 420px;
}

.filter-groups {
    flex-shrink: 1;
}

.facet-group {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.facet-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-secondary);
    margin-bottom: 4px;
}

.facet-chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.facet-chip {
    flex-shrink: 0;
    min-height: 48px;
    margin: 0 6px 6px 0;
    padding: 0 10px;
    border-radius: 22px;
    background-color: var(--surface-raised);
}

.facet-chip Label {
    color: var(--text-primary);
    font-size: 14px;
}

/* ---- minimap ---- */

.minimap {
    position: absolute;
    top: 150px;
    right: 12px;
    width: 172px;
    height: 172px;
    padding: 6px;
}

.minimap-map {
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--outline);
    border-radius: 8px;
}

.minimap-hit {
    position: absolute;
    align-items: center;
    justify-content: center;
}

.minimap-dot {
    background-color: var(--text-primary);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

.minimap-dot--icon {
    align-items: center;
    justify-content: center;
}

.minimap-icon {
    width: 80%;
    height: 80%;
    -unity-background-scale-mode: scale-to-fit;
}

/* ---- bottom: results list, detail card ---- */

/* bottom: above the on-screen zoom buttons (ZoomControlView), never over them */
.search-bottom {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 84px;
    max-height: 45%;
}

.results-panel {
    height: 260px;
    max-height: 100%;
    padding: 4px;
}

.results-list {
    flex-grow: 1;
}

.result-row {
    height: 56px;
    padding: 6px 10px;
    justify-content: center;
    border-radius: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--outline);
}

.result-row--selected {
    background-color: var(--accent-soft);
}

/* the default theme pads every Label: zero it so two lines fit the fixed row height */
.result-name {
    margin: 0;
    padding: 0;
    font-size: 15px;
    color: var(--text-primary);
}

.result-subtitle {
    margin: 2px 0 0 0;
    padding: 0;
    font-size: 12px;
    color: var(--text-secondary);
}

.results-empty {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.results-empty-message {
    font-size: 15px;
    color: var(--text-secondary);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 10px;
}

.detail-card {
    min-height: 130px;
    padding: 16px 60px 16px 16px;
}

.detail-card-close {
    position: absolute;
    top: 6px;
    right: 6px;
    width: 48px;
    height: 48px;
    font-size: 16px;
    color: var(--text-primary);
    background-color: var(--surface-raised);
    border-color: var(--outline);
    border-radius: 22px;
}

.detail-card-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--text-primary);
    white-space: normal;
}

.detail-card-subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    margin-top: 4px;
}

.detail-card-summary {
    font-size: 14px;
    color: var(--text-primary);
    white-space: normal;
    margin-top: 8px;
}

.listen-bar {
    height: 4px;
    margin-top: 4px;
    border-radius: 2px;
    background-color: var(--accent);
}
