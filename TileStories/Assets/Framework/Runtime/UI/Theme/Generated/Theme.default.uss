/* Type: body = atkinson_next_regular (bold: atkinson_next_bold, through its weight table), display = fraunces_semibold */
.ts-app.ts-theme-default {
    --ts-font-body: url("/Assets/Framework/Runtime/UI/Theme/Fonts/AtkinsonHyperlegibleNext/AtkinsonHyperlegibleNext-Regular UITK.asset");
    --ts-font-display: url("/Assets/Framework/Runtime/UI/Theme/Fonts/Fraunces/Fraunces-SemiBold UITK.asset");
    -unity-font-definition: var(--ts-font-body);
}

