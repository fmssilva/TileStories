/* The card's navigation elements (_3.2 section 5), written only with the --ts-* tokens (CardTokens.uss). The slot that holds an
   element is the container's (PoiCard.uss, .poi-card__nav-top). A family's colour is not written here: it is data (FamilyDefinition
   .ColorToken), read by the views through CardTokenColours and painted on the icon, the dot or the bar -- never on its own. */

/* ---- the tabs (TabsNavView: text_tabs, icon_tabs): a clipped strip, its row of tabs moved sideways by the view ---- */

/* the first word starts where the header's title does (this padding + a tab's own = the header's --ts-space-4) */
.nav-tabs__viewport {
    flex-direction: row;
    overflow: hidden;
    padding: 0 var(--ts-space-1);
}

.nav-tabs__row {
    flex-direction: row;
    flex-shrink: 0;
}

/* a whole tab is the tap target: never smaller than the touch token, never shrunk below its word (the strip scrolls instead) */
.nav-tabs__tab {
    flex-shrink: 0;
    min-height: var(--ts-touch-target);
    min-width: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-3);
    justify-content: center;
    align-items: center;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ts-clear);
}

.nav-tabs__tab:hover,
.nav-tabs__tab:active {
    background-color: var(--ts-clear);
}

/* an icon tab: the family's icon above its word, the pair centred in the tab */
.nav-tabs__tab--icon {
    flex-direction: column;
    padding: var(--ts-space-1) var(--ts-space-3) var(--ts-space-2) var(--ts-space-3);
}

.nav-tabs__icon {
    margin-bottom: var(--ts-space-1);
}

.nav-tabs__words {
    flex-direction: row;
    align-items: center;
}

.nav-tabs__label {
    font-size: var(--ts-size-body);
    -unity-font-style: normal;
    color: var(--ts-ink-2);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.nav-tabs__tab--icon .nav-tabs__label {
    font-size: var(--ts-size-caption);
}

/* the marked section: an underline AND a bolder, brighter label */
.nav-tabs__underline {
    position: absolute;
    left: var(--ts-space-3);
    right: var(--ts-space-3);
    bottom: 0;
    height: var(--ts-tab-underline);
    border-radius: var(--ts-radius-s);
    background-color: var(--ts-accent);
    display: none;
}

.nav-tabs__tab--current .nav-tabs__label {
    -unity-font-style: bold;
    color: var(--ts-ink);
}

.nav-tabs__tab--current .nav-tabs__underline {
    display: flex;
}

/* in the floating icon strip (S4a review) the chosen tab sits on a soft pill, its underline a short mark under the pill's words */
.nav-tabs__tab--icon {
    border-radius: var(--ts-radius-l);
    margin: var(--ts-space-1) 0;
}

.nav-tabs__tab--icon.nav-tabs__tab--current,
.nav-tabs__tab--icon.nav-tabs__tab--current:hover,
.nav-tabs__tab--icon.nav-tabs__tab--current:active {
    background-color: var(--ts-button-glass);
}

.nav-tabs__tab--icon .nav-tabs__underline {
    left: 40%;
    right: 40%;
    bottom: var(--ts-space-1);
}

/* Show Counts: an item's block count, after its words, quieter than them */
.nav-item__count {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: nowrap;
    margin: 0 0 0 var(--ts-space-1);
    padding: 0;
}

/* ---- the chips (NavChipRow: kind_chips, icon_tabs_chips' row): a strip of pills, each in a full-size tap target ---- */

.nav-chips__viewport {
    flex-direction: row;
    overflow: hidden;
    padding: 0 var(--ts-space-2);
}

.nav-chips__row {
    flex-direction: row;
    flex-shrink: 0;
}

.nav-chip {
    flex-shrink: 0;
    min-height: var(--ts-touch-target);
    min-width: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-1);
    justify-content: center;
    align-items: center;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ts-clear);
}

.nav-chip:hover,
.nav-chip:active {
    background-color: var(--ts-clear);
}

.nav-chip__pill {
    flex-direction: row;
    align-items: center;
    height: var(--ts-chip-height);
    padding: 0 var(--ts-space-3);
    border-radius: var(--ts-chip-radius);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    background-color: var(--ts-surface-2);
}

/* the family's colour, as a dot BESIDE the words (painted by the view; ink-3 until the token resolves) */
.nav-chip__dot {
    width: var(--ts-dot-size);
    height: var(--ts-dot-size);
    border-radius: var(--ts-dot-size);
    margin-right: var(--ts-space-2);
    background-color: var(--ts-ink-3);
}

.nav-chip__label {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

/* the chip of the kind being read: an accent outline AND bolder words */
.nav-chip--current .nav-chip__pill {
    border-width: var(--ts-choice-border);
    border-color: var(--ts-accent);
}

.nav-chip--current .nav-chip__label {
    -unity-font-style: bold;
    color: var(--ts-ink);
}

/* the facet chips of the two menus (_3.2 step 18): ONE row of chips under the menu's title, scrolling sideways when wider than the menu.
   They reuse the kind chip (a 48 px target holding a pill); a chip that is on has the accent border and bold words of the current kind chip */
.nav-facets {
    flex-shrink: 0;
    border-bottom-width: var(--ts-line-width);
    border-color: var(--ts-line);
}

.nav-facets__viewport {
    flex-direction: row;
    overflow: hidden;
    padding: 0 var(--ts-space-2);
}

.nav-facets__row {
    flex-direction: row;
    flex-shrink: 0;
}

/* Clear is no filter: no pill, accent words */
.nav-facets__clear .nav-chip__pill {
    border-color: var(--ts-clear);
    background-color: var(--ts-clear);
}

.nav-facets__clear .nav-chip__label {
    color: var(--ts-accent);
    -unity-font-style: bold;
}

/* icon_tabs_chips: the chip row sits right under the tabs */
.nav-tabs-chips .nav-chips__viewport {
    padding-bottom: var(--ts-space-1);
}

/* its row keeps a chip's height when the section read has no chips (emptied, hidden): the strip keeps one height, so the reading space
   under it never jumps -- an emptied row that collapsed moved the spy line back over the section boundary, which filled the row again,
   in a loop Unity reported as "Layout update is struggling" (_3.2 step 17b) */
.nav-tabs-chips .nav-chips__row {
    min-height: var(--ts-touch-target);
}

/* ---- segmented (SegmentedNavView): equal segments on one track, always fitting the strip ---- */

.nav-segmented {
    padding: var(--ts-space-1) var(--ts-space-4) var(--ts-space-2) var(--ts-space-4);
}

.nav-segmented__track {
    flex-direction: row;
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface-2);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    overflow: hidden;
}

/* the measuring copy of a segment's words (FitCounts): bold like the marked segment, never seen, never in the layout */
.nav-segmented__ruler {
    position: absolute;
    left: 0;
    top: 0;
    visibility: hidden;
    white-space: nowrap;
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* equal shares of the track (basis 0), a whole tap target tall; a long word wraps inside its segment, never cut */
.nav-segment {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    flex-direction: row;
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-1);
    justify-content: center;
    align-items: center;
    border-width: 0;
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-clear);
}

.nav-segment:hover,
.nav-segment:active {
    background-color: var(--ts-clear);
}

.nav-segment__label {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
    -unity-text-align: middle-center;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}

/* the group being read: filled with the accent AND bolder words (dark on the accent, like every accent fill) */
.nav-segment--current,
.nav-segment--current:hover,
.nav-segment--current:active {
    background-color: var(--ts-accent);
}

.nav-segment--current .nav-segment__label,
.nav-segment--current .nav-item__count {
    -unity-font-style: bold;
    color: var(--ts-on-accent);
}

/* ---- progress_map (ProgressMapNavView): one piece of a thin bar per section, its icon above it ---- */

.nav-progress__viewport {
    flex-direction: row;
    overflow: hidden;
    padding: 0 var(--ts-space-1);
}

.nav-progress__row {
    flex-direction: row;
    flex-shrink: 0;
}

/* the view sets each piece's width (ProgressMapRule); the touch token is its least, both ways */
.nav-progress__segment {
    flex-shrink: 0;
    flex-direction: column;
    min-height: var(--ts-touch-target);
    min-width: var(--ts-touch-target);
    margin: 0;
    padding: var(--ts-space-1) var(--ts-rail-width) var(--ts-space-2) var(--ts-rail-width);
    justify-content: flex-end;
    align-items: center;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ts-clear);
}

.nav-progress__segment:hover,
.nav-progress__segment:active {
    background-color: var(--ts-clear);
}

.nav-progress__icon {
    margin-bottom: var(--ts-space-1);
}

.nav-progress__label {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: nowrap;
    margin: 0 0 var(--ts-space-1) 0;
    padding: 0;
}

/* the piece of bar: as wide as its segment, faint until the visitor has read that far (painted in the family's colour) */
.nav-progress__bar {
    align-self: stretch;
    height: var(--ts-segment-height);
    border-radius: var(--ts-segment-height);
    background-color: var(--ts-ink-3);
    opacity: var(--ts-ahead-opacity);
}

.nav-progress__segment--passed .nav-progress__bar {
    opacity: 1;
}

/* the section being read: a thicker piece AND bolder words */
.nav-progress__segment--current .nav-progress__bar {
    height: var(--ts-progress-height);
}

.nav-progress__segment--current .nav-progress__label {
    -unity-font-style: bold;
    color: var(--ts-ink);
}

/* ---- the bottom bar (BottomBarNavView: bottom_bar, _3.2 section 5.2): a few slots sharing the width equally, More last; the More
   list opens above them, inside the bottom area. Its items are icon tabs (NavTab), so the tab rules above give them their icon, word and
   underline ---- */

.nav-bar__items {
    flex-direction: row;
    padding: 0 var(--ts-space-1);
}

/* every slot the same share of the bar, and never under the touch token; a word never wraps or gets cut (the test measures it) */
.nav-bar__item {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    padding: var(--ts-space-1) var(--ts-space-1) var(--ts-space-2) var(--ts-space-1);
}

/* the list of the sections More holds: one row per section, the icon beside its word, the whole row the tap target */
.nav-bar__more-list {
    padding: var(--ts-space-1) var(--ts-space-2);
    border-bottom-width: var(--ts-line-width);
    border-color: var(--ts-line);
    background-color: var(--ts-surface);
}

.nav-bar__more-row {
    flex-direction: row;
    justify-content: flex-start;
    padding: 0 var(--ts-space-3);
}

.nav-bar__more-row .nav-tabs__icon {
    margin: 0 var(--ts-space-3) 0 0;
}

.nav-bar__more-row .nav-tabs__label {
    font-size: var(--ts-size-body);
}

/* a row's mark is its bolder word and a bar at its start (an underline under a whole-width row would read as a divider) */
.nav-bar__more-row .nav-tabs__underline {
    left: 0;
    right: auto;
    top: var(--ts-space-2);
    bottom: var(--ts-space-2);
    width: var(--ts-tab-underline);
    height: auto;
}

/* ---- the dock (DockNavView: dock, _3.2 section 5.2): the bar as an icon pill. The marked item widens to its icon and its word, every
   other slot stays an icon -- the widening is the scroll-spy's mark (NavTab.CurrentClass), so the stylesheet alone does it. Scoped to the
   slot row: More's list rows keep their words. ---- */

.nav-bar--dock {
    align-items: center;
}

.nav-bar--dock .nav-bar__more-list {
    align-self: stretch;
}

/* the pill is as wide as its items and never wider than the card (a slot shrinks to its touch-target minimum before it overflows) */
.nav-bar--dock .nav-bar__items {
    max-width: 100%;
    margin: var(--ts-space-1) 0 var(--ts-space-2) 0;
    padding: var(--ts-space-1);
    border-radius: var(--ts-pill-radius);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    background-color: var(--ts-surface-2);
}

.nav-bar--dock .nav-bar__items .nav-bar__item {
    flex-grow: 0;
    flex-basis: auto;
    flex-direction: row;
    padding: 0 var(--ts-space-3);
    border-radius: var(--ts-pill-radius);
}

.nav-bar--dock .nav-bar__items .nav-tabs__icon {
    margin: 0;
}

/* only the marked item says its word, beside its icon */
.nav-bar--dock .nav-bar__items .nav-tabs__words {
    display: none;
}

.nav-bar--dock .nav-bar__items .nav-tabs__tab--current .nav-tabs__words {
    display: flex;
    margin-left: var(--ts-space-2);
}

/* the marked item: a raised plate with an accent outline AND its word (never the colour alone); no underline in a pill */
.nav-bar--dock .nav-bar__items .nav-tabs__tab--current {
    border-width: var(--ts-choice-border);
    border-color: var(--ts-accent);
    background-color: var(--ts-surface);
}

.nav-bar--dock .nav-bar__items .nav-tabs__underline {
    display: none;
}

/* ---- bar_sheet (BarSheetNavView): the bar's arrow on the slot being read, up -- "a tap here opens a list above". It sits just right
   of the slot's icon (the icon is centred: half the slot plus a little), at the icon's own height, so it reads as part of it in a wide
   slot and in a narrow one ---- */

.nav-bar__arrow {
    position: absolute;
    top: var(--ts-space-1);
    left: 50%;
    margin-left: var(--ts-space-3);
    rotate: 180deg;
}

/* ---- next_up (NextUpNavView): "Up next", the next block's heading and its place, beside a Next button ---- */

.nav-next-up {
    flex-direction: row;
    align-items: center;
    padding: var(--ts-space-2) var(--ts-space-4);
    border-top-width: var(--ts-line-width);
    border-color: var(--ts-line);
    background-color: var(--ts-surface);
}

/* a whole touch target tall even at the end of the card (no button), so the bar never shrinks under the reader's thumb */
.nav-next-up__text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-height: var(--ts-touch-target);
    justify-content: center;
    margin-right: var(--ts-space-3);
}

.nav-next-up__line {
    flex-direction: row;
    align-items: center;
}

.nav-next-up__caption,
.nav-next-up__position {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.nav-next-up__position {
    margin-left: var(--ts-space-2);
}

/* the heading wraps whole (the gallery's check: no word is ever cut) */
.nav-next-up__heading {
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* Next is the bar's one action but the card's SECOND: the sticky call to action above it (The Lamp's "Show me where it is") is the accent
   fill, so Next is an accent outline with ink words -- two filled pills stacked in the thumb zone would compete */
.nav-next-up__button,
.nav-next-up__button:hover,
.nav-next-up__button:active {
    flex-shrink: 0;
    margin: 0;
    border-width: var(--ts-choice-border);
    border-color: var(--ts-accent);
    background-color: var(--ts-surface-2);
}

.nav-next-up__button-label {
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    margin: 0;
    padding: 0;
}

/* the end of the card: with no block and no button to look at, the finished words are what the bar is -- body size, full ink, bold */
.nav-next-up--done .nav-next-up__caption {
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
}

/* ---- the menu overlay (CardMenuOverlay, _3.2 section 5.3): a layer over the sheet, under the full view. A MENU draws its panel on a scrim
   over the whole card (a tap on the scrim closes it); a bar's More / kinds list is anchored in place and needs no layer at all ---- */

.card-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.card-menu__scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: var(--ts-scrim);
}

.card-menu__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ---- a menu's top (NavMenuHeader): its title and a visible close X, the card's own round button ---- */

.nav-menu__header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: var(--ts-space-2) var(--ts-space-2) var(--ts-space-2) var(--ts-space-4);
    border-bottom-width: var(--ts-line-width);
    border-color: var(--ts-line);
}

.nav-menu__title {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
}

.nav-menu__close {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    background-color: var(--ts-surface-2);
    border-color: var(--ts-line);
    border-width: var(--ts-line-width);
    border-radius: var(--ts-touch-target);
}

/* ---- drawer_tree (DrawerTreeNavView): a drawer from the left over the scrim, the card's outline in it ---- */

.nav-drawer {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--ts-drawer-width);
    max-width: var(--ts-drawer-max-width);
    background-color: var(--ts-surface);
    border-right-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-top-right-radius: var(--ts-radius-l);
    border-bottom-right-radius: var(--ts-radius-l);
    overflow: hidden;
}

.nav-drawer__list {
    flex-grow: 1;
    flex-shrink: 1;
}

/* a whole line is the tap target: as wide as the drawer, one touch target tall */
.nav-drawer__row {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    flex-shrink: 0;
    padding: 0 var(--ts-space-4);
}

.nav-drawer__row .nav-tabs__icon {
    margin: 0 var(--ts-space-3) 0 0;
}

.nav-drawer__section .nav-tabs__label {
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
}

/* a kind sits under its section's words, quieter */
.nav-drawer__kind {
    padding-left: var(--ts-drawer-kind-indent);
}

.nav-drawer__kind .nav-tabs__label {
    font-size: var(--ts-size-caption);
}

/* a line's mark is its bolder word and a bar at its start (an underline under a whole-width line would read as a divider) */
.nav-drawer__row .nav-tabs__underline {
    left: 0;
    right: auto;
    top: var(--ts-space-2);
    bottom: var(--ts-space-2);
    width: var(--ts-tab-underline);
    height: auto;
}

/* ---- grid_overlay (GridOverlayNavView): a panel inset over the scrim (never a second sheet), big tiles two to a row. As tall as its
   tiles (capped by the screen, then its tiles scroll), resting low where the thumb that opened it already is ---- */

.nav-grid {
    position: absolute;
    left: var(--ts-space-4);
    right: var(--ts-space-4);
    bottom: var(--ts-space-6);
    max-height: var(--ts-grid-max-height);
    background-color: var(--ts-surface);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-l);
    overflow: hidden;
}

/* the Purpose / Format switch: two equal options, the one shown filled AND bold */
.nav-grid__switch {
    flex-direction: row;
    flex-shrink: 0;
    margin: var(--ts-space-3) var(--ts-space-4) 0 var(--ts-space-4);
    padding: var(--ts-space-1);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface-2);
}

.nav-grid__option {
    flex-grow: 1;
    flex-basis: 0;
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-2);
    font-size: var(--ts-size-body);
    color: var(--ts-ink-2);
    white-space: normal;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-clear);
}

.nav-grid__option--current {
    -unity-font-style: bold;
    color: var(--ts-ink);
    background-color: var(--ts-surface);
    border-width: var(--ts-line-width);
    border-color: var(--ts-accent);
}

/* in place, one section's kinds: the way back to every section and the section's words */
.nav-grid__back {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin: var(--ts-space-2) var(--ts-space-4) 0 var(--ts-space-2);
}

.nav-grid__all {
    flex-direction: row;
    align-items: center;
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-2);
    font-size: var(--ts-size-body);
    color: var(--ts-accent-text);
    border-width: 0;
    background-color: var(--ts-clear);
}

/* the down arrow turned to point back */
.nav-grid__all-icon {
    rotate: 90deg;
    margin-right: var(--ts-space-1);
}

.nav-grid__open-title {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    -unity-text-align: middle-right;
}

.nav-grid__scroll {
    flex-grow: 1;
    flex-shrink: 1;
}

.nav-grid__tiles {
    flex-direction: row;
    flex-wrap: wrap;
    padding: var(--ts-space-3) var(--ts-space-3) var(--ts-space-4) var(--ts-space-3);
}

/* a tile: half the row less its margins, two touch targets tall; icon over words over count, centred */
.nav-grid__tile {
    width: 46%;
    flex-grow: 1;
    min-height: var(--ts-grid-tile-height);
    margin: var(--ts-space-1);
    padding: var(--ts-space-2);
    align-items: center;
    justify-content: center;
    background-color: var(--ts-surface-2);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-m);
}

.nav-grid__icon {
    scale: 1.5 1.5;
    margin-bottom: var(--ts-space-3);
}

.nav-grid__label {
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    white-space: normal;
    -unity-text-align: middle-center;
}

.nav-grid__count {
    margin: var(--ts-space-1) 0 0 0;
}

/* the tile being read: an accent outline AND bolder words, never colour alone */
.nav-grid__tile--current {
    border-width: var(--ts-choice-border);
    border-color: var(--ts-accent);
}

.nav-grid__tile--current .nav-grid__label {
    -unity-font-style: bold;
}

/* ---- the Floating Button elements (_3.2 section 5.4, step 9): fab_dial and fab_radial in the card's floating slot ---- */

/* the area round the button (NavFab.Root): what the list or the arc hangs on; the button is a dark disc with a light edge (it floats over
   the camera image, bright or dark) and the sections icon in the accent colour, the card's X while what it opened is open */
.nav-fab {
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
}

.nav-fab__button {
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-touch-target);
    background-color: var(--ts-surface);
}

.nav-fab__close-bar {
    display: none;
}

.nav-fab--open .nav-fab__close-bar {
    display: flex;
}

.nav-fab--open .nav-fab__icon {
    display: none;
}

/* fab_dial: the column of labelled pills, right-aligned to the button, above it (up) or under it (down); FabDialNavView sets its
   max-height to the room on that side, past which it scrolls */
.nav-dial__list {
    position: absolute;
    right: 0;
    max-width: var(--ts-dial-max-width);
    margin: var(--ts-space-2) 0;
}

.nav-dial__list--up {
    bottom: 100%;
}

.nav-dial__list--down {
    top: 100%;
}

.nav-dial__list .unity-scroll-view__content-container {
    align-items: flex-end;
}

/* a pill: the family's icon beside its words on the floating surface, its own edge */
.nav-dial__item {
    flex-direction: row;
    justify-content: flex-start;
    margin: 0 0 var(--ts-space-1) 0;
    padding: 0 var(--ts-space-4) 0 var(--ts-space-3);
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface);
}

/* the pill keeps its own surface in every state: a tab's hover / press and the icon strip's marked tab (two classes) clear or glass a
   tab's ground, and the dial's words would then sit on whatever is behind the floating slot (_Test_Suite_1.md F5) */
.nav-dial__item:hover,
.nav-dial__item:active,
.nav-dial__item.nav-tabs__tab--current,
.nav-dial__item.nav-tabs__tab--current:hover,
.nav-dial__item.nav-tabs__tab--current:active {
    background-color: var(--ts-surface);
}

.nav-dial__item .nav-tabs__icon {
    margin: 0 var(--ts-space-2) 0 0;
}

.nav-dial__item .nav-tabs__label {
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
}

/* the section being read: a bar at the pill's start AND bolder words (never colour alone) */
.nav-dial__item .nav-tabs__underline {
    left: var(--ts-space-1);
    right: auto;
    top: var(--ts-space-3);
    bottom: var(--ts-space-3);
    width: var(--ts-tab-underline);
    height: auto;
}

/* fab_radial: the arc's origin is the button's centre; each item (FabRadialNavView sets its size to --ts-radial-item-width / -height and
   its place on the arc) is a round button with the family's icon and its words under it, on their own backing so they read over the camera */
.nav-radial__arc {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
}

.nav-radial__item {
    position: absolute;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    background-color: var(--ts-clear);
}

.nav-radial__item:hover,
.nav-radial__item:active {
    background-color: var(--ts-clear);
}

.nav-radial__disc {
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    align-items: center;
    justify-content: center;
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-touch-target);
    background-color: var(--ts-surface);
}

/* never wider than its item: a word longer than the footprint shows as cut (and fails its whole-word check), it never spills past the
   item onto a neighbour or off the screen */
.nav-radial__label {
    max-width: 100%;
    margin: var(--ts-space-1) 0 0 0;
    padding: 0 var(--ts-space-1);
    font-size: var(--ts-size-caption);
    color: var(--ts-ink);
    white-space: nowrap;
    border-radius: var(--ts-radius-s);
    background-color: var(--ts-surface);
}

/* the item a sliding finger points at: a thicker edge in the accent AND bolder words */
.nav-radial__item--pointed .nav-radial__disc {
    border-width: var(--ts-tab-underline);
    border-color: var(--ts-accent);
}

.nav-radial__item--pointed .nav-radial__label {
    -unity-font-style: bold;
}

/* the section being read: an accent edge AND bolder words */
.nav-radial__item.nav-tabs__tab--current .nav-radial__disc {
    border-color: var(--ts-accent);
}

.nav-radial__item.nav-tabs__tab--current .nav-radial__label {
    -unity-font-style: bold;
}

/* ---- the Edge element (_3.2 section 5.5, step 10): edge_scrubber -- family dots down the right edge of the stack's viewport ---- */

/* the element fills the edge host (the viewport's full height, one touch target wide) and takes no finger itself; only the dots do.
   Too short a viewport for every dot's full target: hidden -- invisible AND not pickable, but still laid out so the target can be measured */
.nav-edge {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.nav-edge--hidden {
    visibility: hidden;
}

/* the column of dots: EdgeScrubberRule puts its top and height; the targets tile it with no gap */
.nav-edge__column {
    position: absolute;
    left: 0;
    right: 0;
}

/* a dot's tap target: the whole touch-token square, transparent; the dot is what is drawn inside it */
.nav-edge__item {
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    border-width: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--ts-clear);
}

.nav-edge__item:hover,
.nav-edge__item:active {
    background-color: var(--ts-clear);
}

/* the dot: a dark disc with a light edge (it floats over a block, light or dark) holding the family's colour */
.nav-edge__disc {
    width: var(--ts-edge-disc);
    height: var(--ts-edge-disc);
    align-items: center;
    justify-content: center;
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-touch-target);
    background-color: var(--ts-surface);
}

.nav-edge__fill {
    width: var(--ts-edge-fill);
    height: var(--ts-edge-fill);
    border-radius: var(--ts-touch-target);
}

/* the family being read, and the one a finger is on: a LARGER disc with an accent edge AND a larger colour disc (never colour alone) */
.nav-edge__item--current .nav-edge__disc,
.nav-edge__item--pointed .nav-edge__disc {
    width: var(--ts-edge-disc-current);
    height: var(--ts-edge-disc-current);
    border-width: var(--ts-tab-underline);
    border-color: var(--ts-accent);
}

.nav-edge__item--current .nav-edge__fill,
.nav-edge__item--pointed .nav-edge__fill {
    width: var(--ts-edge-fill-current);
    height: var(--ts-edge-fill-current);
}

/* the label bubble beside the dot under the thumb (EdgeScrubberNavView puts its top at that dot's centre): the family's words on the
   floating surface, to the left of the edge so the thumb never covers it */
.nav-edge__bubble {
    display: none;
    position: absolute;
    right: 100%;
    margin-right: var(--ts-space-2);
    translate: 0 -50%;
    padding: var(--ts-space-1) var(--ts-space-3);
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface);
    flex-direction: row;
    align-items: center;
}

.nav-edge__bubble--shown {
    display: flex;
}

.nav-edge__label {
    margin: 0;
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: nowrap;
}

/* ---- the icon grid nav BLOCK (nav_icon_grid, _3.2 step 11a): the card's sections as tiles in the flow, three to a row, a short last row
   centred; each tile is a NavTab (icon over words + count), a plate in a full touch target. It marks nothing (it is a map of the card, at
   its top), so the tab's underline never shows ---- */

.nav-icon-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.nav-icon-grid__tile {
    width: 30%;
    flex-shrink: 0;
    /* one touch target is enough: the icon and one line of words fill it (two, the menu's big tiles, left the plates mostly empty) */
    min-height: var(--ts-touch-target);
    margin: var(--ts-space-1);
    padding: var(--ts-space-2);
    background-color: var(--ts-surface-2);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-m);
}

.nav-icon-grid__tile:hover,
.nav-icon-grid__tile:active {
    background-color: var(--ts-surface-2);
}

.nav-icon-grid__tile .nav-tabs__label {
    color: var(--ts-ink);
}

.nav-icon-grid__tile .nav-tabs__underline {
    display: none;
}

/* ---- the contents nav BLOCK (nav_contents, _3.2 step 11b): under each section's name (icon + words) a row per block -- a marker, the
   block's heading, its minutes. A READ row is marked twice, never by the tick alone: the marker fills (an empty ring -> a filled accent
   disc holding the tick) and the heading drops from bold to regular, like a read message in an inbox. Both headings stay --ts-ink (no
   fading: a read row must stay as readable as an unread one) ---- */

.nav-contents {
    flex-direction: column;
}

.nav-contents__section {
    flex-direction: row;
    align-items: center;
    margin: var(--ts-space-3) 0 var(--ts-space-1) 0;
}

.nav-contents__section-icon {
    margin: 0 var(--ts-space-2) 0 0;
}

.nav-contents__section-words {
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink-2);
}

/* Rows = Sections First (_3.2 step 13): the title is the card's compact row (CardParts.uss card-compact*), the whole width of the list */
.nav-contents__section-header {
    flex-grow: 1;
    /* - the compact row's own side margin is for a bare stack slot; the contents block already has its edges (its rows start there) */
    margin-left: 0;
    margin-right: 0;
}

.nav-contents__row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    flex-shrink: 0;
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    border-width: 0;
    border-bottom-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: 0;
    background-color: var(--ts-clear);
}

.nav-contents__row:hover,
.nav-contents__row:active {
    background-color: var(--ts-clear);
}

/* the marker: an empty ring until the block was read */
.nav-contents__marker {
    width: var(--ts-space-5);
    height: var(--ts-space-5);
    flex-shrink: 0;
    margin: 0 var(--ts-space-3) 0 0;
    border-width: var(--ts-icon-stroke);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-radius-round);
    background-color: var(--ts-clear);
    justify-content: center;
    align-items: center;
}

.nav-contents__tick {
    width: var(--ts-space-4);
    height: var(--ts-space-4);
    color: var(--ts-on-accent);
}

.nav-contents__row--read .nav-contents__marker {
    border-color: var(--ts-accent);
    background-color: var(--ts-accent);
}

.nav-contents__heading {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: var(--ts-space-2) 0;
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    -unity-text-align: middle-left;
}

.nav-contents__row--read .nav-contents__heading {
    -unity-font-style: normal;
}

.nav-contents__minutes {
    flex-shrink: 0;
    margin: 0 0 0 var(--ts-space-3);
    padding: 0;
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: nowrap;
}

/* ---- family_pager (FamilyPagerNavView, step 14): the section being read between two chevrons -- the pages layout's header ---- */

.nav-pager {
    flex-direction: row;
    align-items: center;
    padding: 0 var(--ts-space-1);
}

/* each chevron is a whole touch target; hidden (not removed) at the first / last section, so the name never shifts */
.nav-pager__chevron {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: var(--ts-radius-round);
    align-items: center;
    justify-content: center;
    background-color: var(--ts-clear);
}

.nav-pager__chevron:hover,
.nav-pager__chevron:active {
    background-color: var(--ts-surface-2);
}

.nav-pager__glyph {
    width: var(--ts-icon-size);
    height: var(--ts-icon-size);
    color: var(--ts-ink);
}

/* the shared chevron points down: turned to point back and on */
.nav-pager__chevron--previous .nav-pager__glyph {
    rotate: 90deg;
}

.nav-pager__chevron--next .nav-pager__glyph {
    rotate: -90deg;
}

.nav-pager__middle {
    flex-grow: 1;
    flex-shrink: 1;
    align-items: center;
    justify-content: center;
    padding: var(--ts-space-1) 0;
}

.nav-pager__name {
    flex-direction: row;
    align-items: center;
}

.nav-pager__icon {
    margin-right: var(--ts-space-2);
}

.nav-pager__words {
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.nav-pager__position {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    margin: 0;
    padding: 0;
}

/* ---- the pages layout's cues (CardPagerView, step 14): a page-wide panel beside the shown page, its family icon and words; at rest only
   --ts-page-peek of the NEXT one shows at the viewport's right edge. They lie over the stack's box (CardPagerView sets top, height, left
   and width, the sheet clips them); they never take a finger ---- */

.card-pager__peek {
    position: absolute;
    justify-content: center;
    background-color: var(--ts-surface-2);
    border-color: var(--ts-line);
}

.card-pager__peek--next {
    border-left-width: var(--ts-line-width);
    border-top-left-radius: var(--ts-radius-m);
    border-bottom-left-radius: var(--ts-radius-m);
}

.card-pager__peek--back {
    align-items: flex-end;
    border-right-width: var(--ts-line-width);
    border-top-right-radius: var(--ts-radius-m);
    border-bottom-right-radius: var(--ts-radius-m);
}

.card-pager__peek-row {
    flex-direction: row;
    align-items: center;
    padding: 0 var(--ts-space-2);
}

/* the back cue shows its words first, its icon nearest the page it comes back to */
.card-pager__peek--back .card-pager__peek-row {
    flex-direction: row-reverse;
}

.card-pager__peek-icon {
    flex-shrink: 0;
}

.card-pager__peek-words {
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: nowrap;
    margin: 0 var(--ts-space-2);
    padding: 0;
}

/* while a drag is claimed the cue lists its page's blocks as the card's compact rows (CardPagerView.ShowTeasers): the title goes to the
   top and the rows fill under it, clipped by the cue; none of it takes a finger */
.card-pager__peek--teaser {
    justify-content: flex-start;
    overflow: hidden;
    padding-top: var(--ts-space-3);
}

.card-pager__peek-list {
    align-self: stretch;
    margin-top: var(--ts-space-2);
}

/* ---- nav_rails (NavRailsBlockView, step 15a): a row of cards per section, a NavStrip each (the viewport clips, the row slides). The card
   token is the NARROWEST a card may be: CardTrackFit stretches the cards so a whole number of them fills the strip, plus the slice of the
   next one with Peek Next Card; this width is what shows until the strip has a size ---- */

.nav-rails__rail {
    margin-top: var(--ts-space-3);
}

.nav-rails__title {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ts-space-2);
}

.nav-rails__title-words {
    margin: 0 var(--ts-space-2);
    padding: 0;
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: nowrap;
}

/* the viewport lays its one child out sideways and clips it; the row never shrinks, so it is as wide as its cards and the strip moves it */
.nav-rails__viewport {
    flex-direction: row;
    overflow: hidden;
}

.nav-rails__row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: stretch;
}

.nav-rails__card {
    width: var(--ts-rail-card);
    min-width: var(--ts-rail-card);
    min-height: var(--ts-touch-target);
    flex-shrink: 0;
    margin: 0 var(--ts-space-3) 0 0;
    padding: var(--ts-space-3);
    align-items: flex-start;
    justify-content: flex-start;
    background-color: var(--ts-surface-2);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-m);
}

.nav-rails__card:hover,
.nav-rails__card:active {
    background-color: var(--ts-surface-2);
}

.nav-rails__card-icon {
    margin-bottom: var(--ts-space-2);
}

.nav-rails__card-words {
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    -unity-text-align: upper-left;
}

.nav-rails__card-meta {
    margin: var(--ts-space-1) 0 0 0;
    padding: 0;
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* the card that closes a long row: its words centred, the way an action reads */
.nav-rails__card--all {
    align-items: center;
    justify-content: center;
}

.nav-rails__card--all .nav-rails__card-words {
    color: var(--ts-accent);
    -unity-text-align: middle-center;
}

/* ---- nav_bento (NavBentoBlockView, step 15a): big tiles two to a row, the first and a lonely last one spanning the row
   (BentoTileRule.Wide); a tile with a picture shows it over its words ---- */

.nav-bento {
    flex-direction: row;
    flex-wrap: wrap;
}

.nav-bento__cell {
    width: 50%;
    padding: var(--ts-space-1);
}

.nav-bento__cell--wide {
    width: 100%;
}

.nav-bento__tile {
    flex-grow: 1;
    min-height: var(--ts-grid-tile-height);
    margin: 0;
    padding: 0;
    overflow: hidden;
    align-items: stretch;
    justify-content: space-between;
    background-color: var(--ts-surface-2);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-m);
}

/* a tile with no picture: the block's family icon at its top, the words at its bottom (so a tile beside a picture tile is no empty box) */
.nav-bento__icon {
    align-self: flex-start;
    margin: var(--ts-space-3) var(--ts-space-3) 0 var(--ts-space-3);
}

.nav-bento__tile:hover,
.nav-bento__tile:active {
    background-color: var(--ts-surface-2);
}

.nav-bento__picture {
    height: var(--ts-bento-picture);
    margin: 0;
}

.nav-bento__body {
    flex-direction: row;
    align-items: center;
    padding: var(--ts-space-3);
}

.nav-bento__texts {
    flex-grow: 1;
    flex-shrink: 1;
}

.nav-bento__words {
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    -unity-text-align: upper-left;
}

.nav-bento__meta {
    margin: var(--ts-space-1) 0 0 0;
    padding: 0;
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: normal;
    -unity-text-align: upper-left;
}

/* a tile that opens the block in the full view shows the full-screen glyph at its end: the one cue before the tap */
.nav-bento__full-view-glyph {
    flex-shrink: 0;
    width: var(--ts-icon-size);
    height: var(--ts-icon-size);
    margin-left: var(--ts-space-2);
    color: var(--ts-accent-text);
}

/* ---- the bento LAYOUT (CardBentoView, _3.2 step 15b): the card's sections as tiles where its blocks were, placed by BentoLayoutRule
   (absolute in the host: the rule gives every rect); the section with the most blocks leads -- larger words, a big count and an accent
   edge: the screen's one focal point. Every tile: family icon in its colour + words + count, never colour alone ---- */

.card-bento {
    margin: 0 var(--ts-space-4) var(--ts-block-gap) var(--ts-space-4);
}

.card-bento__tile {
    position: absolute;
    min-width: var(--ts-touch-target);
    min-height: var(--ts-bento-tile-min-height);
    margin: 0;
    padding: var(--ts-space-3);
    overflow: hidden;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    background-color: var(--ts-surface-2);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-radius-m);
}

.card-bento__tile:hover,
.card-bento__tile:active {
    background-color: var(--ts-surface-2);
}

.card-bento__line {
    flex-direction: row;
    align-items: center;
}

.card-bento__icon {
    flex-shrink: 0;
    margin: 0 var(--ts-space-2) 0 0;
}

.card-bento__words {
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: nowrap;
    -unity-text-align: middle-left;
}

/* the names of the section's blocks, as many as the tile holds (CardBentoView hides the rest in place); an empty box takes no height, so a
   tile at its minimum still holds its title and count */
.card-bento__names {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
    overflow: hidden;
    margin: 0;
}

.card-bento__name {
    margin: var(--ts-space-1) 0 0 0;
    padding: 0;
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: upper-left;
}

.card-bento__count {
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-body);
    color: var(--ts-ink-2);
    -unity-text-align: lower-left;
}

.card-bento__tile--lead {
    border-color: var(--ts-accent);
    border-width: var(--ts-choice-border);
}

.card-bento__tile--lead .card-bento__words {
    font-size: var(--ts-size-heading);
}

.card-bento__tile--lead .card-bento__count {
    font-size: var(--ts-size-title);
    -unity-font-style: bold;
    color: var(--ts-ink);
}

/* ---- the Navigation Bar (NavBarView, _3.3 S4a review): ONE configurable bar of the card's groups ----
   The bar's numbers (side margin, height, corner radius) and its colours (the fill's share, each group's colour) are set inline from
   card_settings.navigation.bar; everything else is a class here. Its host is clear (PoiCard.uss .poi-card__nav-top--bar): the bar draws
   itself, and the raised indicator may rise past its top edge. */
.nav-bar {
    overflow: visible;
}

.nav-bar--bottom {
    margin-bottom: var(--ts-space-2);
}

/* a soft shadow under the bar (light only: --ts-elevation-1 is clear in dark mode) */
.nav-bar__shadow {
    position: absolute;
    left: var(--ts-frame-shadow-out);
    top: var(--ts-frame-shadow-out);
    right: var(--ts-frame-shadow-out);
    bottom: var(--ts-frame-shadow-out);
    background-image: url("../card_block_shadow.png");
    -unity-background-image-tint-color: var(--ts-elevation-1);
    -unity-slice-left: var(--ts-frame-shadow-slice);
    -unity-slice-top: var(--ts-frame-shadow-slice);
    -unity-slice-right: var(--ts-frame-shadow-slice);
    -unity-slice-bottom: var(--ts-frame-shadow-slice);
    display: none;
}

.nav-bar--shadow > .nav-bar__shadow {
    display: flex;
}

/* the fill (its colour inline: the theme's bar colour at the setting's share) and the hairline round it */
.nav-bar__ground {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 0;
    border-color: var(--ts-glass-edge);
}

.nav-bar--border > .nav-bar__ground {
    border-width: var(--ts-line-width);
}

.nav-bar__row {
    flex-direction: row;
    align-items: stretch;
    padding: 0 var(--ts-space-1);
}

/* one group: its whole share of the bar is the tap target, never under the touch token */
.nav-bar__item {
    flex-grow: 1;
    flex-basis: 0;
    min-width: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ts-clear);
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.nav-bar__item:hover,
.nav-bar__item:active {
    background-color: var(--ts-clear);
}

.nav-bar__icon {
    transition-property: scale, translate;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

.nav-bar__label {
    font-size: var(--ts-size-caption);
    -unity-font-style: normal;
    color: var(--ts-ink-2);
    white-space: nowrap;
    margin: 2px 0 0 0;
    padding: 0;
}

/* the chosen group: its words bolder and full ink (with the indicator: never colour alone) */
.nav-bar__item--chosen .nav-bar__label {
    -unity-font-style: bold;
    color: var(--ts-ink);
}

/* Bold Chosen Icon: the icon's strokes heavier (the icon set reads its stroke from this token) */
.nav-bar--bold .nav-bar__item--chosen .nav-bar__icon {
    --ts-icon-stroke: 2.6px;
}

.nav-bar--enlarge .nav-bar__item--chosen .nav-bar__icon {
    scale: 1.18 1.18;
}

/* the indicator: a pill behind the chosen group by default, its colour inline (a wash of the chosen colour) */
.nav-bar__indicator {
    position: absolute;
    top: 6px;
    bottom: 6px;
    border-radius: var(--ts-radius-l);
}

.nav-bar--slide .nav-bar__indicator {
    transition-property: left, width;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

.nav-bar--indicator-underline .nav-bar__indicator {
    top: auto;
    bottom: 5px;
    height: 3px;
    border-radius: 2px;
}

/* Raised: a disc of the bar's own ground rising past its top edge, the chosen icon lifted into it -- the bar bulging under the group */
.nav-bar--indicator-raised .nav-bar__indicator {
    top: -16px;
    bottom: auto;
    border-width: var(--ts-line-width);
    border-color: var(--ts-glass-edge);
}

.nav-bar--indicator-raised .nav-bar__item--chosen .nav-bar__icon {
    translate: 0 -14px;
}
