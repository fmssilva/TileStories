/* The POI Detail Card's OWN tokens (_3.3 R12.2, T3): its sizes -- the sheet's layout, every block's and navigation element's
   measures -- and the plain numbers C# reads from the card's root (--ts-sheet-top-gap, --ts-hero-min-height,
   --ts-track-peek, --ts-bento-*, --ts-radial-*, --ts-float-gap). They sit on the card's roots (.ts-card) because a custom property
   is only in the customStyle of the element that DECLARES it (_3.3 R8 S1).
   Every colour and every theme scale (type sizes, radii, spacing, line width, motion) is NOT here: it is the app theme's (T1 / T2),
   generated from Resources/TileStories/Themes/Theme.default.asset into Theme/Generated/Theme.default.uss and inherited from the
   app root ThemeController marks. PoiCard.uss and every block style read both as var(--ts-*); ThemeTokenGuardTests holds every
   name they use to a definition. */

.ts-card.ts-theme-default {
    /* The pill button (CardParts.uss .card-pill): its corner radius is HALF the touch target, so a one-word pill stays a
       stadium, never an egg (a radius larger than half the height is shrunk unevenly), and it never gets narrower than this */
    --ts-pill-radius: 24px;
    --ts-pill-min-width: 96px;
    /* The one gap between two blocks of the stack (BlockStackView's slots, _3.1 step 6C) */
    --ts-block-gap: 24px;
    /* The block frame's shadow (_3.3 P4.4b): how far the 9-slice reaches outside the slot, and where card_block_shadow.png is sliced
       (its 16 px margin + the 20 px block radius, --ts-radius-l) */
    --ts-frame-shadow-out: -16px;
    --ts-frame-shadow-slice: 36;
    /* how far a picture / carousel / strip / track reaches past the frame's side padding (--ts-space-4): minus that padding, so it
       meets the frame's inner edge (P4.4b part 2) */
    --ts-frame-bleed: -16px;
    /* the frame's inner corner (_3.3 S4a): the block radius (--ts-radius-l 20) less the outer line (1) -- where a picture flush with the
       block's top rounds with it; and the groove's, less the light metal band (3) too (ThemeFrameSceneTests checks both pairs) */
    --ts-frame-inner-radius: 19px;
    --ts-frame-groove-radius: 16px;
    /* The block page's scroll reaches the phone's edges: minus the takeover page's side margin (--ts-space-4) */
    --ts-page-bleed: -16px;
    /* The section sheets (_3.3 P4.4c1, SectionSheets): how far a sheet is laid over the one before (a negative top margin, on the 8
       grid: the prototype's ~14), and the opener's full-width line */
    --ts-section-overlap: -16px;
    --ts-section-line: 2px;

    /* Sheet layout: the smallest tap target (WCAG 2.5.5 asks 44), the grabber bar, and the camera strip the full stop
       leaves above the sheet when the wall's Full Height is Leave A Camera Strip (To The Top leaves none, SheetStopRule.FullTopGap).
       --ts-sheet-top-gap is read by PoiCardSheetView as a plain number (panel units). */
    --ts-touch-target: 48px;
    --ts-grabber-width: 40px;
    --ts-grabber-height: 4px;
    --ts-sheet-top-gap: 48;
    /* Navigation (_3.2): the bar under the section a tab element marks (with the bolder label: never colour alone) */
    --ts-tab-underline: 3px;
    /* A navigation chip's pill (kind_chips, icon_tabs_chips: the button around it is the whole --ts-touch-target) and its radius, half
       its height, so it stays a stadium */
    --ts-chip-height: 32px;
    --ts-chip-radius: 16px;
    /* The words the full view's chip of the page being read shows beside its icon (that block's heading), cut with an ellipsis past this
       width: the other chips stay icons, so the one that says what it is never pushes the strip off the screen (_3.2 step 17a) */
    --ts-chip-words-max: 220px;
    /* What a part not reached yet fades to (the progress map's pieces ahead of the one being read) */
    --ts-ahead-opacity: 0.35;
    /* The settings panel's width and the outline of its current choice (_3.3 P4.4b) */
    --ts-settings-width: 240px;
    --ts-chosen-border: 2px;
    /* The chrome (_3.3 S4 third round, v5): each touch target's inset from the sheet's side, so its disc sits v5's 16 pt in; the disc
       (and its radius, half of it) and the thin mark inside it */
    --ts-chrome-inset: 12px;
    --ts-chrome-disc: 36px;
    --ts-chrome-disc-radius: 18px;
    --ts-chrome-mark: 16px;
    /* The menu button (_3.2 step 8) sits left of the settings disc (its inset + one touch target); with it the bar keeps both ends clear
       of the buttons the same way, so its title stays centred */
    --ts-menu-button-right: 56px;
    --ts-header-end-with-menu: 104px;
    /* The menus over the card (_3.2 step 8). The drawer takes most of a phone's width and never more than a comfortable reading column
       (so on a tablet it stays a drawer); a kind's line starts under its section's words (row padding + icon + its gap). The grid's tiles
       are two touch targets tall: big thumbs, a kiosk's size */
    --ts-drawer-width: 85%;
    --ts-drawer-max-width: 360px;
    --ts-drawer-kind-indent: 46px;
    --ts-grid-tile-height: 96px;
    /* The grid's panel is as tall as its tiles, never taller than this share of the screen (it keeps the scrim above it to tap) */
    --ts-grid-max-height: 88%;

    /* Line icons drawn in USS (the close X): their length and stroke */
    --ts-icon-size: 18px;
    --ts-icon-stroke: 2px;
    --ts-icon-dot: 6px;

    /* The status block's rings: the main one and each step of the scale */
    --ts-status-ring-size: 56px;
    --ts-status-step-ring: 28px;

    /* The fun_fact postcard's tilt */
    --ts-postcard-tilt: -1.5deg;

    /* Numbered markers (process_steps) and the line that joins steps / timeline events */
    --ts-step-number: 32px;
    --ts-rail-width: 2px;

    /* A colour sample (swatches) */
    --ts-swatch-size: 44px;

    /* Timeline: an event's dot, the Now point's larger ring, one event's width in the horizontal look */
    --ts-timeline-dot: 12px;
    --ts-timeline-now: 16px;
    --ts-timeline-cell: 160px;

    /* The bar (_3.3 P4.4a): its centred title keeps clear of the X and of settings at both ends (the inset + one touch target + a gap); its
       place and height are the floating chrome's (--ts-bar-top, --ts-bar-height) */
    --ts-header-end: 64px;

    /* A person's monogram (the photo's place until Tier 2 images) */
    --ts-monogram-size: 48px;

    /* The chapter bar of story_chapters: one segment per chapter */
    --ts-segment-height: 4px;

    /* Tier 2 pictures (Media.uss): a block picture's frame, the gallery's small pictures and prints,
       the spotlight ring, the before / after handle, the full-screen view's picture area */
    /* The hero (_3.3 P4.4a, S4a): the whole of Full's view under the bar, never shorter than this (HeroRule.Height). A plain number (panel
       units) read by PoiCardSheetView on this card root; the outline of its Listen button on the plate */
    --ts-hero-min-height: 200;
    --ts-hero-outline-width: 2px;
    /* the shade behind the hero's words (Media.uss, .card-hero__shade; v5's "a shade behind the words only"): its ramp's height above the
       words' block and the same reach upwards (a USS length cannot be negated: PoiCardHeroSceneTests checks the pair), and how far its
       floor reaches under the block -- past the hero's foot, so the words rising on a scroll never lift it off the picture */
    --ts-hero-shade-ramp: 96px;
    --ts-hero-shade-out-top: -96px;
    --ts-hero-shade-out-bottom: -480px;
    /* the dark halo round every letter of the hero (the text-shadow's blur; its colour is the theme's --ts-text-halo) */
    --ts-text-halo-blur: 10px;
    /* the hero's kicker and its one line (the title is the theme's --ts-size-hero / -narrow) */
    --ts-hero-eyebrow-size: 12px;
    --ts-hero-line-size: 15px;
    /* Listen on the hero: a small headphones mark and time, no box -- the mark and the words small, the target still a finger's */
    --ts-hero-listen-icon: 16px;
    --ts-hero-listen-text: 13px;
    --ts-hero-listen-target: 44px;
    /* the gap under the hero's last row (Listen, the actions) and the foot of what the sheet shows: the words sit low, the picture clear */
    --ts-hero-words-inset: 4px;
    /* the floating chrome (S4a review): the grab row, the slim bar's top and height, the strip's top (the bar's foot + a gap), the fade
       behind the bars over the hero's picture */
    --ts-handle-height: 20px;
    --ts-bar-top: 6px;
    --ts-bar-height: 44px;
    --ts-nav-float-top: 54px;
    --ts-top-shade-height: 150px;
    /* the chrome band after the hero (PoiCard.uss): the grab row and the bar row (--ts-bar-top + --ts-bar-height) and a little under them,
       down to where a Top bar / strip floats (--ts-nav-float-top) */
    --ts-chrome-band-height: 54px;
    /* the FADE band (Top Band = Fade, _3.3 P2 review (b)): solid through the chrome row's foot (a plain number, PoiCardSheetView.TopFade),
       then a short fade to nothing -- no wide white area */
    --ts-top-fade-height: 76px;
    --ts-top-fade-solid: 52;
    /* OPEN sections (_3.3 P3, v6's Sections): the side gutter (and minus it: a picture's bleed to the screen's edges), the section's top over its
       eyebrow (the first's a little less), its foot, the space over a block after the first, the eyebrow and its 28 x 3 rule,
       the start's tiles (24 with 1 pt joints, top corners 24) and wave, the gap a drawn start keeps under a divider, the ornament's tile and lines */
    --ts-open-gutter: 24px;
    --ts-open-bleed: -24px;
    --ts-open-section-top: 48px;
    --ts-open-section-top-first: 40px;
    --ts-open-section-foot: 56px;
    --ts-open-block-gap: 24px;
    --ts-open-eyebrow: 12px;
    --ts-open-eyebrow-tracking: 1.9px;
    --ts-open-rule-width: 28px;
    --ts-open-rule-height: 3px;
    --ts-open-tile: 24px;
    --ts-open-tile-radius: 24px;
    --ts-open-wave: 30px;
    --ts-open-divider-gap: 40px;
    --ts-open-ornament-tile: 22px;
    --ts-open-ornament-line: 72px;
    /* The Navigation Bar (_3.3 S4 third round, v5's numbers): plain numbers (panel units) NavBarView reads on this card root for the ONE
       path it paints (NavBarShapeRule) -- the bar's height with words and without, a floating bar's inset from the sides and its gap above
       the screen's foot, the room above the edge the raised bump and its disc rise into, the bump's height and half its foot, a floating
       raised bar's corner (any other floating bar is a stadium), the raised disc, Filled's disc at the icon. The bump is ONE smooth bell
       (_3.3 P3a review a): its peak is the raised disc's top (room - bump = 14: no band of bar above the disc), its crest the disc's own
       arc, its feet 50 from the disc's centre -- wide soft shoulders, 2.5 times the disc */
    --ts-navbar-height: 62;
    --ts-navbar-height-compact: 52;
    --ts-navbar-inset: 16;
    --ts-navbar-gap: 20;
    --ts-navbar-room: 26;
    --ts-navbar-bump: 12;
    --ts-navbar-bump-half: 50;
    --ts-navbar-raised-radius: 18;
    --ts-navbar-disc-raised: 40;
    --ts-navbar-disc-filled: 32;
    /* what a bar floating at the bottom takes off the stack's foot and the hero's words: its gap + height + room (20 + 62 + 26), so the
       last block and the words stay clear of it and of the raised disc; a plain number for the hero's words (PoiCardSheetView), a length
       for the stack's padding (PoiCard.uss) */
    --ts-navbar-clear: 108;
    --ts-navbar-clearance: 108px;
    /* how far the hero must reach past the bar for the bar to count as lying on the picture (v5's 24), a plain number */
    --ts-navbar-hero-margin: 24;
    /* ...and its lengths: the items' side padding, an icon (and the raised disc's, Filled's), the words under an icon and words alone */
    --ts-navbar-pad: 10px;
    --ts-navbar-icon: 22px;
    --ts-navbar-disc-icon-raised: 20px;
    --ts-navbar-disc-icon-filled: 18px;
    --ts-navbar-label: 11px;
    --ts-navbar-label-text: 14px;
    /* minus --ts-space-3 (the gap a shown strip leaves above the first block, PoiCard.uss): the hero's picture starts flush under the strip.
       A USS length cannot be negated, so the pair is checked by PoiCardHeroSceneTests (the hero's top on the strip's bottom) */
    --ts-hero-strip-pull: -12px;
    --ts-media-height: 220px;
    --ts-thumb-size: 64px;
    --ts-grid-cell-height: 120px;
    --ts-print-offset: 10px;
    --ts-print-tilt: 3deg;
    --ts-spotlight-ring: 56px;
    --ts-spotlight-ring-width: 3px;
    --ts-spotlight-ring-radius: 28px;
    --ts-slider-line: 3px;
    --ts-dot-size: 8px;
    --ts-carousel-page: 300px;
    /* hotspot_image (Media.uss): a spot's numbered circle on the picture (its tap area is --ts-touch-target), the loupes'
       small ring on the picture, a loupe (a round close-up under it) and each one's radius (half its size) */
    --ts-hotspot-pin: 28px;
    --ts-hotspot-pin-radius: 14px;
    --ts-hotspot-mark: 16px;
    --ts-hotspot-mark-radius: 8px;
    --ts-loupe-size: 72px;
    --ts-loupe-radius: 36px;
    /* the arrow badge a spot that opens a block wears (step 10): a dark disc with a light edge over the picture, its radius half its size */
    --ts-hotspot-jump: 20px;
    --ts-hotspot-jump-radius: 10px;
    /* wall_locator (Visit.uss): the strip's height, a POI's dot, this POI's dot, the visitor's ring, a neighbour's chevron */
    --ts-locator-height: 24px;
    --ts-locator-dot: 8px;
    --ts-locator-self: 18px;
    --ts-locator-you: 16px;
    --ts-chevron: 10px;
    /* today_map (Visit.uss): a bridge side's small picture (the wall's, today's map) */
    --ts-today-thumb: 120px;
    /* related (Visit.uss): a carousel card's width and picture height */
    --ts-related-card: 140px;
    --ts-related-picture: 96px;
    /* nav_rails and nav_bento (Navigation.uss, _3.2 step 15a): a rail card's narrowest width (CardTrackFit stretches the cards to a whole
       number across the strip) and a bento tile's picture height */
    --ts-rail-card: 140px;
    --ts-bento-picture: 120px;
    /* the bento LAYOUT (Navigation.uss, CardBentoView, _3.2 step 15b): a tile's lowest height (its icon and words over its count, more
       than a touch target) and the gap between tiles, a plain number (panel units, no "px") read by CardBentoView on this card root */
    --ts-bento-tile-min-height: 64px;
    --ts-bento-gap: 8;
    /* ...and the narrowest a tile's list of block names is shown in (a plain number): a name cut to a few letters is noise, not a cue */
    --ts-bento-names-min-width: 140;
    /* The swipe tracks (timeline, related) with Peek Next Card: the slice of the next card shown at rest, read as a plain number (panel
       units, no "px": a CustomStyleProperty<float> does not parse a dimension) by CardTrackFit on this card root, like --ts-sheet-top-gap;
       small enough that two whole cards still fit the phone strip beside it */
    --ts-track-peek: 32;
    --ts-choice-border: 2px;
    --ts-choice-picture: 96px;
    --ts-vote-size: 64px;
    --ts-vote-glyph: 28px;
    /* collect (Play.uss): the stamp's round badge, and the thin progress bar under the count */
    --ts-stamp-size: 56px;
    --ts-stamp-radius: 28px;
    --ts-progress-height: 6px;
    /* dialogue (Stories.uss): the widest a line's bubble grows, as a share of the block */
    --ts-bubble-max-width: 85%;
    /* audio_guide (Guides.uss): the play / pause glyph inside its round button, the scrubber's thin track and its knob (and the
       knob's radius, half its size), the caption line's minimum height (so switching captions on does not move the block) */
    --ts-audio-glyph: 24px;
    --ts-audio-track: 4px;
    --ts-audio-knob: 16px;
    --ts-audio-knob-radius: 8px;
    --ts-audio-caption-min: 48px;
    /* video (Media.uss, step 9B): the round play button over a poster (and its radius, half its size), its glyph, the full-screen button's
       glyph, and a chapter button's widest (its name wraps under it past that) */
    --ts-video-overlay: 64px;
    --ts-video-overlay-radius: 32px;
    --ts-video-overlay-glyph: 28px;
    --ts-video-icon: 20px;
    --ts-video-chapter-max: 200px;
    /* the mini-player on the wall (PoiCard.uss): its distance from the bottom edge -- above the AR zoom buttons (ZoomControlView: 14 px from
       the edge, a 60 px strip) so it never covers them -- and how wide it grows */
    --ts-mini-bottom: 88px;
    --ts-mini-max-width: 480px;
    /* The floating slot above the sheet's top-right edge (_3.2 step 9, FloatingSlot): its gap above the sheet (read by C# as a plain number,
       panel units), and the edge of what floats over the camera image -- the FAB, the dial's and the arc's items, the placed-model chip: a
       light line round a dark surface, so it reads over a bright frame (the dark surface) AND a dark one (the light line) */
    --ts-float-gap: 8;
    --ts-float-edge-width: 2px;
    /* the dial's list (fab_dial): never wider than this */
    --ts-dial-max-width: 280px;
    /* the radial's arc (fab_radial, RadialMenuRule; plain numbers read by C#): one item's size -- its round button and its word under it,
       wide enough for the longest family word (Portuguese "Comunidade"), so two neighbours never overlap -- the smallest arc, and the dead
       zone a slide must leave before its direction counts (the button's own radius: the finger has left the button) */
    --ts-radial-item-width: 96;
    --ts-radial-item-height: 76;
    --ts-radial-min-radius: 96;
    --ts-radial-dead-zone: 24;
    /* the pages layout (step 14): how much of the NEXT page shows at the right edge of a page at rest -- the cue that the card turns
       sideways (a carousel's half-cut item); wide enough for its family icon (--ts-icon-size) with a margin either side. CardPagerView
       reads it back from the stack's content inset, so it lives only here */
    --ts-page-peek: 32px;
    /* the edge scrubber's dots (edge_scrubber, step 10): each dot sits in a --ts-touch-target square (its tap target, tiling the column)
       and is a small dark disc with a light edge (it floats over the content, light or dark) holding a disc of its family's colour; the
       family being read is a larger disc with an accent edge AND a larger colour disc -- never colour alone */
    --ts-edge-disc: 24px;
    --ts-edge-fill: 12px;
    --ts-edge-disc-current: 32px;
    --ts-edge-fill-current: 18px;
}
