/* The parts several block families share: the long text (CardTextView) and the icon set (CardIcons).
   Written ONLY with the --ts-* tokens of CardTokens.uss: no literal colour, size or radius here or in C# (_3.1 section 3,
   _3.3). UI Toolkit USS only: no web-CSS gap / cursor / calc (UI Toolkit drops them with a warning). */

/* ---- long text (CardTextView): paragraphs, glossary definition, lede, drop cap ---- */

.card-text__paragraph {
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    white-space: normal;
    margin: 0 0 var(--ts-space-3) 0;
    padding: 0;
}

.card-text__lede {
    font-size: var(--ts-size-lede);
}

.card-text__cap-row {
    flex-direction: row;
    align-items: flex-start;
}

.card-text__dropcap {
    font-size: var(--ts-size-dropcap);
    -unity-font-style: bold;
    color: var(--ts-accent-text);
    margin: 0 var(--ts-space-2) 0 0;
    padding: 0;
}

.card-text__beside-cap {
    flex-grow: 1;
    flex-shrink: 1;
}

/* A flowing drop cap's words beside the letter: the row's room, never its words' width (CardTextView cuts the words to it) */
.card-text__beside-cap--flow {
    flex-basis: 0;
}

.card-text__definition {
    background-color: var(--ts-surface-2);
    border-radius: var(--ts-radius-m);
    border-left-width: var(--ts-space-1);
    border-left-color: var(--ts-accent);
    padding: var(--ts-space-3);
    margin: 0 0 var(--ts-space-3) 0;
}

.card-text__definition-title {
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0 0 var(--ts-space-1) 0;
    padding: 0;
}

.card-text__definition-text {
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* ---- the card's icon set (CardIcons): a glyph box of --ts-icon-size holding four parts -- frame, bar a, bar b, dot --
   hidden until a key's class shows and places them. Strokes and colours are tokens; a look may resize the icon's root,
   the glyph stays centred at its own size ---- */

.card-icon {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.card-icon__glyph {
    width: var(--ts-icon-size);
    height: var(--ts-icon-size);
}

.card-icon__frame,
.card-icon__bar,
.card-icon__dot {
    position: absolute;
    display: none;
}

.card-icon__frame {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: var(--ts-icon-stroke);
    border-color: var(--ts-accent);
    border-radius: var(--ts-icon-size);
}

.card-icon__bar {
    background-color: var(--ts-accent);
}

.card-icon__dot {
    left: 50%;
    top: 50%;
    width: var(--ts-icon-dot);
    height: var(--ts-icon-dot);
    translate: -50% -50%;
    border-radius: var(--ts-icon-dot);
    background-color: var(--ts-accent);
}

/* show_on_wall: a target -- a ring with a dot in its centre */
.card-icon--show_on_wall .card-icon__frame,
.card-icon--show_on_wall .card-icon__dot {
    display: flex;
}

/* time: a clock -- a ring, a long hand up and a short hand right */
.card-icon--time .card-icon__frame,
.card-icon--time .card-icon__bar {
    display: flex;
}

.card-icon--time .card-icon__bar--a {
    left: 50%;
    top: 22%;
    width: var(--ts-icon-stroke);
    height: 30%;
    translate: -50% 0;
}

.card-icon--time .card-icon__bar--b {
    left: 50%;
    top: 50%;
    width: 26%;
    height: var(--ts-icon-stroke);
    translate: 0 -50%;
}

/* location: a pin -- a ring pulled to a point at the bottom, a dot inside */
.card-icon--location .card-icon__frame,
.card-icon--location .card-icon__dot {
    display: flex;
}

.card-icon--location .card-icon__frame {
    left: 12%;
    top: 4%;
    right: 12%;
    bottom: 20%;
    border-bottom-right-radius: 0;
    rotate: 45deg;
}

.card-icon--location .card-icon__dot {
    top: 42%;
}

/* info: an "i" in a ring -- a dot over a short bar */
.card-icon--info .card-icon__frame,
.card-icon--info .card-icon__bar--a,
.card-icon--info .card-icon__dot {
    display: flex;
}

.card-icon--info .card-icon__bar--a {
    left: 50%;
    top: 44%;
    width: var(--ts-icon-stroke);
    height: 32%;
    translate: -50% 0;
}

.card-icon--info .card-icon__dot {
    top: 28%;
    width: var(--ts-icon-stroke);
    height: var(--ts-icon-stroke);
}

/* ticket: a wide box with a tear-off line */
.card-icon--ticket .card-icon__frame,
.card-icon--ticket .card-icon__bar--a {
    display: flex;
}

.card-icon--ticket .card-icon__frame {
    top: 20%;
    bottom: 20%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--ticket .card-icon__bar--a {
    left: 64%;
    top: 20%;
    bottom: 20%;
    width: var(--ts-icon-stroke);
}

/* access: a doorway on its floor line, a knob on the door */
.card-icon--access .card-icon__frame,
.card-icon--access .card-icon__bar--b,
.card-icon--access .card-icon__dot {
    display: flex;
}

.card-icon--access .card-icon__frame {
    left: 20%;
    right: 20%;
    bottom: 0;
    border-bottom-width: 0;
    border-radius: var(--ts-icon-stroke) var(--ts-icon-stroke) 0 0;
}

.card-icon--access .card-icon__bar--b {
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--ts-icon-stroke);
}

.card-icon--access .card-icon__dot {
    left: 64%;
    top: 58%;
    width: var(--ts-icon-stroke);
    height: var(--ts-icon-stroke);
}

/* light: a bright point -- a dot with rays across it */
.card-icon--light .card-icon__bar,
.card-icon--light .card-icon__dot {
    display: flex;
}

.card-icon--light .card-icon__bar--a {
    left: 50%;
    top: 0;
    bottom: 0;
    width: var(--ts-icon-stroke);
    translate: -50% 0;
}

.card-icon--light .card-icon__bar--b {
    top: 50%;
    left: 0;
    right: 0;
    height: var(--ts-icon-stroke);
    translate: 0 -50%;
}

/* a sun: a large disc over the crossing, so only the bars' ends show, as rays */
.card-icon--light .card-icon__dot {
    width: 56%;
    height: 56%;
    border-radius: var(--ts-icon-size);
}

/* open_block: "go to that part of the card" -- a down arrow, the sign of an in-page jump: the frame is its head (a square that shows
   only its right and bottom sides, turned 45 degrees), bar a its shaft */
.card-icon--open_block .card-icon__frame,
.card-icon--open_block .card-icon__bar--a {
    display: flex;
}

.card-icon--open_block .card-icon__frame {
    left: 28%;
    right: 28%;
    top: 30%;
    bottom: 26%;
    border-top-width: 0;
    border-left-width: 0;
    border-radius: 0;
    rotate: 45deg;
}

.card-icon--open_block .card-icon__bar--a {
    left: 50%;
    top: 8%;
    height: 72%;
    width: var(--ts-icon-stroke);
    translate: -50% 0;
}

/* ---- the families' icons (_3.2 step 6, FamilyDefinition.IconKey): the same four parts. about, ar and visit reuse info,
   show_on_wall and location. A navigation element paints them in the family's colour (CardIcons.Tint) ---- */

/* picture (media): a framed picture -- a box, a sun (the dot) top right, a mountain (the two bars as a peak) inside */
.card-icon--picture .card-icon__frame,
.card-icon--picture .card-icon__bar,
.card-icon--picture .card-icon__dot {
    display: flex;
}

.card-icon--picture .card-icon__frame {
    top: 10%;
    bottom: 10%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--picture .card-icon__bar--a,
.card-icon--picture .card-icon__bar--b {
    top: 62%;
    width: 40%;
    height: var(--ts-icon-stroke);
}

.card-icon--picture .card-icon__bar--a {
    left: 12%;
    rotate: -45deg;
}

.card-icon--picture .card-icon__bar--b {
    left: 38%;
    rotate: 45deg;
}

.card-icon--picture .card-icon__dot {
    left: 72%;
    top: 34%;
}

/* listen (guides): headphones -- the frame is the band (a ring open at the bottom), the two bars the ear cups */
.card-icon--listen .card-icon__frame,
.card-icon--listen .card-icon__bar {
    display: flex;
}

.card-icon--listen .card-icon__frame {
    left: 8%;
    right: 8%;
    top: 6%;
    bottom: 34%;
    border-bottom-width: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.card-icon--listen .card-icon__bar--a,
.card-icon--listen .card-icon__bar--b {
    top: 52%;
    width: 24%;
    height: 40%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--listen .card-icon__bar--a {
    left: 4%;
}

.card-icon--listen .card-icon__bar--b {
    right: 4%;
}

/* book (stories): an open book -- a wide box with its spine (bar a) down the middle */
.card-icon--book .card-icon__frame,
.card-icon--book .card-icon__bar--a {
    display: flex;
}

.card-icon--book .card-icon__frame {
    top: 16%;
    bottom: 16%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--book .card-icon__bar--a {
    left: 50%;
    top: 16%;
    bottom: 16%;
    width: var(--ts-icon-stroke);
    translate: -50% 0;
}

/* play (play): a die -- a rounded square with one pip */
.card-icon--play .card-icon__frame,
.card-icon--play .card-icon__dot {
    display: flex;
}

.card-icon--play .card-icon__frame {
    left: 10%;
    right: 10%;
    top: 10%;
    bottom: 10%;
    border-radius: var(--ts-radius-s);
}

/* people (community): a person -- the dot is the head, the frame the shoulders (a ring cut to its top half) */
.card-icon--people .card-icon__frame,
.card-icon--people .card-icon__dot {
    display: flex;
}

.card-icon--people .card-icon__dot {
    top: 28%;
    width: 36%;
    height: 36%;
    border-radius: var(--ts-icon-size);
}

.card-icon--people .card-icon__frame {
    left: 8%;
    right: 8%;
    top: 62%;
    bottom: 0;
    border-bottom-width: 0;
    border-radius: var(--ts-icon-size) var(--ts-icon-size) 0 0;
}

/* sources (meta): a page of text -- a tall box with two lines on it */
.card-icon--sources .card-icon__frame,
.card-icon--sources .card-icon__bar {
    display: flex;
}

.card-icon--sources .card-icon__frame {
    left: 18%;
    right: 18%;
    top: 4%;
    bottom: 4%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--sources .card-icon__bar--a,
.card-icon--sources .card-icon__bar--b {
    left: 32%;
    right: 32%;
    height: var(--ts-icon-stroke);
}

.card-icon--sources .card-icon__bar--a {
    top: 36%;
}

.card-icon--sources .card-icon__bar--b {
    top: 58%;
}

/* more: three dots in a row -- "the rest of the list" (a bar's More slot, _3.2 step 7a): the dot in the middle, the two bars drawn as
   dots of the same size on either side */
.card-icon--more .card-icon__bar,
.card-icon--more .card-icon__dot {
    display: flex;
}

.card-icon--more .card-icon__bar {
    top: 50%;
    width: var(--ts-icon-dot);
    height: var(--ts-icon-dot);
    border-radius: var(--ts-icon-dot);
    translate: -50% -50%;
}

.card-icon--more .card-icon__bar--a {
    left: 16%;
}

.card-icon--more .card-icon__bar--b {
    left: 84%;
}

/* menu (the header's menu button, _3.2 step 8): three bars one above the other -- the two bars and the dot stretched into the middle one */
.card-icon--menu .card-icon__bar,
.card-icon--menu .card-icon__dot {
    display: flex;
}

.card-icon--menu .card-icon__bar,
.card-icon--menu .card-icon__dot {
    left: 10%;
    right: 10%;
    width: auto;
    height: var(--ts-icon-stroke);
    border-radius: var(--ts-icon-stroke);
    background-color: var(--ts-ink);
    translate: 0 -50%;
}

.card-icon--menu .card-icon__bar--a {
    top: 22%;
}

.card-icon--menu .card-icon__dot {
    top: 50%;
}

.card-icon--menu .card-icon__bar--b {
    top: 78%;
}

/* grid (the navigation family, _3.2 step 11a): a box split in four -- the frame as the box, bar a down its middle, bar b across it */
.card-icon--grid .card-icon__frame,
.card-icon--grid .card-icon__bar {
    display: flex;
}

.card-icon--grid .card-icon__frame {
    border-radius: var(--ts-icon-stroke);
}

.card-icon--grid .card-icon__bar--a {
    left: 50%;
    top: 0;
    bottom: 0;
    width: var(--ts-icon-stroke);
    height: auto;
    translate: -50% 0;
}

.card-icon--grid .card-icon__bar--b {
    top: 50%;
    left: 0;
    right: 0;
    width: auto;
    height: var(--ts-icon-stroke);
    translate: 0 -50%;
}

/* ---- the kinds' icons (_3.2 step 17a, BlockKindDefinition.IconKey): what a sibling chip of the full view shows. The same four parts.
   A kind whose meaning one of the icons above already draws (picture, listen, book, info...) reuses it ---- */

/* split (before / after, a comparison): a square box cut in two, the right half carrying a line */
.card-icon--split .card-icon__frame,
.card-icon--split .card-icon__bar {
    display: flex;
}

.card-icon--split .card-icon__frame {
    top: 10%;
    bottom: 10%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--split .card-icon__bar--a {
    left: 50%;
    top: 10%;
    bottom: 10%;
    width: var(--ts-icon-stroke);
    translate: -50% 0;
}

.card-icon--split .card-icon__bar--b {
    left: 60%;
    right: 20%;
    top: 50%;
    height: var(--ts-icon-stroke);
    translate: 0 -50%;
}

/* zoom (a picture to look closer at): a magnifier -- a ring up and to the left, its handle (bar a) running out of the lower right */
.card-icon--zoom .card-icon__frame,
.card-icon--zoom .card-icon__bar--a {
    display: flex;
}

.card-icon--zoom .card-icon__frame {
    right: 26%;
    bottom: 26%;
}

.card-icon--zoom .card-icon__bar--a {
    left: 62%;
    top: 82%;
    width: 38%;
    height: var(--ts-icon-stroke);
    translate: 0 -50%;
    rotate: 45deg;
}

/* cube (a 3D model): a box seen corner-on -- a square turned to a diamond with its seam (bar a) down from the middle */
.card-icon--cube .card-icon__frame,
.card-icon--cube .card-icon__bar--a {
    display: flex;
}

.card-icon--cube .card-icon__frame {
    left: 17%;
    right: 17%;
    top: 17%;
    bottom: 17%;
    border-radius: var(--ts-icon-stroke);
    rotate: 45deg;
}

.card-icon--cube .card-icon__bar--a {
    left: 50%;
    top: 50%;
    bottom: 6%;
    width: var(--ts-icon-stroke);
    translate: -50% 0;
}

/* panorama (a 360 view): a wide, flat strip -- a box, its horizon (bar a) across it and a sun (the dot) over the right */
.card-icon--panorama .card-icon__frame,
.card-icon--panorama .card-icon__bar--a,
.card-icon--panorama .card-icon__dot {
    display: flex;
}

.card-icon--panorama .card-icon__frame {
    top: 28%;
    bottom: 28%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--panorama .card-icon__bar--a {
    left: 12%;
    right: 12%;
    top: 60%;
    height: var(--ts-icon-stroke);
}

.card-icon--panorama .card-icon__dot {
    left: 70%;
    top: 44%;
}

/* video: a screen -- a wide box with a round button (the dot, a little larger than the others) in the middle */
.card-icon--video .card-icon__frame,
.card-icon--video .card-icon__dot {
    display: flex;
}

.card-icon--video .card-icon__frame {
    top: 18%;
    bottom: 18%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--video .card-icon__dot {
    width: 24%;
    height: 24%;
    border-radius: var(--ts-icon-size);
}

/* timeline: a line with one milestone standing on it -- bar a the line, bar b the stem, the dot its head */
.card-icon--timeline .card-icon__bar,
.card-icon--timeline .card-icon__dot {
    display: flex;
}

.card-icon--timeline .card-icon__bar--a {
    left: 6%;
    right: 6%;
    top: 68%;
    height: var(--ts-icon-stroke);
}

.card-icon--timeline .card-icon__bar--b {
    left: 50%;
    top: 34%;
    height: 34%;
    width: var(--ts-icon-stroke);
    translate: -50% 0;
}

.card-icon--timeline .card-icon__dot {
    top: 28%;
}

/* chat (a dialogue, a quote, feedback): a speech bubble -- a box with a line of words (bar b) and a tail (bar a) at its lower left */
.card-icon--chat .card-icon__frame,
.card-icon--chat .card-icon__bar {
    display: flex;
}

.card-icon--chat .card-icon__frame {
    top: 12%;
    bottom: 32%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--chat .card-icon__bar--a {
    left: 20%;
    top: 78%;
    width: 24%;
    height: var(--ts-icon-stroke);
    rotate: 55deg;
}

.card-icon--chat .card-icon__bar--b {
    left: 24%;
    right: 40%;
    top: 36%;
    height: var(--ts-icon-stroke);
}

/* chart (a poll): three upright bars of different heights -- bar a, the dot stretched into the middle one, bar b */
.card-icon--chart .card-icon__bar,
.card-icon--chart .card-icon__dot {
    display: flex;
}

.card-icon--chart .card-icon__bar,
.card-icon--chart .card-icon__dot {
    width: 18%;
    bottom: 8%;
    border-radius: var(--ts-icon-stroke);
}

.card-icon--chart .card-icon__bar--a {
    left: 14%;
    top: 38%;
}

.card-icon--chart .card-icon__dot {
    left: 50%;
    top: 14%;
    height: auto;
    translate: -50% 0;
}

.card-icon--chart .card-icon__bar--b {
    left: 68%;
    top: 58%;
}

/* ---- the pill button: ONE shape for every block that has one (actions' pill_row, story_chapters' Previous / Next).
   The radius is half the touch-target height (--ts-pill-radius), so short words give a stadium, not an egg ---- */

.card-pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: var(--ts-touch-target);
    min-width: var(--ts-pill-min-width);
    padding: 0 var(--ts-space-4);
    border-radius: var(--ts-pill-radius);
}

/* The generic COMPACT ROW (_3.2 step 12, CompactRowView): a block shown Expandable is one tappable line -- the family icon in its colour,
   the words over the format and minutes, a chevron -- and, open, a full-view button at its end. The slot's own heading steps aside: the
   row's words ARE the heading. Opened, the block's real view follows under the row inside the same slot. */
.card-block-slot--compact > .card-block-heading {
    display: none;
}

.card-compact {
    flex-direction: row;
    align-items: stretch;
    margin: 0 var(--ts-space-4);
    border-width: 0;
    border-bottom-width: var(--ts-line-width);
    border-color: var(--ts-line);
}

.card-compact--expanded {
    margin-bottom: var(--ts-space-3);
}

.card-compact__toggle {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: var(--ts-space-2) 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--ts-clear);
}

.card-compact__toggle:hover,
.card-compact__toggle:active,
.card-compact__full-view:hover,
.card-compact__full-view:active {
    background-color: var(--ts-clear);
}

.card-compact__icon {
    margin: 0 var(--ts-space-3) 0 0;
}

.card-compact__texts {
    flex-grow: 1;
    flex-shrink: 1;
    flex-direction: column;
    min-width: 0;
}

.card-compact__words {
    margin: 0;
    padding: 0;
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    -unity-text-align: middle-left;
}

/* a paragraph's first words are a teaser: one line, cut with an ellipsis (a heading is shown whole) */
.card-compact__words--teaser {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.card-compact__meta {
    margin: var(--ts-space-1) 0 0 0;
    padding: 0;
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.card-compact__chevron {
    flex-shrink: 0;
    width: var(--ts-icon-size);
    height: var(--ts-icon-size);
    margin: 0 0 0 var(--ts-space-3);
    color: var(--ts-ink-2);
}

.card-compact--expanded .card-compact__chevron {
    rotate: 180deg;
}

.card-compact__full-view {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    min-height: var(--ts-touch-target);
    margin: 0 0 0 var(--ts-space-2);
    padding: 0;
    border-width: 0;
    border-radius: var(--ts-radius-round);
    background-color: var(--ts-clear);
    align-items: center;
    justify-content: center;
}

.card-compact__full-view-glyph {
    width: var(--ts-icon-size);
    height: var(--ts-icon-size);
    color: var(--ts-accent-text);
}

/* The full view of ANY block (_3.2 step 12, BlockFullView): the takeover's page scrolls, and the block's view grows to the page's height,
   so a video or a 3D / 360 stage (their --full classes) fills it and a long text reads to its end */
.card-full-view {
    flex-grow: 1;
    margin-left: var(--ts-page-bleed);
    margin-right: var(--ts-page-bleed);
}

/* the scroll reaches the phone's edges (the page's own gutter taken back above), and the text keeps the gutter here -- a full-bleed
   element takes it back again. (The content is at least the viewport's height through BlockFullView's measured min-height, not here.) */
.card-full-view > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-left: var(--ts-space-4);
    padding-right: var(--ts-space-4);
}

.card-full-view__block {
    flex-grow: 1;
}

/* a SECTION in the full view (the bento layout, _3.2 step 15b): its blocks one under the other like the card's, each under its heading. A
   view bound for the full view grows to the page when it is alone on it (a video, a 3D / 360 stage); stacked here it keeps the card's
   media height */
.card-full-view__section {
    padding-top: var(--ts-space-3);
}

.card-full-view__section-block .card-video--full .card-video__surface,
.card-full-view__section-block .card-preview--full .card-preview__frame {
    height: var(--ts-media-height);
    flex-grow: 0;
}
