{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "310a4f4da3fb4cec88c48dd370c96f24",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SectionGlass (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -400.0,
            "y": 0.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "3522009f6914483fbc5868497cd75a6a"
        },
        {
            "m_Id": "651128e3a3f842fd894381e094acc1f2"
        },
        {
            "m_Id": "ad639da448e74561afae776c90e85a36"
        },
        {
            "m_Id": "b25c2c79e5ae4c1e9cfff8a9e0f934b3"
        },
        {
            "m_Id": "cd086f94284e43eabf89dd8cfbec104b"
        },
        {
            "m_Id": "d93540eb44204839a8e8901b067a603e"
        },
        {
            "m_Id": "02b8f5c9049d43eba35953be91fe7b20"
        },
        {
            "m_Id": "e9e43e9d35dd49c6a6ea66b1e85145d7"
        },
        {
            "m_Id": "56a822bae18547b793c48e91852dc299"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SectionGlass",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// The living glass of a section sheet (_3.3 P4.4c2, R11): the prototype's three soft lights (Main.dc.html .b1-.b3) drifting in every\n// band (~720 pt) of the sheet, so a tall sheet stays alive in its middle; each band starts its drift at its own phase. Layout UV runs\n// bottom-up: y is flipped into points from the top. Animate 0 = reduce motion: the band's still frame.\nfloat W = max(Size.x, 1.0);\nfloat H = max(Size.y, 1.0);\nfloat2 p = float2(UV.x * W, (1.0 - UV.y) * H);\nfloat bands = max(1.0, round(H / 720.0));\nfloat bandH = H / bands;\nfloat here = floor(p.y / bandH);\nfloat t = Clock * Animate;\nfloat3 C = float3(0, 0, 0);\nfloat A = 0.0;\n[unroll] for (int k = -1; k <= 1; k++)\n{\n    float c = here + k;\n    if (c < 0.0 || c >= bands) continue;\n    float top = c * bandH;\n    float phase = (c + Seed) * 3.7;\n    // b1: 300 pt, its box at (-70, -90) from the band's top-left; drifts (150, 170), grows to 1.25, 13 s each way\n    float e1 = 0.5 - 0.5 * cos(3.14159265 * (t + phase) / 13.0);\n    float2 c1 = float2(80.0, top + 60.0) + e1 * float2(150.0, 170.0);\n    float f1 = saturate(1.0 - distance(p, c1) / (144.0 * (1.0 + 0.25 * e1) + 26.0));\n    float a1 = Hue.a * f1 * f1 * (3.0 - 2.0 * f1);\n    C = Hue.rgb * a1 + C * (1.0 - a1); A = a1 + A * (1.0 - a1);\n    // b2: 280 pt, its box at (-90, -110) past the band's bottom-right; drifts (-140, -190), shrinks to 0.8, 17 s\n    float e2 = 0.5 - 0.5 * cos(3.14159265 * (t + phase) / 17.0);\n    float2 c2 = float2(W - 50.0, top + bandH - 30.0) + e2 * float2(-140.0, -190.0);\n    float f2 = saturate(1.0 - distance(p, c2) / (134.0 * (1.0 - 0.2 * e2) + 26.0));\n    float a2 = Hue2.a * f2 * f2 * (3.0 - 2.0 * f2);\n    C = Hue2.rgb * a2 + C * (1.0 - a2); A = a2 + A * (1.0 - a2);\n    // b3: 200 pt at 30 % / 40 % of the band, 0.7 strong; drifts (-90, 60), grows to 1.4, 15 s\n    float e3 = 0.5 - 0.5 * cos(3.14159265 * (t + phase) / 15.0);\n    float2 c3 = float2(0.3 * W + 100.0, top + 0.4 * bandH + 100.0) + e3 * float2(-90.0, 60.0);\n    float f3 = saturate(1.0 - distance(p, c3) / (96.0 * (1.0 + 0.4 * e3) + 26.0));\n    float a3 = 0.7 * Hue.a * f3 * f3 * (3.0 - 2.0 * f3);\n    C = Hue.rgb * a3 + C * (1.0 - a3); A = a3 + A * (1.0 - a3);\n}\nColor = A > 0.0001 ? C / A : float3(0, 0, 0);\nAlpha = A;\n"
}

