/* The POI Detail Card's CONTAINER (PoiCardSheetView, BlockStackView): the layer, the sheet, its grabber and X, the
   pinned header slot, the scrolling stack, the footer and the rule every block shares. The blocks' own looks are in
   CardParts.uss (parts several families use) and Blocks/<Family>/<Family>.uss; the host adds them after this file.
   Written ONLY with the --ts-* tokens of CardTokens.uss: no literal colour, size or radius here or in C# (_3.1 section 3,
   _3.3). UI Toolkit USS only: no web-CSS gap / cursor / calc (UI Toolkit drops them with a warning). */

/* The full area the sheet rests at the bottom of; lets taps through to the camera view */
.poi-card-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* The sheet: its height is its stop (set by the view), animated between stops */
.poi-card {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    /* no ground of its own (_3.3 P4.4b): the chrome rows are opaque (--ts-bar), the stack between them is the glass */
    background-color: var(--ts-clear);
    border-top-left-radius: var(--ts-radius-l);
    border-top-right-radius: var(--ts-radius-l);
    border-top-width: var(--ts-line-width);
    border-top-color: var(--ts-line);
    transition-property: height;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

/* While a finger drags the sheet it follows the finger, no animation */
.poi-card--dragging {
    transition-duration: 0s;
}

/* The grab zone at the top: a full-width, finger-sized drag target with a small bar in its middle */
.poi-card__handle {
    /* FLOATING over the stack since _3.3 S4a's review (PoiCardSheetView brings the chrome to the front): the grab row is a strip at the
       sheet's top (clear over the hero's picture, like the bar), the grabber hanging in it; the bar overlaps it */
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--ts-handle-height);
    /* clear: the chrome band under it carries the ground (after the hero), the picture shows through it over the hero */
    background-color: var(--ts-clear);
    align-items: center;
    justify-content: flex-start;
    padding-top: var(--ts-space-1);
}

.poi-card__grabber {
    width: var(--ts-grabber-width);
    height: var(--ts-grabber-height);
    border-radius: var(--ts-grabber-height);
    background-color: var(--ts-ink-3);
}

/* The chrome (_3.3 S4 third round, the premium target v5): the X at the bar's LEFT, settings at its right, the title centred between
   them. Each button is a whole touch target, clear; the visible part is a small glass DISC with a thin mark (.poi-card__mark-disc) */
.poi-card__close {
    position: absolute;
    top: var(--ts-bar-top);
    left: var(--ts-chrome-inset);
    width: var(--ts-bar-height);
    height: var(--ts-bar-height);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--ts-clear);
    border-width: 0;
    border-radius: var(--ts-touch-target);
}

.poi-card__close:hover,
.poi-card__close:active,
.poi-card__settings:hover,
.poi-card__settings:active {
    background-color: var(--ts-clear);
}

/* after the hero: v5's light glass (smoked in dark), a hairline round it, the mark in the card's ink */
.poi-card__mark-disc {
    width: var(--ts-chrome-disc);
    height: var(--ts-chrome-disc);
    border-radius: var(--ts-chrome-disc-radius);
    border-width: var(--ts-line-width);
    border-color: var(--ts-hair);
    background-color: var(--ts-chrome-glass);
    align-items: center;
    justify-content: center;
    transition-property: background-color, border-color;
    transition-duration: var(--ts-duration);
}

.poi-card__mark {
    width: var(--ts-chrome-mark);
    height: var(--ts-chrome-mark);
    color: var(--ts-ink);
}

/* over the hero's picture: white marks on a DARK glass disc with v5's light rim -- the disc, not the picture, is what a mark reads
   against (no backdrop blur in UI Toolkit: a white mark keeps 7:1 over a white sky only on a dark ground, measured on the render) */
.poi-card--bars-on-hero .poi-card__mark-disc {
    background-color: var(--ts-chrome-glass-hero);
    border-color: var(--ts-chrome-line-hero);
}

.poi-card--bars-on-hero .poi-card__mark {
    color: var(--ts-on-scrim);
}

/* The bars over the hero's picture (BlockStackView.BarsOnHeroClass): the marks turn white over a soft dark fade from the sheet's top --
   the picture under them can be anything, the fade keeps them readable without a box */
.poi-card__top-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--ts-top-shade-height);
    background-image: url("top_shade.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--ts-top-shade);
    border-top-left-radius: var(--ts-radius-l);
    border-top-right-radius: var(--ts-radius-l);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--ts-duration);
}

.poi-card--bars-on-hero .poi-card__top-shade {
    opacity: 1;
}

/* The chrome band (_3.3 S4 third round, v6): what the whole chrome row -- the grab row, the X, the title, settings -- sits on wherever the
   bars are not on the hero's picture (Peek over the camera, a plate header, the blocks scrolling under); the card's Top Band picks it
   (PoiCardSheetView). FADE, the default: the sheet's own colour, solid through the row, then fading to nothing over a short fade
   (PoiCardSheetView.TopFade: the Look Kit's Fade in --ts-top-fade, --ts-top-fade-solid / -height) -- the content dissolves under it, no
   edge, no blur. No block text reads behind the marks and the title,
   which keep 7:1 (PoiCardChromeMarksSceneTests). Gone over the picture */
.poi-card__chrome-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--ts-top-fade-height);
    border-top-left-radius: var(--ts-radius-l);
    border-top-right-radius: var(--ts-radius-l);
    opacity: 1;
    transition-property: opacity;
    transition-duration: var(--ts-duration);
}

/* GLASS (Top Band = Glass): a dense glass band as tall as the row, a hairline at its foot */
.poi-card__chrome-band--glass {
    height: var(--ts-chrome-band-height);
    background-color: var(--ts-chrome-band);
    border-bottom-width: var(--ts-line-width);
    border-color: var(--ts-hair);
}

.poi-card--bars-on-hero .poi-card__chrome-band {
    opacity: 0;
}

.poi-card--bars-on-hero .poi-card__close-bar,
.poi-card--bars-on-hero .poi-card__menu-button .card-icon__bar,
.poi-card--bars-on-hero .poi-card__menu-button .card-icon__dot {
    background-color: var(--ts-on-scrim);
}

.poi-card--bars-on-hero .poi-card__grabber {
    background-color: var(--ts-on-scrim);
}

/* The card's settings (P4.4b; the premium target's "sliders" mark): the same disc as the X, at the bar's right */
.poi-card__settings {
    position: absolute;
    top: var(--ts-bar-top);
    right: var(--ts-chrome-inset);
    width: var(--ts-bar-height);
    height: var(--ts-bar-height);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--ts-clear);
    border-width: 0;
    border-radius: var(--ts-touch-target);
}

/* The menu button (_3.2 step 8): a round button with three bars, left of the settings disc; it is there only while the card has a Menu */
.poi-card__menu-button {
    position: absolute;
    top: var(--ts-bar-top);
    right: var(--ts-menu-button-right);
    width: var(--ts-bar-height);
    height: var(--ts-bar-height);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--ts-clear);
    border-color: var(--ts-line);
    border-width: 0;
    border-radius: var(--ts-touch-target);
}

/* the title stays centred: with the Menu's button the bar keeps the same room at both ends */
.poi-card--has-menu .poi-card__header {
    padding-left: var(--ts-header-end-with-menu);
    padding-right: var(--ts-header-end-with-menu);
}

/* ---- the visitor's settings (_3.3 P4.4b, CardVisitorSettingsView): a small panel hanging from the Aa button, in the overlay layer ---- */

/* a popover's scrim catches the tap beside it but stays clear: the card behind shows what a pick changes */
.card-menu--popover > .card-menu__scrim {
    background-color: var(--ts-clear);
}

.card-settings {
    position: absolute;
    width: var(--ts-settings-width);
    padding: var(--ts-space-4);
    background-color: var(--ts-surface);
    border-width: var(--ts-line-width);
    border-color: var(--ts-metal-edge);
    border-radius: var(--ts-radius-l);
}

.card-settings__title {
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink-2);
}

.card-settings__group {
    margin-top: var(--ts-space-3);
}

.card-settings__group-title {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    margin-bottom: var(--ts-space-1);
}

.card-settings__row {
    flex-direction: row;
}

.card-settings__choice {
    flex-grow: 1;
    flex-basis: 0;
    height: var(--ts-touch-target);
    margin: 0 var(--ts-space-1) 0 0;
    font-size: var(--ts-size-body);
    color: var(--ts-ink);
    background-color: var(--ts-surface-2);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-touch-target);
}

/* the current choice: an outline in the accent, never a fill (one accent fill per screen, D5) */
.card-settings__choice--chosen {
    -unity-font-style: bold;
    color: var(--ts-accent-text);
    background-color: var(--ts-surface);
    border-color: var(--ts-accent);
    border-width: var(--ts-chosen-border);
}

/* The X: two bars crossed at the button's centre (no text glyph, so no visitor string) */
.poi-card__close-bar {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--ts-icon-size);
    height: var(--ts-icon-stroke);
    border-radius: var(--ts-icon-stroke);
    translate: -50% -50%;
    background-color: var(--ts-ink);
}

.poi-card__close-bar--a {
    rotate: 45deg;
}

.poi-card__close-bar--b {
    rotate: -45deg;
}

/* The pinned header slot (never scrolls): the BAR -- one row as tall as the round buttons and lined up with them, so the peek stop ends
   where the buttons do and nothing it holds can move a stop (_3.3 P4.4a). FLOATING and slim since S4a's review: clear over the hero's
   picture (BarsOnHeroClass), on the chrome band anywhere else; its title bare on the band once it shows (v5) */
.poi-card__header {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--ts-bar-top);
    /* clear: the chrome band behind the row is its ground */
    background-color: var(--ts-clear);
    flex-direction: row;
    justify-content: center;
    height: var(--ts-bar-height);
    padding-left: var(--ts-header-end);
    padding-right: var(--ts-header-end);
}

/* The mini-player on the wall (MiniPlayerView): a small bar at the bottom while audio started in a card plays on after it closed --
   a round play / pause button and, tappable, the audio's title and time (a tap reopens its card), a stop button (9A-fix: ends the
   audio and sends the bar away), a thin progress line under them */
.poi-card-mini {
    position: absolute;
    left: var(--ts-space-4);
    right: var(--ts-space-4);
    bottom: var(--ts-mini-bottom);
    max-width: var(--ts-mini-max-width);
    flex-direction: row;
    align-items: center;
    padding: var(--ts-space-1);
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface);
}

.poi-card-mini__play {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-accent);
}

.poi-card-mini__stop {
    flex-shrink: 0;
    width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0 0 0 var(--ts-space-1);
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: var(--ts-line-width);
    border-color: var(--ts-line);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-clear);
}

/* the audio glyph is dark ink for the accent play button; on the bar's own surface the stop square needs the bar's ink */
.poi-card-mini__stop .card-audio__glyph {
    color: var(--ts-ink);
}

.poi-card-mini__open {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: var(--ts-touch-target);
    margin: 0 0 0 var(--ts-space-2);
    padding: 0 var(--ts-space-3);
    align-items: flex-start;
    justify-content: center;
    border-width: 0;
    background-color: var(--ts-clear);
}

.poi-card-mini__title {
    font-size: var(--ts-size-body);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin: 0;
    padding: 0;
}

.poi-card-mini__time {
    font-size: var(--ts-size-caption);
    color: var(--ts-ink-2);
    margin: 0;
    padding: 0;
}

.poi-card-mini__bar {
    position: absolute;
    left: var(--ts-space-4);
    right: var(--ts-space-4);
    bottom: 0;
    height: var(--ts-audio-track);
    border-radius: var(--ts-audio-track);
    background-color: var(--ts-ink-3);
}

/* The floating slot (FloatingSlot, _3.2 step 9): a row in the card layer just above the sheet's top-right edge at every stop -- the
   placed-model chip, then the Floating Button element at the right end. Its bottom is set by the view (FloatingSlotRule) */
.poi-card-floating {
    position: absolute;
    left: var(--ts-space-4);
    right: var(--ts-space-4);
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}

.poi-card-floating__element {
    flex-shrink: 0;
    margin-left: var(--ts-space-2);
}

/* The placed-model chip (PlacedModelChipView): a dark pill with a light edge (it floats over the camera image, bright or dark) -- its words,
   and on the card that placed the model an outlined Remove. Its words wrap to a second line rather than being cut */
.poi-card-chip {
    flex-shrink: 1;
    min-width: 0;
    flex-direction: row;
    align-items: center;
    padding: 0 var(--ts-space-1);
    border-width: var(--ts-float-edge-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-surface);
}

.poi-card-chip__words {
    flex-shrink: 1;
    min-width: 0;
    min-height: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-2);
    align-items: flex-start;
    justify-content: center;
    border-width: 0;
    background-color: var(--ts-clear);
}

.poi-card-chip__text {
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0;
    padding: 0;
}

/* on another point's card the words open the card that placed the model: they read as a link (accent words) */
.poi-card-chip__words--link .poi-card-chip__text {
    color: var(--ts-accent-text);
}

.poi-card-chip__remove {
    flex-shrink: 0;
    min-width: var(--ts-touch-target);
    height: var(--ts-touch-target);
    margin: 0;
    padding: 0 var(--ts-space-3);
    align-items: center;
    justify-content: center;
    border-width: var(--ts-line-width);
    border-color: var(--ts-ink-3);
    border-radius: var(--ts-pill-radius);
    background-color: var(--ts-clear);
}

.poi-card-chip__remove-label {
    font-size: var(--ts-size-caption);
    -unity-font-style: bold;
    color: var(--ts-ink);
    margin: 0;
    padding: 0;
}

.poi-card-mini__fill {
    width: 0;
    height: var(--ts-audio-track);
    border-radius: var(--ts-audio-track);
    background-color: var(--ts-accent);
}

/* The top navigation slot (_3.2 step 5a, NavSlots): between the header and the stack, never scrolling; opaque, with a line under it so
   the blocks scrolling past read as passing under it. Its element's own look is Navigation.uss */
.poi-card__nav-top {
    /* FLOATING (S4a review): a pill under the bar, its tabs inside -- out of the flow, so its coming never moves the stack. Opaque (the
       bar's ground): the older elements' words keep their contrast; the Navigation Bar draws its own fill (.poi-card__nav-top--bar) */
    position: absolute;
    left: var(--ts-space-3);
    right: var(--ts-space-3);
    top: var(--ts-nav-float-top);
    background-color: var(--ts-bar);
    border-width: var(--ts-line-width);
    border-color: var(--ts-glass-edge);
    border-radius: var(--ts-radius-xl);
    overflow: hidden;
    transition-property: opacity, translate;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

/* The strip hidden by CardChromeRule (CardChromeView): out of the flow, so the stack gets its room, but still laid out, so its height
   stays known for the next decision */
/* holding the Navigation Bar (NavBarView): the host is clear and full width -- the bar draws its own shape, fill and margins, and its
   raised indicator may rise past the host's top */
.poi-card__nav-top--bar {
    left: 0;
    right: 0;
    background-color: var(--ts-clear);
    border-width: 0;
    border-radius: 0;
    overflow: visible;
}

/* The Navigation Bar at the bottom (v5): FLOATING over the stack's foot, right above the sticky footer (or the sheet's foot without one) --
   out of the flow, so the stack runs under it and over the hero it lies on the picture; the stack keeps its end clear of it */
/* (two classes: it must win over .poi-card__nav-bottom's opaque ground, declared further down) */
.poi-card__nav-bottom.poi-card__nav-bottom--bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    background-color: var(--ts-clear);
    border-top-width: 0;
}

.poi-card--bar-bottom .poi-card__stack .unity-scroll-view__content-container {
    padding-bottom: var(--ts-navbar-clearance);
}

.poi-card__nav-top--hidden {
    opacity: 0;
    visibility: hidden;
}

/* The pages layout (CardPagerView, step 14): the page is inset by the peek, where the next page's cue shows; while a released page slides
   to its place (or back), the scroll and its cues glide over --ts-duration (CardPagerView turns the page when the slide is over) */
.poi-card--paged .poi-card__stack .unity-scroll-view__content-container {
    padding-right: var(--ts-page-peek);
}

.card-pager--settling .poi-card__stack,
.card-pager--settling .card-pager__peek {
    transition-property: translate, left;
    transition-duration: var(--ts-duration);
    transition-timing-function: ease-in-out;
}

.poi-card__stack {
    /* the sheet's ground between the blocks: tinted translucent glass (_3.3 R11, R12.5), clearer at the top -- card_glass.png is the
       vertical alpha ramp, --ts-glass-ground its tint (light clear, dark smoked); USS 6.3 has no gradients */
    background-image: url("card_glass.png");
    -unity-background-image-tint-color: var(--ts-glass-ground);
    -unity-background-scale-mode: stretch-to-fill;
    flex-grow: 1;
    flex-shrink: 1;
    /* the scroll gives up its space first, so a pinned footer stays inside the card at every stop */
    min-height: 0;
}

/* ---- every content block ---- */

.card-block {
    margin: 0 var(--ts-space-4);
}

/* One block's place in the stack (BlockStackView): its heading, the block, and under it the ONE gap between blocks.
   Blocks have no bottom margin of their own, so every gap is this token. */
.card-block-slot {
    margin-bottom: var(--ts-block-gap);
}

/* ---- the block frame (_3.3 R13.1, R12.5, P4.4b; BlockFrame): a block of the scroll is an opaque surface inside a metal rim ----
   The slot carries the surface and the rim's OUTER line (dark metal in light, light metal in dark: the edge against the glass over a
   sunny wall, measured by ThemeFrameSceneTests); the rim part the inner band, the shadow part the elevation (light only: its tint is
   transparent in dark, where the surface tone gives the depth, R8 S7). Padding 16 on the 8 grid. */
.card-block-slot--framed {
    margin: 0 var(--ts-space-4) var(--ts-block-gap) var(--ts-space-4);
    padding: var(--ts-space-4);
    background-color: var(--ts-surface);
    border-width: var(--ts-line-width);
    border-color: var(--ts-metal-edge);
    border-radius: var(--ts-radius-l);
}

/* inside the frame its padding is the block's margin */
.card-block-slot--framed > .card-block {
    margin: 0;
}

.card-block-slot--framed > .card-block-heading {
    margin-left: 0;
    margin-right: 0;
}

/* a picture, carousel, strip or track (BlockFrame.BleedClass) runs edge to edge to the frame's inner edge: words keep the padding,
   media gets the width back. --ts-frame-bleed is minus the frame's side padding (a USS length cannot be negated: the pair is checked
   by ThemeFrameSceneTests) */
.card-block-slot--framed .card-block-bleed {
    margin-left: var(--ts-frame-bleed);
    margin-right: var(--ts-frame-bleed);
}

.card-block-frame__shadow,
.card-block-frame__rim,
.card-block-frame__groove {
    display: none;
    position: absolute;
}

/* the metal band just inside the outer line (_3.3 S4a): light where the light falls (top, left), shade opposite -- a bevel, as wide as
   the mode's --ts-rim-band (3 on light metal, where the moving light rides it; a hairline on dark) */
.card-block-slot--framed > .card-block-frame__rim {
    display: flex;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: var(--ts-rim-band);
    border-top-color: var(--ts-metal-hi);
    border-left-color: var(--ts-metal-hi);
    border-bottom-color: var(--ts-metal-lo);
    border-right-color: var(--ts-metal-lo);
    border-radius: var(--ts-radius-l);
}

/* the groove: one thin metal line just inside the band, against the surface -- the brushed bands (clear on dark metal) */
.card-block-slot--framed > .card-block-frame__groove {
    display: flex;
    left: var(--ts-rim-band);
    top: var(--ts-rim-band);
    right: var(--ts-rim-band);
    bottom: var(--ts-rim-band);
    border-width: var(--ts-line-width);
    border-color: var(--ts-metal-groove);
    border-radius: var(--ts-frame-groove-radius);
}

/* the shadow: an outer-only 9-slice (card_block_shadow.png: transparent over the block, so it never greys the surface) laid around
   the slot; its corners are sliced at the texture's margin + the block radius */
.card-block-slot--framed > .card-block-frame__shadow {
    display: flex;
    left: var(--ts-frame-shadow-out);
    top: var(--ts-frame-shadow-out);
    right: var(--ts-frame-shadow-out);
    bottom: var(--ts-frame-shadow-out);
    background-image: url("card_block_shadow.png");
    -unity-background-image-tint-color: var(--ts-elevation-1);
    -unity-slice-left: var(--ts-frame-shadow-slice);
    -unity-slice-top: var(--ts-frame-shadow-slice);
    -unity-slice-right: var(--ts-frame-shadow-slice);
    -unity-slice-bottom: var(--ts-frame-shadow-slice);
}

/* featured: a deeper shadow and a larger title (the 1-2 blocks a wall pushes) */
.card-block-slot--featured > .card-block-frame__shadow {
    -unity-background-image-tint-color: var(--ts-elevation-2);
}

.card-block-slot--featured > .card-block-heading {
    font-size: var(--ts-size-title);
}

/* quiet: the hairline edge alone -- no rim band, no shadow -- and a smaller title (meta blocks such as sources) */
.card-block-slot--quiet > .card-block-frame__rim,
.card-block-slot--quiet > .card-block-frame__groove,
.card-block-slot--quiet > .card-block-frame__shadow {
    display: none;
}

.card-block-slot--quiet > .card-block-heading {
    font-size: var(--ts-size-body);
}

/* ---- the section sheets (_3.3 P4.4c1, R11, R10.7; SectionSheets): the scroll's blocks of one family on ONE sheet of tinted glass ----
   The sheet's tint is painted inline (the theme's --ts-family-<k>-glass, NavTint), its edges here. Padding: 16 at the sides -- the frame's
   old side margin, so a block keeps its width (358 at 390) and no track, rail or bento fit moves; 16 at the top over the opener; at the
   foot the block gap, so the space from a section's last block to the next opener is twice the gap (24 + 24 - 16 + 16, R10.7). */
.card-section {
    padding: var(--ts-space-4) var(--ts-space-4) var(--ts-block-gap) var(--ts-space-4);
    border-radius: var(--ts-radius-xl);
}

/* the sheet's edge -- a light line, lit along the top -- drawn by a part laid over the sheet, so the line takes none of the width the
   blocks get (a border on the sheet itself cost them 2 px: The Lamp's vertical timeline wrapped one more line) */
.card-section__edge {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: var(--ts-line-width);
    border-color: var(--ts-glass-edge);
    border-top-color: var(--ts-glass-hi);
    border-radius: var(--ts-radius-xl);
}

/* the living glass (_3.3 P4.4c2, CardLight): the soft lights drifting inside the sheet, a SIBLING layer under the edge, the opener and
   the blocks (a material on the sheet itself would paint its children too, R8 S4). Its material paints every pixel: the background
   colour only makes UI Toolkit draw the layer at all (a transparent element draws nothing) */
.card-section__light {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--ts-radius-xl);
    background-color: var(--ts-surface);
}

/* the navigation family's run is no sheet: no glass, no light */
.card-section--bare > .card-section__light {
    display: none;
}

/* the rim light (RimLightView): ONE layer in the block being read, behind its heading and content, INSIDE the rim's outer line -- that
   line is the block's measured edge against the glass over a sunny wall (>= 3:1, ThemeFrameSceneTests): a white light over it took the
   edge to 1.6:1. Its material draws only the band just inside it (the rim's inner band). It fades out of one block and into the next */
.card-rim-light {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--ts-surface);
    transition-property: opacity;
    transition-duration: var(--ts-duration);
    transition-timing-function: ease-in-out;
}

/* laid over the sheet before it: it starts above that sheet's foot, and its shadow falls up over it */
.card-section--over {
    margin-top: var(--ts-section-overlap);
}

/* the same family again after a set-aside run (tabs / pages): one chapter, no second opener */
.card-section--continues {
    padding-top: 0;
}

/* the navigation family's blocks: no sheet (SectionSheets paints it no tint), the plain ground */
.card-section--bare {
    padding-top: 0;
    padding-bottom: 0;
}

.card-section--bare > .card-section__edge {
    display: none;
}

/* inside a sheet its padding is a block's side margin */
.card-section > .card-block-slot--framed {
    margin-left: 0;
    margin-right: 0;
}

/* the shadow a sheet LAID OVER another casts up over it: the blocks' outer-only 9-slice, reaching out above and at the sides (off the
   screen) but never below the sheet's own foot -- a part reaching past the last sheet grew the scroll's real range by 16 px past the
   content's layout height (PoiCardNavSceneTests: the drags ended 16 px past NavScrollRule.Range); its foot band sits under the next
   sheet's overlap. The first sheet casts none: the glass starts below the hero, never shadows it (R11 v4) */
.card-section__shadow {
    display: none;
    position: absolute;
    left: var(--ts-frame-shadow-out);
    top: var(--ts-frame-shadow-out);
    right: var(--ts-frame-shadow-out);
    bottom: 0;
    background-image: url("card_block_shadow.png");
    -unity-background-image-tint-color: var(--ts-glass-shadow);
    -unity-slice-left: var(--ts-frame-shadow-slice);
    -unity-slice-top: var(--ts-frame-shadow-slice);
    -unity-slice-right: var(--ts-frame-shadow-slice);
    -unity-slice-bottom: var(--ts-frame-shadow-slice);
}

.card-section--over > .card-section__shadow {
    display: flex;
}

/* the opener (SectionOpenerView): the family's FILLED pill (icon, name in the display face, meta) and a full-width line in its colour;
   the colours are painted inline (the family's fill and the ink on it) */
.card-section-opener {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--ts-space-3);
}

.card-section-opener__pill {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: var(--ts-space-2) var(--ts-space-4) var(--ts-space-2) var(--ts-space-3);
    border-radius: var(--ts-pill-radius);
}

.card-section-opener__icon {
    margin-right: var(--ts-space-2);
}

.card-section-opener__name {
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    margin: 0 var(--ts-space-2) 0 0;
    padding: 0;
}

.card-section-opener__meta {
    font-size: var(--ts-size-caption);
    margin: 0;
    padding: 0;
}

.card-section-opener__line {
    flex-grow: 1;
    height: var(--ts-section-line);
    margin-left: var(--ts-space-3);
}

/* the tabs layout's opener (no words: the strip names the section): the line alone, the sheet's full width */
.card-section-opener--line-only > .card-section-opener__line {
    margin-left: 0;
}

/* The common heading every kind may have (BlockKindDefinition.HeadingField): one look for every block */
.card-block-heading {
    font-size: var(--ts-size-heading);
    -unity-font-style: bold;
    color: var(--ts-ink);
    white-space: normal;
    margin: 0 var(--ts-space-4) var(--ts-space-2) var(--ts-space-4);
    padding: 0;
}

.card-block-heading--empty {
    display: none;
}

/* A block that draws its own title (a composed kind, _3.3 S2b): its title IS the heading, so the slot's words are not drawn twice */
.card-block-heading--own-title {
    display: none;
}

/* The bar holds the title alone (_3.3 P4.4a): a heading above it would make it two rows -- the hero's eyebrow is that line now */
.poi-card__header .card-block-heading {
    display: none;
}

.poi-card__header .card-block-slot {
    flex-grow: 1;
    min-width: 0;
    justify-content: center;
}

.poi-card__header .card-block-slot,
.poi-card__footer .card-block-slot {
    margin-bottom: 0;
}

/* ---- the bottom area (_3.2 step 7a, PoiCardSheetView.BottomArea): under the scrolling blocks, the footer (sticky actions) and under it
   the bottom navigation slot -- ONE part of the chrome, which slides as one ---- */

.poi-card__bottom {
    flex-shrink: 0;
    transition-property: translate;
    transition-duration: var(--ts-duration);
    transition-timing-function: var(--ts-ease);
}

.poi-card__footer {
    flex-shrink: 0;
    background-color: var(--ts-bar);
}

/* The bottom navigation slot (NavSlots): opaque, with a line above it so the content never reads as running into the bar. Its element's
   own look is Navigation.uss */
.poi-card__nav-bottom {
    flex-shrink: 0;
    background-color: var(--ts-surface);
    border-top-width: var(--ts-line-width);
    border-color: var(--ts-line);
}

/* The edge slot's host (NavSlots, step 10): INSIDE the stack's viewport, absolute over its right edge, one touch target wide -- so its box
   is exactly what the visitor can scroll and it takes no room in the flow. It never takes a finger itself (NavSlots), its element does */
.poi-card__nav-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: var(--ts-touch-target);
}

/* The bottom area hidden by CardChromeRule (CardChromeView: at peek, while the reader moves down, where the stop has no room for it):
   out of the flow -- the stack takes its room at once -- and slid below the sheet's bottom edge, which clips it (.poi-card overflow) */
.poi-card__bottom--hidden {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    translate: 0 100%;
}

/* The bar alone hidden inside a shown area (Show Navigation At = Full Only, at Half): out of the flow but still laid out, like the strip */
.poi-card__nav-bottom--hidden {
    position: absolute;
    left: 0;
    right: 0;
    visibility: hidden;
}

/* the footer while the hero shows its action (_3.3 P4.4a): the bar keeps its place, the footer its measured height */
.poi-card__footer--hidden {
    position: absolute;
    left: 0;
    right: 0;
    visibility: hidden;
}

/* Reduce motion: the bottom area jumps */
.poi-card--chrome-instant .poi-card__bottom {
    transition-duration: 0s;
}

/* ---- OPEN sections (_3.3 fourth round, v6's Sections; Look Blocks = Open: SectionSheets + OpenSectionView) ----
   No glass, no frame, no opener: the stack on the dense open ground; each section its edge (divider, start), its tinted ground (the Look
   Kit's Fade, painted inline), its eyebrow, then its blocks open -- the side gutter v6's 24, a hairline and space between two blocks.
   Off an open sheet the open parts never draw */
.poi-card__stack--open {
    background-image: none;
    background-color: var(--ts-sheet-open);
}

.card-open-section__ground,
.card-open-section__edge,
.card-open-section__eyebrow {
    display: none;
}

.card-section--open {
    padding: 0 0 var(--ts-open-section-foot) 0;
    margin-top: 0;
    border-radius: 0;
}

.card-section--open > .card-section__shadow,
.card-section--open > .card-section__light,
.card-section--open > .card-section__edge,
.card-section--open > .card-section-opener {
    display: none;
}

.card-section--open > .card-open-section__ground {
    display: flex;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.card-section--open > .card-open-section__edge {
    display: flex;
    flex-direction: column;
}

.card-section--open > .card-open-section__eyebrow {
    display: flex;
    margin: var(--ts-open-section-top) var(--ts-open-gutter) 0 var(--ts-open-gutter);
}

.card-section--open-first > .card-open-section__eyebrow {
    margin-top: var(--ts-open-section-top-first);
}

.card-open-section__divider--hairline {
    height: var(--ts-line-width);
    margin: 0 var(--ts-open-gutter);
}

.card-open-section__divider--ornament {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: var(--ts-space-1) 0 var(--ts-space-2) 0;
}

.card-open-section__divider-line {
    width: var(--ts-open-ornament-line);
    height: var(--ts-line-width);
    margin: 0 var(--ts-space-3);
}

.card-open-section__divider-tiles {
    height: var(--ts-open-tile);
    flex-grow: 1;
}

.card-open-section__divider--ornament > .card-open-section__divider-tiles {
    width: var(--ts-open-ornament-tile);
    height: var(--ts-open-ornament-tile);
    flex-grow: 0;
}

.card-open-section__divider-strip {
    flex-grow: 1;
}

.card-open-section__gap {
    height: var(--ts-open-divider-gap);
}

.card-open-section__start-tiles {
    height: var(--ts-open-tile);
    overflow: hidden;
    border-top-left-radius: var(--ts-open-tile-radius);
    border-top-right-radius: var(--ts-open-tile-radius);
}

.card-open-section__start-tiles-row {
    flex-grow: 1;
}

.card-open-section__start-wave {
    height: var(--ts-open-wave);
}

.card-open-section__rule {
    width: var(--ts-open-rule-width);
    height: var(--ts-open-rule-height);
    border-radius: var(--ts-open-rule-height);
    margin-bottom: var(--ts-space-3);
}

.card-open-section__name {
    font-size: var(--ts-open-eyebrow);
    -unity-font-style: bold;
    letter-spacing: var(--ts-open-eyebrow-tracking);
    margin: 0 0 var(--ts-space-3) 0;
    padding: 0;
    white-space: normal;
}

.card-section--open > .card-block-slot--open {
    margin: 0 var(--ts-open-gutter) var(--ts-block-gap) var(--ts-open-gutter);
}

.card-section--open > .card-block-slot--follows {
    border-top-width: var(--ts-line-width);
    border-color: var(--ts-hair);
    padding-top: var(--ts-open-block-gap);
}

/* the body inside an open section: v6's 17 pt prose (the theme's --ts-size-body-open; three classes, so a block sheet's own paragraph rule
   never undoes it), the lede keeping its own size; a composed block's paragraph keeps its row's Size option (Components.uss, four classes) */
.card-section--open > .card-block-slot--open .card-text__paragraph {
    font-size: var(--ts-size-body-open);
}

.card-section--open > .card-block-slot--open .card-text__lede {
    font-size: var(--ts-size-lede);
}
.card-block-slot--open .card-block-bleed {
    margin-left: var(--ts-open-bleed);
    margin-right: var(--ts-open-bleed);
}
