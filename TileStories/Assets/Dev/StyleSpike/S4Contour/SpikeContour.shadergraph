{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "310a4f4da3fb4cec88c48dd370c96f24",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SpikeContour (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -400.0,
            "y": 0.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "3522009f6914483fbc5868497cd75a6a"
        },
        {
            "m_Id": "af296f21b0174da79ebc41b19a75676d"
        },
        {
            "m_Id": "7ba7e3ce8776418b9de526099f03c842"
        },
        {
            "m_Id": "2593b8ecd66a4cbdb8779d1e0cb9bea0"
        },
        {
            "m_Id": "e9e43e9d35dd49c6a6ea66b1e85145d7"
        },
        {
            "m_Id": "56a822bae18547b793c48e91852dc299"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SpikeContour",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// a conic gradient around the element centre that turns once every Period seconds; Animate 0 freezes it (reduce motion)\nfloat2 p = UV - 0.5;\np.x *= Aspect;\nfloat turn = atan2(p.y, p.x) / 6.2831853 + 0.5;\nfloat t = frac(turn - Animate * _Time.y / max(Period, 0.001));\nfloat w = 0.5 + 0.5 * cos(6.2831853 * t);\nfloat3 gold = float3(0.91, 0.42, 0.03);\nfloat3 blue = float3(0.02, 0.10, 0.62);\nColor = lerp(blue, gold, smoothstep(0.15, 0.85, w));\nAlpha = 1.0;\n"
}

