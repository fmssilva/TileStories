/* DEV-ONLY (_3.3 P0 S2a): can a USS font rule take a TMP_FontAsset? The same face is offered three ways. */

.spike-font-uitk {
    -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/Fraunces/Fraunces-SemiBold UITK.asset");
}

.spike-font-tmp {
    -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/Fraunces/Fraunces-SemiBold TMP.asset");
}

.spike-font-ttf {
    -unity-font: url("/Assets/Dev/StyleSpike/Fonts/Fraunces/Fraunces-SemiBold.ttf");
}

.spike-font-def-ttf {
    -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/Fraunces/Fraunces-SemiBold.ttf");
}
