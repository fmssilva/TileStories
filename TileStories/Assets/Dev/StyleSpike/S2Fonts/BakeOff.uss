/* DEV-ONLY (_3.3 P0 S2c): the font bake-off block, light mode. Literal colours and sizes are allowed in spike code (Dev only);
   none of this is a token proposal -- only the FONT changes between the three pairs, everything else is held fixed. */

.bo-ground {
    flex-grow: 1;
    background-color: rgb(243, 240, 233);
    padding: 16px;
}

.bo-pair-name {
    font-size: 12px;
    color: rgb(90, 84, 76);
    margin-bottom: 8px;
    -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/Inter/Inter-Regular UITK.asset");
}

.bo-block {
    background-color: rgb(255, 255, 255);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgb(214, 208, 197);
    padding: 20px;
}

.bo-title { font-size: 30px; color: rgb(24, 22, 20); margin: 0 0 8px 0; padding: 0; white-space: normal; }
.bo-lede { font-size: 19px; color: rgb(24, 22, 20); margin: 0 0 12px 0; padding: 0; white-space: normal; }
.bo-body { font-size: 17px; color: rgb(52, 48, 44); margin: 0 0 14px 0; padding: 0; white-space: normal; }
.bo-figure { height: 120px; border-radius: 10px; background-color: rgb(214, 205, 188); margin-bottom: 6px; }
.bo-caption { font-size: 14px; color: rgb(84, 78, 70); margin: 0 0 16px 0; padding: 0; white-space: normal; }

.bo-button {
    height: 48px;
    margin: 0;
    border-radius: 24px;
    border-width: 0;
    background-color: rgb(30, 52, 104);
    color: rgb(255, 255, 255);
    font-size: 16px;
}

/* the glare stand-in: a white layer over the whole frame (opacity set by the test) */
.bo-glare {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(255, 255, 255);
}

/* pair 1: Fraunces SemiBold + Atkinson Hyperlegible Next */
.pair-fraunces .bo-title { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/Fraunces/Fraunces-SemiBold UITK.asset"); }
.pair-fraunces .bo-lede,
.pair-fraunces .bo-body,
.pair-fraunces .bo-caption { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/AtkinsonHyperlegibleNext/AtkinsonHyperlegibleNext-Regular UITK.asset"); }
.pair-fraunces .bo-button { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/AtkinsonHyperlegibleNext/AtkinsonHyperlegibleNext-SemiBold UITK.asset"); }

/* pair 2: Source Serif 4 SemiBold + Inter */
.pair-sourceserif .bo-title { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/SourceSerif4/SourceSerif4-SemiBold UITK.asset"); }
.pair-sourceserif .bo-lede,
.pair-sourceserif .bo-body,
.pair-sourceserif .bo-caption { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/Inter/Inter-Regular UITK.asset"); }
.pair-sourceserif .bo-button { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/Inter/Inter-SemiBold UITK.asset"); }

/* pair 3 (the Stitch reference): Playfair Display SemiBold (cut as "PF Spike") + Plus Jakarta Sans */
.pair-playfair .bo-title { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/PlayfairDisplay/PFSpike-SemiBold UITK.asset"); }
.pair-playfair .bo-lede,
.pair-playfair .bo-body,
.pair-playfair .bo-caption { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/PlusJakartaSans/PlusJakartaSans-Regular UITK.asset"); }
.pair-playfair .bo-button { -unity-font-definition: url("/Assets/Dev/StyleSpike/Fonts/PlusJakartaSans/PlusJakartaSans-SemiBold UITK.asset"); }
